---
import { translator, localizedPath, type Locale } from '../data/personal-i18n';
type CardId = 'yoga' | 'music' | 'home';

interface Props {
  locale?: Locale;
  reveal?: boolean;
  /** Which cards to show, in order. Home and About show yoga + music; the music page shows yoga + home. */
  show?: CardId[];
}

const { reveal = false, show = ['yoga', 'music'], locale = 'ja' } = Astro.props;
const t = translator(locale);
const revealAttr = reveal ? { 'data-reveal': true } : {};

const cards: Record<CardId, { href: string; img: string; alt: string; position: string; title: string; desc: string; cta: string }> = {
  yoga: {
    href: '/hatha-yoga/',
    img: '/assets/card-yoga-new.jpg',
    alt: t('ハタヨガを実践する秦 節子', 'Setsuko Hata practising hatha yoga'),
    position: 'center 55%',
    title: t('ヨガを<br />知る', 'Explore<br />Yoga'),
    desc: t('より意識的に生きるための<br />実践', 'Practices for<br />a more conscious life'),
    cta: t('詳しく見る', 'Discover'),
  },
  music: {
    href: '/music/',
    img: '/assets/card-music-new.jpg',
    alt: t('バンドとともに歌う秦 節子', 'Setsuko Hata singing with her band'),
    position: 'center 40%',
    title: t('音楽を<br />聴く', 'Explore<br />Music'),
    desc: t('より輝く明日へ<br />音を届ける', 'Sound for<br />a brighter tomorrow'),
    cta: t('聴く', 'Listen'),
  },
  home: {
    href: '/',
    img: '/assets/hero-stream.jpg',
    alt: t('渓流のほとりに佇む秦 節子', 'Setsuko Hata beside a mountain stream'),
    position: 'center 40%',
    title: t('秦<br />節子', 'Setsuko<br />Hata'),
    desc: t('ヨガ・音楽<br />意識的な暮らし', 'Yoga · Music<br />Conscious living'),
    cta: t('ホームへ', 'Home'),
  },
};
---

<section id="paths" class="explore">
  {
    show.map((id) => {
      const card = cards[id];
      return (
        <a href={localizedPath(card.href, locale)} class="explore-card" {...revealAttr}>
          <img
            loading="lazy"
            decoding="async"
            src={card.img}
            alt={card.alt}
            class="explore-card__img"
            style={`object-position: ${card.position};`}
          />
          <div class="explore-card__overlay" />
          <div class="explore-card__content">
            <h3 class="explore-card__title" set:html={card.title} />
            <span class="explore-card__rule" />
            <p class="explore-card__desc" set:html={card.desc} />
            <span class="explore-card__cta">
              {card.cta} <span class="arrow">→</span>
            </span>
          </div>
        </a>
      );
    })
  }
</section>
