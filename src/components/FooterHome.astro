---
import { translator, localizedPath, type Locale } from '../data/personal-i18n';
interface Props { locale?: Locale; }
const { locale = 'ja' } = Astro.props;
const t = translator(locale);
const link = (path: string) => localizedPath(path, locale);
---

<footer class="footer-home">
  <div class="footer-home__inner">
    <div class="footer-home__panel">
      <span class="ornament" aria-hidden="true">
        <svg viewBox="0 0 220 12" width="220" height="12" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M0 6h96"></path>
          <path d="M220 6h-96"></path>
          <path d="M110 2.4 L113.6 6 L110 9.6 L106.4 6 Z" fill="currentColor" stroke="none"></path>
        </svg>
      </span>

      <p class="footer-home__quote" lang={locale} data-reveal>{t('エネルギーが整えば、人生はもっと自由に、美しく響き始める。', 'When your energy is in balance, life begins to resonate more freely and beautifully.')}</p>

      <span class="ornament ornament--lower" aria-hidden="true">
        <svg viewBox="0 0 220 12" width="220" height="12" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M0 6h96"></path>
          <path d="M220 6h-96"></path>
          <path d="M110 2.4 L113.6 6 L110 9.6 L106.4 6 Z" fill="currentColor" stroke="none"></path>
        </svg>
      </span>

      <div class="footer-home__word">Setsuko Hata</div>
      <div class="footer-home__jp" lang="ja">秦 節子</div>

      <nav class="footer-home__nav" aria-label={t('フッターナビゲーション', 'Footer navigation')}>
        <ul class="footer-home__nav-list">
          <li><a href={link('/')}>{t('ホーム', 'Home')}</a></li>
          <li><a href={link('/about/')}>{t('プロフィール', 'About')}</a></li>
          <li><a href={link('/hatha-yoga/')} class="jp" lang={locale}>{t('ハタヨガ', 'Hatha Yoga')}</a></li>
          <li><a href={link('/volunteer/')}>{t('ボランティア募集', 'Volunteer')}</a></li>
          <li><a href="mailto:info@setsukohata.com">{t('お問い合わせ', 'Contact')}</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer-home__copyright">{t('© 2026 Setsuko Hata 無断転載を禁じます。', '© 2026 Setsuko Hata All Rights Reserved.')}</div>
  </div>
</footer>
