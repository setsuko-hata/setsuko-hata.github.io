---
// The three "At a Glance" cards, shared by About (plain grid) and Home
// (floating over the hero photo).
interface Props {
  float?: boolean;
  reveal?: boolean;
}

const { float = false, reveal = false } = Astro.props;
const cardClass = float ? 'stat-card stat-card--float' : 'stat-card';
---

<div class="stats-grid" data-reveal-soft={reveal ? '' : undefined}>
  <div class={cardClass}>
    <span class="stat-card__icon" aria-hidden="true">
      <svg viewBox="0 0 40 30" width="34" height="26" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M14 22V6l14-3v16"></path><ellipse cx="10" cy="22" rx="4" ry="3.2"></ellipse><ellipse cx="24" cy="19" rx="4" ry="3.2"></ellipse></svg>
    </span>
    <div class="stat-card__num-row">
      <span class="stat-card__num">13</span>
      <span class="stat-card__unit">Years</span>
    </div>
    <span class="stat-card__rule"></span>
    <div class="stat-card__label">Music &amp; Performance</div>
    <div class="stat-card__jp" lang="ja">アメリカでの音楽活動</div>
  </div>
  <div class={cardClass}>
    <span class="stat-card__icon" aria-hidden="true">
      <svg viewBox="0 0 44 30" width="36" height="26" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M22 6c4 4.5 4.5 11.5 0 18-4.5-6.5-4-13.5 0-18z"></path><path d="M22 24c-6 0-10.5-3.5-12.5-9 5 .5 9.5 3 12.5 9z"></path><path d="M22 24c6 0 10.5-3.5 12.5-9-5 .5-9.5 3-12.5 9z"></path></svg>
    </span>
    <div class="stat-card__num-row">
      <span class="stat-card__num">1,750</span>
      <span class="stat-card__unit">Hours</span>
    </div>
    <span class="stat-card__rule"></span>
    <div class="stat-card__label">Hatha Yoga Training</div>
    <div class="stat-card__jp" lang="ja">ハタヨガ トレーニング修了</div>
  </div>
  <div class={cardClass}>
    <span class="stat-card__icon" aria-hidden="true">
      <svg viewBox="0 0 46 30" width="38" height="26" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 24c5-1 7-3 9-6.5S18 8 23 8s8 6 10 9.5 4 5.5 9 6.5"></path><path d="M17.5 17c2-1.5 3.5-1.5 5.5 0s3.5 1.5 5.5 0"></path></svg>
    </span>
    <div class="stat-card__num-row">
      <span class="stat-card__num">2026</span>
    </div>
    <span class="stat-card__rule"></span>
    <div class="stat-card__label">Based in Japan</div>
    <div class="stat-card__jp" lang="ja">活動拠点を日本へ</div>
  </div>
</div>
