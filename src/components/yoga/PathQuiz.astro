---
interface Props { locale?: 'ja' | 'en'; }
const { locale = 'ja' } = Astro.props;
const t = (ja: string, en: string) => locale === 'en' ? en : ja;

// "Find your starting point" quiz on the 本格ハタヨガへの道 page.
// Recommends SATORIN (online), 対面クラス (大阪・東京) or スーリヤ・クリヤ.
// It opens small (one 診断を始めよう button) that reveals the questions.
// Without JS the quiz stays hidden and the map below is the whole page.
// Logic lives in scripts/yoga/path-quiz.js; each option's data-* drive the scoring.
import { SURYA_KRIYA_FORM_URL, SATORIN_PAGE_URL, NEXT_FREE_TRIAL, yogaHref } from '../../data/yoga';

const trialHref = NEXT_FREE_TRIAL.url || yogaHref(locale, 'offerings', 'calendar');
const trialDates = NEXT_FREE_TRIAL.dates || t("日程は近日公開", "Dates coming soon");
const trialExternal = /^https?:/.test(trialHref);

// score: points toward スーリヤ・クリヤ (3 or more = スーリヤ・クリヤ).
// surya: this answer alone means スーリヤ・クリヤ.
const questions = [
  {
    id: 'exp', title: t("これまでのヨガの経験は？", "What is your experience with yoga?"),
    options: [
      { label: t("はじめて", "I am new to yoga"), score: 0 },
      { label: t("少しだけある", "I have tried a little"), score: 1 },
      { label: t("続けている・続けていた", "I practice, or have practiced, regularly"), score: 2 },
    ],
  },
  {
    id: 'seek', title: t("いま、いちばん求めているものは？", "What are you looking for most right now?"),
    options: [
      { label: t("毎日の習慣にして、健康になりたい", "A healthy daily habit"), score: 0 },
      { label: t("一緒に続けられる仲間がほしい", "A community to practice with"), score: 0 },
      { label: t("内面を見つめ、もっと深く探求したい", "A deeper exploration of my inner self"), score: 2 },
    ],
  },
  {
    id: 'bond', title: t("いちばん近いものは？", "Which best describes you?"),
    options: [
      { label: t("秦 節子から勧められた", "Setsuko Hata recommended this to me"), surya: true },
      { label: t("スーリヤ・クリヤに惹かれるものを感じる", "I feel drawn to Surya Kriya"), surya: true },
      { label: t("サドグルやイシャ・ヨガを知っている", "I am familiar with Sadhguru or Isha Yoga"), score: 2 },
      { label: t("どれもあてはまらない", "None of these"), score: 0 },
    ],
  },
  {
    // Asked only when the answers so far don't point to スーリヤ・クリヤ.
    id: 'place', title: t("通いやすいのは？", "Which is easier for you to attend?"),
    options: [
      { label: t("大阪・東京で、対面で受けたい", "In-person classes in Osaka or Tokyo"), route: 'inperson' },
      { label: t("自宅から、オンラインで気軽に", "Convenient online classes from home"), route: 'satorin' },
    ],
  },
];

const results = [
  {
    id: 'satorin', en: 'Online', name: t("オンライン SATORIN", "SATORIN Online"), target: 'fl-upa1',
    text: t("ご自宅から、毎日の習慣づくりに。オンラインで仲間とつながりながら、はじめての方も無理なく続けられます。", "Build a daily habit from home. Connect with others online and develop a sustainable practice, even if you are a beginner."),
    links: [{ label: t("SATORINを見る", "Explore SATORIN"), href: locale === 'en' ? '/satorin/en/' : SATORIN_PAGE_URL }],
  },
  {
    id: 'inperson', en: 'In person', name: t("対面クラス（大阪・東京）", "In-person classes (Osaka & Tokyo)"), target: 'fl-upa1',
    text: t("先生や仲間と同じ場で、直接学べます。習慣づくりや健康のために、まずは対面のクラスから始めましょう。", "Learn directly alongside your teacher and fellow students. Start with an in-person class to build healthy habits."),
    links: [
      { label: t("大阪のクラス", "Classes in Osaka"), href: yogaHref(locale, 'offerings', 'osaka') },
      { label: t("東京のクラス", "Classes in Tokyo"), href: yogaHref(locale, 'offerings', 'tokyo') },
    ],
  },
  {
    id: 'surya', en: 'Surya Kriya', name: t("スーリヤ・クリヤ", "Surya Kriya"), target: 'fl-surya',
    text: t("内なる探求を深めたいあなたへ。太陽のサイクルと生命のリズムを調和させる、本格的なハタヨガの伝授から始めましょう。", "For those seeking a deeper inner exploration. Begin with classical Hatha Yoga that brings the rhythms of your life into harmony with the cycles of the sun."),
    links: [{ label: t("スーリヤ・クリヤを予約する", "Book Surya Kriya"), href: SURYA_KRIYA_FORM_URL, external: true }],
  },
];
---
<section class="cl-section pq-section" data-screen-label={t("診断", "Starting-point quiz")} aria-labelledby="pq-title">
  <div class="cl-wrap">
    <div class="pq" data-quiz data-locale={locale} hidden>
      <p class="pq__en">Find your starting point</p>
      <h2 id="pq-title" class="pq__title">{t("あなたにおすすめの始め方", "Find your starting point")}</h2>
      <p class="pq__lead">{t("どこから始めればいいか迷ったら、3〜4つの質問で、あなたに合う最初の一歩をご提案します。", "Not sure where to begin? Answer 3–4 questions to find a first step that suits you.")}</p>

      <div class="pq__intro" data-quiz-intro>
        <div class="pq__choices">
          <button type="button" class="cl-btn" data-quiz-start>{t("診断を始めよう", "Start the quiz")}</button>
        </div>
      </div>

      <div data-quiz-panel hidden>
      <div class="pq__body" data-quiz-questions>
        <p class="pq__progress" data-quiz-progress>{t("質問 1", "Question 1")}</p>
        {questions.map((q, i) => (
          <div class="pq-q" role="group" aria-labelledby={`pq-q-${q.id}`} data-quiz-q={q.id} hidden={i > 0}>
            <h3 id={`pq-q-${q.id}`} class="pq-q__title" tabindex="-1">{q.title}</h3>
            <div class="pq-q__options">
              {q.options.map((o) => (
                <button type="button" class="pq-opt"
                  data-score={'score' in o ? o.score : undefined}
                  data-surya={'surya' in o ? '' : undefined}
                  data-route={'route' in o ? o.route : undefined}>{o.label}</button>
              ))}
            </div>
          </div>
        ))}
        <button type="button" class="cl-btn pq__back-btn" data-quiz-back hidden>{t("戻る", "Back")}</button>
      </div>

      <div class="pq__result" data-quiz-result hidden>
        {results.map((r) => (
          <article class="pq-res" data-result={r.id} data-target={r.target} hidden>
            <p class="pq-res__label">{t("あなたの始まりは", "Your starting point")}</p>
            <p class="pq-res__en">{r.en}</p>
            <h3 class="pq-res__name" tabindex="-1">{r.name}</h3>
            <p class="pq-res__text">{r.text}</p>
            {r.id === 'satorin' && <p class="pq-res__trial">
              <span class="pq-res__trial-label">{t("まずは無料体験から", "Begin with a free trial")}</span>
              <span class="pq-res__trial-dates">{t("次回：", "Next: ")}{trialDates}</span>
              <a class="cl-link" href={trialHref} {...(trialExternal ? { target: '_blank', rel: 'noreferrer' } : {})}>{t("無料体験の詳細", "Free trial details")}</a>
            </p>}
            <div class="pq-res__actions">
              {r.links.map((l) => (
                <a class="cl-btn" href={l.href} {...('external' in l && l.external ? { target: '_blank', rel: 'noreferrer' } : {})}>{l.label}</a>
              ))}
            </div>
          </article>
        ))}
        <button type="button" class="pq__back" data-quiz-restart>{t("もう一度診断する", "Take the quiz again")}</button>
      </div>

      <a class="pq__skip cl-link" href="#path-map">{t("診断せずに流れ全体を見る", "Skip the quiz and see the full journey")}</a>
      </div>
    </div>
  </div>
</section>
