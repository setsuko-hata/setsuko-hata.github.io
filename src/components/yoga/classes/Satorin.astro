---
/** SATORIN online membership. `full` = the オンライン tab (everything);
 *  otherwise a short card for the 大阪 / 東京 tabs that links to the full version. */
import { SATORIN_BOOKING_URL, SATORIN_PAGE_URL } from '../../../data/yoga';
import { classText, getClassContent } from '../../../data/classes';

const yes = '✓';

interface Props { locale?: 'ja' | 'en'; id: string; full?: boolean; tone?: string; fullHref?: string; }
const { locale = 'ja', id, full = false, tone = '', fullHref = '#online-satorin' } = Astro.props;
const t = (text: string) => classText(locale, text);
const { SATORIN_MORNING, SATORIN_EVENING, SATORIN_PLANS } = getClassContent(locale);

---
{full ? (
<section id={id} class={`cl-section scroll-mt-24 ${tone}`}>
  <div class="cl-wrap">
    <div class="cl-head">
      <p class="cl-eyebrow">{t("オンライン会員")}</p>
      <h2>{t("SATORIN メンバーシップ")}</h2>
      <span class="cl-head__rule" aria-hidden="true"></span>
    </div>
    <p class="cl-lead">{t("朝ヨガ、ナイトプラン、大阪の対面ヨガから、ご自身に合うプランをお選びいただけます。")}</p>

    <div class="cl-feats cl-feats--duo">
      <article class="cl-feat cl-feat--olive">
        <header class="cl-feat__head">
          <p class="cl-feat__no"><span>01</span>Included</p>
          <h3 class="cl-feat__title">{t("朝ヨガ")}</h3>
          <p class="cl-feat__en">Morning practice</p>
          <p class="cl-feat__when">{t("月・水・金｜6:00〜6:45")}<br />{t("（祝日休み）")}</p>
        </header>
        <div class="cl-feat__body">
          <p class="cl-feat__lead">{t("週3回、朝6時にオンラインで待ち合わせ。")}</p>
          <p class="cl-feat__p">{t("初心者の方も、すでに本格ハタヨガを学んでいる方も、ご自身に合った形で参加できます。難しいポーズを競うのではなく、身体の動き、呼吸、音、内側の感覚へ意識を向ける時間です。")}</p>
          <ul class="cl-tiles">{SATORIN_MORNING.practices.map((t) => <li>{t}</li>)}</ul>
        </div>
      </article>

      <article class="cl-feat cl-feat--gold">
        <header class="cl-feat__head">
          <p class="cl-feat__no"><span>02</span>Included</p>
          <h3 class="cl-feat__title">{t("学び・瞑想・交流")}</h3>
          <p class="cl-feat__en">Learn · Meditate · Connect</p>
          <p class="cl-feat__when">{t("健康セミナー月2回＋瞑想会月2回")}</p>
        </header>
        <div class="cl-feat__body">
          <p class="cl-feat__lead">{t("身体を整え、毎日の選択を変えていく。")}</p>
          <ul class="cl-evening">
            {SATORIN_EVENING.map((e) => (
              <li class="cl-evening__item">
                <p class="cl-evening__name">{e.name}</p>
                <p class="cl-evening__when">{e.when}</p>
                <p class="cl-evening__text">{e.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </article>

    </div>

    <div class="cl-panel">
      <div class="cl-panel__head"><span class="cl-ring"><svg viewBox="0 0 48 48" aria-hidden="true"><use href="#moon" /></svg></span><h3>{t("プランと料金")}</h3></div>
      <p class="cl-lead">{t("5つのプランからお選びいただけます。")}</p>
      <div class="cl-plans" data-plan-gallery>
        <div class="cl-plans__track" id={`${id}-plans`} role="region" aria-label={t("メンバーシッププラン")} tabindex="0">
          {SATORIN_PLANS.map((p) => (
            <article class={`cl-plancard${p.pick ? ' is-pick' : ''}`}>
              {p.pick && <span class="cl-badge cl-plancard__badge">{t("おすすめ")}</span>}
              <p class="cl-plancard__no">Membership {p.no}</p>
              <p class="cl-plancard__type">{p.type}</p>
              <h4 class="cl-plancard__name">{p.name}</h4>
              <p class="cl-plancard__tag">{p.tagline}</p>
              <ul class="cl-plancard__list">{p.features.map((f) => <li>{f}</li>)}</ul>
              <p class="cl-plancard__price"><span class="cl-plancard__unit">{t("月額")}</span><span class="rate-amount">{p.price}</span>{t("円")}<small>{t("（税込）")}</small></p>
              <a class="cl-btn cl-plancard__btn" href={locale === 'en' ? p.url.replace('/ja/', '/en/') : p.url} target="_blank" rel="noreferrer">{t(p.url.includes("contact") ? "予約準備中・お問い合わせ" : "詳細・お申し込み")}</a>
            </article>
          ))}
        </div>
        <div class="cl-plans__nav">
          <button type="button" class="cl-plans__arrow" data-plan-step="-1" aria-controls={`${id}-plans`} aria-label={t("前のプラン")}>←</button>
          <div class="cl-plans__dots">
            {SATORIN_PLANS.map((p, i) => <button type="button" class="cl-plans__dot" data-plan-dot={i} aria-controls={`${id}-plans`} aria-label={locale === 'en' ? `Show ${p.name} plan` : `${p.name}プランを表示`} aria-current={i === 0 ? 'true' : undefined}></button>)}
          </div>
          <button type="button" class="cl-plans__arrow" data-plan-step="1" aria-controls={`${id}-plans`} aria-label={t("次のプラン")}>→</button>
        </div>
      </div>

      <div class="cl-subpart">
        <h4 class="cl-subpart__title">{t("健康セミナー・瞑想の単発参加")}</h4>
        <p class="cl-lead">{t("メンバーでない方も、月2回の健康セミナー（19:30〜20:10）・瞑想（20:20〜21:00）に1回から参加いただけます（朝ヨガは含まれません）。")}</p>
        <div class="rate-duo">
          <div class="rate-duo__cell"><p class="rate-duo__label">{t("通常料金（1回・40分）")}</p><p class="rate-duo__price"><span class="rate-amount">2,000</span>{t("円")}</p></div>
          <div class="rate-duo__cell rate-duo__cell--member"><p class="rate-duo__label">{t("SATORIN メンバー料金")}</p><p class="rate-duo__price"><span class="rate-amount">1,500</span>{t("円")}</p></div>
        </div>
      </div>

      <p class="cl-minihead cl-subpart__head">{t("プランの比較")}</p>
      <div class="cl-tablewrap">
        <table class="cl-table">
          <caption class="cl-sr">{t("SATORIN メンバーシップのプラン比較（月額・税込）")}</caption>
          <thead>
            <tr><th scope="col">{t("プラン")}</th><th scope="col">{t("月額（税込）")}</th><th scope="col">{t("朝ヨガ")}<small>{t("月・水・金 6:00〜6:45")}</small><small>{t("（祝日休み）")}</small></th><th scope="col">{t("健康セミナー")}<small>{t("19:30〜20:10")}</small><small>{t("月2回")}</small></th><th scope="col">{t("瞑想")}<small>{t("20:20〜21:00")}</small><small>{t("月2回")}</small></th><th scope="col">{t("対面ヨガ")}<small>{t("月2回")}</small></th><th scope="col">{t("交流会")}</th></tr>
          </thead>
          <tbody>
            {SATORIN_PLANS.map((p) => (
              <tr class={p.pick ? 'is-pick' : undefined}>
                <th scope="row"><span class="cl-table__name">{p.name}</span><span class="cl-table__type">{p.type}</span>{p.pick && <span class="cl-badge">{t("おすすめ")}</span>}</th>
                <td data-label={t("月額（税込）")}><span><span class="rate-amount">{p.price}</span>{t("円")}</span></td>
                <td class="cl-table__morning" data-label={t("朝ヨガ\n月・水・金 6:00〜6:45\n（祝日休み）")}>{p.morning ? <span class="cl-yes" aria-label={t("あり")}>✓</span> : <span class="cl-no" aria-label={t("なし")}>―</span>}</td>
                <td data-label={t("健康セミナー 月2回")}>{p.evening ? <span class="cl-yes" aria-label={t("あり")}>{yes}</span> : <span class="cl-no" aria-label={t("なし")}>―</span>}</td>
                <td data-label={t("瞑想会 月2回")}>{p.evening ? <span class="cl-yes" aria-label={t("あり")}>{yes}</span> : <span class="cl-no" aria-label={t("なし")}>―</span>}</td>
                <td data-label={t("対面ヨガ")}>{p.inperson ? <span class="cl-yes" aria-label={t("あり")}>✓</span> : <span class="cl-no" aria-label={t("なし")}>―</span>}</td>
                <td data-label={t("交流会")}>{p.community ? <span class="cl-yes" aria-label={t("あり")}>✓</span> : <span class="cl-no" aria-label={t("なし")}>―</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="cl-callout">
        <p class="cl-callout__title">{t("無料体験について")}</p>
        <p>{t("SATORIN では、期間を決めて無料体験を実施しています。次回の無料体験の日程は、")}<a class="cl-link" href="#calendar" data-cal-filter="online">{t("開催スケジュール")}</a>{t("または")} <a class="cl-link" href={locale === 'en' ? '/satorin/en/' : SATORIN_PAGE_URL}>{t("SATORIN のページ")}</a>{t("でご確認ください。")}</p>
      </div>
    </div>

    <div class="cl-actions">
      <a href={`/hatha-yoga/${locale}/contact/`} class="cl-btn">{t("予約準備中・お問い合わせ")}</a>
      <a href={locale === 'en' ? '/satorin/en/' : SATORIN_PAGE_URL} class="cl-btn cl-btn--ghost">{t("SATORIN のページで詳しく見る")}</a>
      <a href="#calendar" data-cal-filter="online" class="cl-btn cl-btn--ghost">{t("開催スケジュール")}</a>
    </div>
    <p class="cl-fine">{t("※ メンバーシップのお支払い・解約・休止は、STORES の予約ページからお手続きいただけます。")}</p>
  </div>
</section>
) : (
<section id={id} class={`cl-section scroll-mt-24 ${tone}`}>
  <div class="cl-wrap">
    <div class="cl-head">
      <p class="cl-eyebrow">{t("ご自宅でも")}</p>
      <h2>{t("オンライン健康セミナーと瞑想会")}</h2>
      <span class="cl-head__rule" aria-hidden="true"></span>
    </div>
    <div class="cl-panel cl-satori-mini">
      <p class="cl-lead">{t("月・水・金の朝ヨガと、月2回ずつの健康セミナー・瞑想会をご自宅からオンラインで。")}<br />{t("対面クラスと合わせて、毎日の実践を続けられるメンバーシップです。")}</p>
      <div class="cl-actions">
        <a href={fullHref} class="cl-btn">{t("オンラインのクラスを見る")}</a>
      </div>
    </div>
  </div>
</section>
)}
