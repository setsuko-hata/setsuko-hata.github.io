---
/** The shared class popups (opened by any [data-dialog] button; see scripts/yoga/class-dialogs.js). */
import { CLASS_DIALOGS } from '../../../data/classes';
---
{CLASS_DIALOGS.map((d) => (
  <dialog id={d.id} class="cl-dialog" aria-labelledby={`${d.id}-title`}>
    <div class="cl-dialog__inner">
      <button type="button" class="cl-dialog__close" data-dialog-close aria-label="閉じる">×</button>
      <h2 id={`${d.id}-title`} class="cl-dialog__title">{d.title}</h2>
      <p class="cl-dialog__tag">{d.tagline}</p>
      {d.body.map((p) => <p class="cl-dialog__p">{p}</p>)}
      <p class="cl-minihead">{d.listTitle}</p>
      <ul class="cl-dash">{d.list.map((l) => <li>{l}</li>)}</ul>
      <dl class="cl-facts">
        {d.times.map((t) => <div><dt>{t.label}</dt><dd>{t.value}</dd></div>)}
      </dl>
    </div>
  </dialog>
))}
