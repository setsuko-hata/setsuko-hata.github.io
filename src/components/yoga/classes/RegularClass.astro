---
/** 大阪: 通常クラス (ヨガ・瞑想, about 75 min, drop-in). Prices live in Fees.astro. */
import { OSAKA_COURSE_FORM_URL } from '../../../data/yoga';
import { classText, getClassContent } from '../../../data/classes';

interface Props { locale?: 'ja' | 'en'; id: string; tone?: string; }
const { locale = 'ja', id, tone = '' } = Astro.props;
const t = (text: string) => classText(locale, text);
const { REGULAR_CLASS: c } = getClassContent(locale);

---
<section id={id} class={`cl-section scroll-mt-24 ${tone}`}>
  <div class="cl-wrap">
    <div class="cl-headrow">
      <div class="cl-head">
        <p class="cl-eyebrow">{t("大阪｜対面")}</p>
        <h2>{c.title}</h2>
        <span class="cl-head__rule" aria-hidden="true"></span>
      </div>
      <div class="cl-actions">
        <a href={OSAKA_COURSE_FORM_URL} target="_blank" rel="noreferrer" class="cl-btn">{t("予約する")}</a>
        <a href="#calendar" data-cal-filter="inperson" class="cl-btn cl-btn--ghost">{t("開催スケジュール")}</a>
      </div>
    </div>
    <p class="cl-lead">{c.description}</p>

    <div class="cl-panel cl-panel--compact oc">
      <section class="oc-sec" aria-labelledby={`${id}-classes`}>
        <h3 class="oc-h" id={`${id}-classes`}><svg viewBox="0 0 48 48" aria-hidden="true"><use href="#sprout" /></svg>{t("クラスの内容")}</h3>
        <div class="oc-classes">
          {c.classes.map((k) => (
            <div class="oc-price">
              <p class="oc-price__name"><button type="button" class="cl-link" data-dialog={k.dialog}>{k.name}</button></p>
              <p class="oc-price__note">{k.tagline}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="oc-sec" aria-labelledby={`${id}-for`}>
        <h3 class="oc-h" id={`${id}-for`}><svg viewBox="0 0 48 48" aria-hidden="true"><use href="#heart" /></svg>{t("こんな方におすすめ")}</h3>
        <ul class="oc-for">{c.forWhom.map((f) => <li>{f}</li>)}</ul>
      </section>

      <section class="oc-sec" aria-labelledby={`${id}-join`}>
        <h3 class="oc-h" id={`${id}-join`}><svg viewBox="0 0 48 48" aria-hidden="true"><use href="#mat" /></svg>{t("ご参加について")}</h3>
        <dl class="oc-info">
          <div><dt>{t("所要時間")}</dt><dd>{c.duration}</dd></div>
          <div><dt>{t("会場")}</dt><dd>{c.venue}<br /><a class="cl-link" href={c.map} target="_blank" rel="noreferrer">{t("地図を見る")}</a></dd></div>
          <div><dt>{t("参加方法")}</dt><dd class="oc-ways">
            <span class="oc-way"><small>{t("単発参加")}</small><span><b class="rate-amount">4,000</b>{t("円")}</span></span>
            <a class="oc-way oc-way--link" href="#osaka-membership"><small>{t("月額会員")}</small><span>{t("プランを見る →")}</span></a>
          </dd></div>
        </dl>
        <p class="cl-fine">{t("お支払い・キャンセル・持ち物などは")}<a class="cl-link" href="#guide">{t("ご案内")}</a>{t("をご覧ください。")}</p>
      </section>
    </div>
  </div>
</section>
