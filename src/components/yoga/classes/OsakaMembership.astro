---
/** Osaka-only monthly membership: plans, notes, benefits. Rendered inside the 料金 panel. */
import { classText, getClassContent } from '../../../data/classes';
import { OSAKA_COURSE_FORM_URL } from '../../../data/yoga';

interface Props { locale?: 'ja' | 'en'; id: string; }
const { locale = 'ja', id } = Astro.props;
const t = (text: string) => classText(locale, text);
const { OSAKA_PLANS } = getClassContent(locale);

---
<div id={id} class="cl-subpart scroll-mt-24">
  <h4 class="cl-subpart__title">{t("月額会員")}<span class="cl-subpart__note">{t("大阪限定")}</span></h4>
  <p class="cl-lead">{t("本格ハタヨガを継続する会員プランです。対面クラスは月2回。オンラインの健康セミナー・瞑想を組み合わせたプランもあります。")}</p>
  <div class="plans">
    <div class="plans__grid">
      {OSAKA_PLANS.map((pl) => (
        <article class="plan">
          <p class="plan__no">{t('プラン')}{locale === 'en' ? ' ' : ''}{pl.no}</p>
          <p class="plan__name">{pl.name}</p>
          <p class="plan__price"><span class="plan__unit">{t("月額")}</span><span class="rate-amount">{pl.price}</span>{t("円")}</p>
          <dl class="plan__rows">
            <div><dt>{t("対面クラス")}</dt><dd class="is-on">{t("月2回")}</dd></div>
            <div><dt>{t("健康セミナー")}<small>{t("オンライン")}</small></dt>{pl.online ? <dd class="is-on">{pl.online}</dd> : <dd class="is-off" aria-label={t("なし")}>―</dd>}</div>
            <div><dt>{t("瞑想")}<small>{t("オンライン")}</small></dt>{pl.online ? <dd class="is-on">{pl.online}</dd> : <dd class="is-off" aria-label={t("なし")}>―</dd>}</div>
          </dl>
        </article>
      ))}
    </div>
  </div>
  <p class="cl-minihead">{t("会員特典")}</p>
  <ul class="cl-dash">
    <li>{t("瞑想クラスなど各種クラスに会員価格が適用")}</li>
    <li>{t("スーリヤ・クリヤなど本格プログラムのフォーム確認・復習サポート")}</li>
    <li>{t("会員限定の交流会・コミュニティイベントへのご参加")}</li>
    <li>{t("ご自宅での実践を支える個別アドバイス")}</li>
  </ul>
  <div class="cl-actions"><a href={OSAKA_COURSE_FORM_URL} target="_blank" rel="noreferrer" class="cl-btn cl-btn--ghost">{t("月額会員に申し込む")}</a></div>
</div>
