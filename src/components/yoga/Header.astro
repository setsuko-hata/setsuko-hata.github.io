---
import { NAV, type Locale } from '../../data/yoga';

interface Props {
  locale: Locale;
  /** NavItem id (or dropdown child id) of the current page. */
  active?: string;
  /** Link to the same page in the other language, when one exists. */
  switchHref?: string;
}

const { locale, active = '', switchHref } = Astro.props;
const items = NAV[locale];
const isJa = locale === 'ja';

const isActive = (item: (typeof items)[number]) =>
  item.id === active || (item.items ?? []).some((child) => child.id === active);
const menuId = (id: string) => `yoga-menu-${id}`;
---

<header
  class="yoga-header fixed inset-x-0 top-0 z-50 transition-colors duration-500 bg-paper/95 backdrop-blur-md text-brand-espresso border-b border-brand-espresso/10"
  data-yoga-header
>
  <div class="mx-auto w-full max-w-7xl px-6 md:px-10 flex h-20 items-center justify-between" style="position:relative;z-index:3">
    {
      isJa ? (
        <a class="flex items-center gap-3 font-mono text-[13px] uppercase tracking-[0.28em]" href="/" aria-label="setsukohata.com に戻る">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5" /><path d="m11 6-6 6 6 6" /></svg>
          <span>SETSUKOHATA.COM</span>
        </a>
      ) : (
        <a class="flex items-center gap-3 font-mono text-[13px] uppercase tracking-[0.28em]" href="/en/" aria-label="Back to setsukohata.com">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5" /><path d="m11 6-6 6 6 6" /></svg>
          <span>SETSUKOHATA.COM</span>
        </a>
      )
    }
    <nav class="hidden items-center gap-9 md:flex" aria-label={isJa ? 'メインメニュー' : 'Primary navigation'}>
      {
        items.map((item) =>
          item.items ? (
            <div class="ja-navdrop" data-navdrop>
              <button
                type="button"
                class:list={['ja-navtrigger', { active: isActive(item) }]}
                data-href={item.href}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls={menuId(item.id)}
                aria-current={item.id === active ? 'page' : undefined}
              >
                {item.label}
                <svg class="ja-navtrigger-caret" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
              </button>
              <div class="ja-navdrop-menu" id={menuId(item.id)} role="menu">
                {item.items.map((child) => (
                  <a href={child.href} role="menuitem" aria-current={child.id && child.id === active ? 'page' : undefined}>{child.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={['text-[14px] uppercase tracking-[0.18em] transition-opacity hover:opacity-70', { active: isActive(item) }]}
              aria-current={isActive(item) ? 'page' : undefined}
            >{item.label}</a>
          ),
        )
      }
    </nav>
    {switchHref && <a href={switchHref} data-language-switch={isJa ? 'en' : 'ja'} class="yoga-language-switch" aria-label={isJa ? 'Switch to English' : '日本語に切り替える'} lang={isJa ? 'en' : 'ja'}>{isJa ? 'EN' : '日本語'}</a>}
    <button
      id="yoga-menu-btn"
      type="button"
      class="flex h-10 w-10 items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="yoga-mobile-nav"
      aria-label={isJa ? 'メニューを開く' : 'Open menu'}
      data-label-open={isJa ? 'メニューを開く' : 'Open menu'}
      data-label-close={isJa ? 'メニューを閉じる' : 'Close menu'}
    >
      <span class="relative block h-4 w-5" aria-hidden="true">
        <span data-bar="1" class="absolute left-0 top-0 h-px w-5 bg-current transition-transform duration-300"></span>
        <span data-bar="2" class="absolute left-0 top-2 h-px w-5 bg-current transition-opacity duration-200"></span>
        <span data-bar="3" class="absolute left-0 top-4 h-px w-5 bg-current transition-transform duration-300"></span>
      </span>
    </button>
  </div>
</header>

<div id="yoga-mobile-nav" class="yoga-mobile-nav" hidden>
  <div class="yoga-mobile-nav__scrim" data-scrim></div>
  <div class="yoga-mobile-nav__panel" data-panel>
    <nav aria-label={isJa ? 'モバイルメニュー' : 'Mobile menu'}>
      {
        items.map((item) =>
          item.items ? (
            <>
              <a class="yoga-mobile-nav__group font-display" href={item.href}>{item.label}</a>
              {item.items.map((child) => (
                <a class="yoga-mobile-nav__child text-base" href={child.href} aria-current={child.id && child.id === active ? 'page' : undefined}>{child.label}</a>
              ))}
            </>
          ) : (
            <a class="yoga-mobile-nav__link font-display text-xl" href={item.href} aria-current={isActive(item) ? 'page' : undefined}>{item.label}</a>
          ),
        )
      }
      {switchHref && <a data-language-switch={isJa ? 'en' : 'ja'} class="yoga-mobile-nav__link font-display text-xl" href={switchHref} lang={isJa ? 'en' : 'ja'}>{isJa ? 'English' : '日本語'}</a>}
    </nav>
  </div>
</div>

<script>
  import '../../scripts/yoga/nav';
</script>

<style>
  .yoga-language-switch { flex-shrink: 0; font: 600 13px/1.4 Inter, sans-serif; padding: 8px 10px; border: 1px solid currentColor; margin-left: auto; margin-right: 12px; }
  @media (min-width: 1280px) { .yoga-language-switch { margin-left: 18px; margin-right: 0; } }
  @media (max-width: 1279px) { header nav { display: none !important; } #yoga-menu-btn { display: flex !important; } }
</style>
