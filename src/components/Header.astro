---
import { alternatePaths, translator, localizedPath, type Locale } from '../data/personal-i18n';
interface Props {
  active: 'home' | 'about' | 'music' | 'volunteer';
  locale?: Locale;
}
const { active, locale = 'ja' } = Astro.props;
const t = translator(locale);
const link = (path: string) => localizedPath(path, locale);
const alternatives = alternatePaths(Astro.url.pathname);
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={link('/')} aria-label={t('秦 節子 ホーム', 'Setsuko Hata home')} class="wordmark">
      <span>Setsuko Hata</span>
    </a>
    <nav aria-label={t('メインナビゲーション', 'Primary navigation')}>
      <ul class="nav-list">
        <li><a href={link('/')} class="nav-link" aria-current={active === 'home' ? 'page' : undefined}>{t('ホーム', 'Home')}</a></li>
        <li><a href={link('/about/')} class="nav-link" aria-current={active === 'about' ? 'page' : undefined}>{t('プロフィール', 'About')}</a></li>
        <li><a href={link('/satorin/')} class="nav-link">{t('オンラインヨガ', 'Online Yoga')}</a></li>
        <li><a href={link('/hatha-yoga/')} class="nav-link nav-link--jp nav-link--featured">{t('ハタヨガ', 'Hatha Yoga')}</a></li>
        <li><a href={link('/volunteer/')} class="nav-link nav-link--jp" aria-current={active === 'volunteer' ? 'page' : undefined}>{t('ボランティア募集', 'Volunteer')}</a></li>
        <li><a href={link('/music/')} class="nav-link nav-link--jp nav-link--featured" aria-current={active === 'music' ? 'page' : undefined}>{t('音楽', 'Music')}</a></li>
      </ul>
    </nav>
    <nav class="language-switch" aria-label={t('言語を選択', 'Select language')}>
      <a href={alternatives.ja} lang="ja" hreflang="ja" data-language-switch="ja" aria-label="日本語" aria-current={locale === 'ja' ? 'page' : undefined}>JA</a>
      <span aria-hidden="true">/</span>
      <a href={alternatives.en} lang="en" hreflang="en" data-language-switch="en" aria-label="English" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
    </nav>
  </div>
</header>
