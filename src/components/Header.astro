---
interface Props {
  active: 'home' | 'about';
}

const { active } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" aria-label="Setsuko Hata — home" class="wordmark">
      <span>Setsuko Hata</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        <li>
          <a href="/" class="nav-link" aria-current={active === 'home' ? 'page' : undefined}>Home</a>
        </li>
        <li>
          <a href="/about" class="nav-link" aria-current={active === 'about' ? 'page' : undefined}>About</a>
        </li>
        <li>
          <a href="/hatha-yoga/index.html" class="nav-link nav-link--jp" lang="ja">ハタヨガ</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
