---
import Layout from '../layouts/Layout.astro';
import { translator, type Locale } from '../data/personal-i18n';
import { volunteer } from '../data/volunteer';

interface Props { locale?: Locale; }
const { locale = 'ja' } = Astro.props;
const copy = volunteer[locale];
const t = translator(locale);
---

<Layout locale={locale} title={`${copy.title} | SATORIN | Setsuko Hata 秦 節子`} description={copy.description} active="volunteer" footer="home">
  <article class="volunteer" lang={locale}>
    <section class="volunteer-hero" aria-labelledby="volunteer-title">
      <div class="volunteer-wrap volunteer-hero__grid">
        <div class="volunteer-hero__copy">
          <p class="volunteer-eyebrow">SATORIN VOLUNTEER COMMUNITY</p>
          <p class="volunteer-hero__label">{copy.title}</p>
          <h1 id="volunteer-title">{copy.headline.map(line => <span>{line}</span>)}</h1>
          <p class="volunteer-hero__motto" lang="en">Grow Yourself. Inspire Others.<br />Transform the World.</p>
          <a class="volunteer-link" href="#activities">{t('あなたにできることを見る', 'Explore ways to contribute')} <span aria-hidden="true">↓</span></a>
        </div>
        <div class="volunteer-hero__visual">
          <figure class="volunteer-hero__yoga">
            <img src="/hatha-yoga/assets/gallery/meditation-1400.jpg" alt={t('輪になって瞑想を学ぶ参加者たち', 'Participants learning meditation together in a circle')} width="1400" height="1050" fetchpriority="high" />
            <figcaption>{t('ヨガで心身を整える。', 'Find balance through yoga.')}</figcaption>
          </figure>
          <figure class="volunteer-hero__music">
            <img src="/assets/card-music-new.jpg" alt={t('バンドとともにステージで歌う秦節子', 'Setsuko Hata singing on stage with a band')} width="1400" height="788" />
            <figcaption>{t('音楽で心をつなぐ。', 'Connect hearts through music.')}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="volunteer-section volunteer-intro" aria-labelledby="volunteer-intro-title">
      <div class="volunteer-wrap volunteer-intro__grid">
        <div>
          <p class="volunteer-eyebrow">YOGA · MUSIC · CONSCIOUS LIVING</p>
          <h2 id="volunteer-intro-title">{copy.introTitle}</h2>
        </div>
        <div class="volunteer-prose">
          {copy.intro.map(paragraph => <p>{paragraph}</p>)}
          <p class="volunteer-intro__welcome">{copy.welcome}</p>
        </div>
      </div>
    </section>

    <section id="activities" class="volunteer-section volunteer-activities" aria-labelledby="volunteer-activities-title">
      <div class="volunteer-wrap">
        <header class="volunteer-section__heading">
          <p class="volunteer-eyebrow">WHAT YOU CAN DO</p>
          <h2 id="volunteer-activities-title">{copy.rolesTitle}</h2>
        </header>
        <div class="volunteer-roles">
          {copy.roles.map((role, index) => <section class="volunteer-role" aria-labelledby={`role-${index}`}>
            <span class="volunteer-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 id={`role-${index}`}>{role.title}</h3>
            <ul>{role.items.map(item => <li>{item}</li>)}</ul>
          </section>)}
        </div>
        <p class="volunteer-activities__note">{copy.rolesNote}</p>
      </div>
    </section>

    <section class="volunteer-section volunteer-benefits" aria-labelledby="volunteer-benefits-title">
      <div class="volunteer-wrap">
        <header class="volunteer-section__heading">
          <p class="volunteer-eyebrow">WHY JOIN SATORIN?</p>
          <h2 id="volunteer-benefits-title">{copy.benefitsTitle}</h2>
          <p class="volunteer-section__intro">{copy.benefitsIntro}</p>
        </header>
        <ol class="volunteer-benefits__grid">
          {copy.benefits.map((benefit, index) => <li>
            <span class="volunteer-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </li>)}
        </ol>
      </div>
    </section>

    <section class="volunteer-section volunteer-who" aria-labelledby="volunteer-who-title">
      <div class="volunteer-wrap volunteer-who__grid">
        <header>
          <p class="volunteer-eyebrow">WHO CAN JOIN?</p>
          <h2 id="volunteer-who-title">{copy.whoTitle}</h2>
          <p>{copy.whoNote}</p>
        </header>
        <ul class="volunteer-who__list">{copy.who.map(item => <li>{item}</li>)}</ul>
      </div>
    </section>

    <section class="volunteer-section volunteer-philosophy" aria-labelledby="volunteer-philosophy-title">
      <div class="volunteer-wrap">
        <p class="volunteer-eyebrow">OUR PHILOSOPHY</p>
        <h2 id="volunteer-philosophy-title" lang="en"><span>To Be.</span> <span>To Do.</span> <span>To Have.</span></h2>
        <p class="volunteer-philosophy__lead">{copy.philosophyLead}</p>
        <div class="volunteer-prose">{copy.philosophy.map(paragraph => <p>{paragraph}</p>)}</div>
      </div>
    </section>

    <section id="join" class="volunteer-section volunteer-join" aria-labelledby="volunteer-join-title">
      <div class="volunteer-wrap">
        <p class="volunteer-eyebrow">JOIN OUR COMMUNITY</p>
        <h2 id="volunteer-join-title">{copy.joinTitle}</h2>
        <div class="volunteer-prose">{copy.join.map(paragraph => <p>{paragraph}</p>)}</div>
        <!-- Keep this a disabled button until SATORIN supplies the final locale-specific application forms. -->
        <button type="button" class="volunteer-apply" disabled aria-label={copy.applyLabel} aria-describedby="application-pending">{copy.apply} <span aria-hidden="true">→</span></button>
        <p id="application-pending" class="volunteer-join__pending">{copy.pending}</p>
        <p class="volunteer-join__detail">{copy.participation}</p>
        <p class="volunteer-join__detail">{copy.volunteerNote}</p>
      </div>
    </section>
  </article>
</Layout>
