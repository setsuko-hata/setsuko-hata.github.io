---
import Layout from '../layouts/Layout.astro';
import ExploreCards from '../components/ExploreCards.astro';

const videoUrl = 'https://www.youtube.com/watch?v=vX_uhpmGQmQ';
const instagramUrl = 'https://www.instagram.com/setsuko_hata/';

const bio = [
  '秦 節子。大阪府出身。ジャズシンガー、作曲家、編曲家、ハタヨガ講師。大阪市立大学生活科学部食品栄養学科卒業。21歳で躁うつ病を経験するも克服し、2011年に音楽を学ぶため渡米。',
  'その後13年間、ニューヨーク、コロラド、ロサンゼルスを拠点に、プロのジャズシンガー・作曲家として活動。ニューヨークでジャズボーカルを学び、北コロラド大学大学院ではジャズに加え、ビッグバンド、オーケストラ、映画音楽など幅広いジャンルの作曲・編曲を研究。同大学では日本人初となる教授アシスタントを務めた。',
  '全米各地で演奏活動を行いながら、ロサンゼルスの名門ジャズクラブ Catalina Jazz Club にてソロコンサートを開催するなど、多数の自主企画公演をプロデュース。2024年には読売テレビのドキュメンタリー番組「グッと！地球便」に出演し、ジャズシンガーとしての活動が特集された。',
  '2024年には Isha Foundation にて約1年半にわたりヨガと瞑想を探求。1,750時間を超える厳格なトレーニングを修了し、Sadhguru 公認のハタヨガ講師資格を取得。現在、日本国内で認定を受けた講師はわずか4名のみであり、その一人として活動している。',
  'セツコの音楽は、ジャズの伝統に根ざしながらも、人生の探求、内なる成長、そして自然とのつながりを独自の世界観で表現している。2026年より活動拠点を日本へ移し、「ストレスやうつに苦しむ人を一人でも減らし、一人ひとりが本来持つ可能性を開花できる社会をつくる」というビジョンのもと活動を展開。音楽を通じて人々の心に希望と感動を届けるとともに、ハタヨガ講師として人生を変革するための実践的なツールを伝えている。',
  '音楽とヨガという二つのアプローチを通じて、人々の内なる生命力と可能性を呼び覚ますことを活動のテーマとしている。',
];

const journey = [
  { year: '2011', title: 'To America', body: '音楽を学ぶため渡米。ニューヨークでジャズボーカルを学ぶ。' },
  { year: '2011–24', title: 'New York · Colorado · Los Angeles', body: '北コロラド大学大学院で作曲・編曲を研究。同大学で日本人初の教授アシスタントを務める。' },
  { year: '2024', title: 'Yoga & Meditation', body: 'Isha Foundationで1,750時間超のトレーニングを修了し、ハタヨガ講師資格を取得。' },
  { year: '2026', title: 'Home to Japan', body: '活動拠点を日本へ。東京で新たなステージへ。' },
];
---

<Layout
  title="音楽 | 秦 節子 Setsuko Hata — ジャズシンガー"
  description="ジャズシンガー・作曲家・編曲家 秦節子（Setsuko Hata）。ニューヨーク・コロラド・ロサンゼルスで13年間活動し、2026年より東京を拠点に。歌声と歩みを紹介します。"
  active="music"
  footer="none"
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap"
    rel="stylesheet"
  />

  <div class="jazz">
    <section class="jazz-hero">
      <div class="jazz-hero__inner">
        <p class="jazz-hero__eyebrow" lang="en">Jazz Vocalist · Composer · Arranger</p>
        <h1 class="jazz-hero__title" lang="en">Setsuko <em>Hata</em></h1>
        <p class="jazz-hero__sub">秦 節子 ─ ジャズシンガー</p>
        <div class="jazz-hero__actions">
          <a class="jazz-btn" href="#listen" lang="en">Listen</a>
        </div>
      </div>
    </section>

    <section id="about" class="jazz-section jazz-section--wide">
      <div class="jazz-artist">
        <img
          class="jazz-artist__photo"
          src="/assets/jazz-headshot.jpg"
          alt="Setsuko Hata singing"
          width="1090"
          height="1030"
          loading="lazy"
          decoding="async"
        />
        <div class="jazz-artist__text" data-reveal>
          <p class="jazz-label" lang="en">The Artist</p>
          <h2 class="jazz-lead" lang="en">A song for life <em>itself</em>.</h2>
          <div class="jazz-artist__bio">
            {bio.map((para) => <p>{para}</p>)}
          </div>
        </div>
      </div>
    </section>

    <hr class="jazz-rule" />

    <section class="jazz-section">
      <div data-reveal>
        <p class="jazz-label" lang="en">The Journey</p>
        <ol class="jazz-journey">
          {
            journey.map((j) => (
              <li class="jazz-journey__item">
                <div class="jazz-journey__year" lang="en">{j.year}</div>
                <div>
                  <div class="jazz-journey__title" lang="en">{j.title}</div>
                  <div class="jazz-journey__body">{j.body}</div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="listen" class="jazz-section">
      <div class="jazz-listen" data-reveal>
        <p class="jazz-label" lang="en">Listen</p>
        <h2 class="jazz-lead jazz-lead--spaced" lang="en">Hear the <em>voice</em>.</h2>
        <a class="jazz-video" href={videoUrl} target="_blank" rel="noopener">
          <div class="jazz-video__thumb">
            <img
              src="https://img.youtube.com/vi/vX_uhpmGQmQ/hqdefault.jpg"
              alt="Setsuko Hata performance video"
              loading="lazy"
              decoding="async"
            />
            <div class="jazz-video__play" aria-hidden="true"><span>▶</span></div>
          </div>
          <div class="jazz-video__cap" lang="en">Watch on YouTube ↗</div>
        </a>
      </div>
    </section>

    <section id="connect" class="jazz-connect">
      <div data-reveal>
        <h2 class="jazz-connect__title" lang="en">Stay close to the <em>sound</em>.</h2>
        <p class="jazz-connect__jp">最新情報はInstagramで。</p>
        <div class="jazz-connect__links">
          <a class="jazz-btn jazz-btn--solid" href={instagramUrl} target="_blank" rel="noopener" lang="en">@setsuko_hata ↗</a>
          <a class="jazz-textlink" href={videoUrl} target="_blank" rel="noopener" lang="en">YouTube ↗</a>
        </div>
      </div>
    </section>

    <div class="jazz-signoff" lang="en">
      <div class="jazz-signoff__name">SETSUKO HATA</div>
      <div class="jazz-signoff__tag">Jazz Vocalist · Tokyo</div>
    </div>
  </div>

  <ExploreCards reveal show={['yoga', 'home']} />
</Layout>
