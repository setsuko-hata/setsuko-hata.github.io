---
import Layout from '../layouts/Layout.astro';
import { translator, localizedPath, type Locale } from '../data/personal-i18n';
interface Props { locale?: Locale; }
const { locale = 'ja' } = Astro.props;
const t = translator(locale);
const link = (path: string) => localizedPath(path, locale);

import StatCards from '../components/StatCards.astro';
import ExploreCards from '../components/ExploreCards.astro';
import SignupForm from '../components/SignupForm.astro';
---

<Layout
  locale={locale}
  title={t("秦 節子 | ジャズシンガー・作曲家・ハタヨガ講師", "Setsuko Hata | Jazz Singer, Composer & Hatha Yoga Teacher")}
  description={t("秦節子（Setsuko Hata）公式サイト。ジャズシンガー・作曲家・編曲家、サドグル公認ハタヨガ講師。音楽とヨガを通して、より健康で幸せな人生を。", "The official website of Setsuko Hata, jazz singer, composer, arranger, and Sadhguru-certified Hatha Yoga teacher. Music and yoga for a healthier, happier life.")}
  active="home"
  footer="home"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://setsukohata.com/#person',
    name: 'Setsuko Hata',
    alternateName: ['秦 節子', '秦節子'],
    url: 'https://setsukohata.com/',
    image: 'https://setsukohata.com/assets/setsuko-portrait.jpg',
    jobTitle: ['Jazz Singer', 'Composer', 'Arranger', 'Hatha Yoga Teacher'],
    email: 'mailto:info@setsukohata.com',
    sameAs: [
      'https://www.instagram.com/setsuko_hata/',
      'https://www.youtube.com/@setsukohata',
      'https://www.youtube.com/@SetsukoHataFlows',
      'https://www.youtube.com/@SetsukoHataJapanse',
    ],
  }}
>
  <section class="hero">
    <div class="hero__frame">
      <picture>
        <source type="image/webp" media="(max-width: 900px)" srcset="/assets/hero-stream-900.webp" />
        <source type="image/webp" srcset="/assets/hero-stream.webp" />
        <img
          fetchpriority="high"
          decoding="async"
          src="/assets/hero-stream.jpg"
          alt={t("渓流のほとりに佇む秦 節子", "Setsuko Hata beside a mountain stream")}
          class="hero__img"
        />
      </picture>
    </div>
    <div class="hero__overlay"></div>

    <div class="hero__copy-wrap">
      <div class="hero__copy">
        <h1 class="hero__title">Setsuko Hata</h1>

        <p class="hero__roles" lang={locale}>
          {t("ジャズ歌手", "Jazz Singer")}<span class="dot">・</span>{t("作曲家", "Composer")}<span class="dot">・</span>{t("ハタヨガ講師", "Hatha Yoga Teacher")}
        </p>

        <p class="hero__kicker">{t("ヨガ・音楽・意識的な暮らし", "Yoga · Music · Conscious Living")}</p>

        <div class="hero__ctas">
          <a href="#paths" class="btn-primary" lang={locale}>{t("ヨガと音楽を見る", "Explore Yoga & Music")} <span class="arrow">→</span></a>
          <a href={link('/about/')} class="btn-text" lang={locale}>{t("節子について", "About Setsuko")} <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="hero-stats" aria-label={t("ひと目でわかるプロフィール", "At a glance")}>
    <div class="hero-stats__inner">
      <StatCards locale={locale} float />
    </div>
  </section>

  <section class="connect">
    <div class="connect__inner">
      <div class="connect__label-row">
        <span class="connect__label">{t("つながる・コミュニティに参加する", "Connect & join the community")}</span>
      </div>
      <div class="connect__row">
        <div class="connect__grid">
          <a href="https://www.instagram.com/setsuko_hata/" target="_blank" rel="noopener" class="connect__link">
            <span class="connect__icon">
              <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true"><path d="M7 2C4.24 2 2 4.24 2 7v10c0 2.76 2.24 5 5 5h10c2.76 0 5-2.24 5-5V7c0-2.76-2.24-5-5-5H7zm10 2c1.66 0 3 1.34 3 3v10c0 1.66-1.34 3-3 3H7c-1.66 0-3-1.34-3-3V7c0-1.66 1.34-3 3-3h10zm-5 3.5A4.5 4.5 0 1 0 16.5 12 4.5 4.5 0 0 0 12 7.5zm0 2A2.5 2.5 0 1 1 9.5 12 2.5 2.5 0 0 1 12 9.5zM17.5 6a1 1 0 1 0 1 1 1 1 0 0 0-1-1z"></path></svg>
            </span>
            <span class="connect__title">Instagram</span>
            <span class="connect__caption">{t("日々のインスピレーション", "Daily inspiration")}</span>
          </a>
          <a href="https://www.youtube.com/@setsukohata" target="_blank" rel="noopener" class="connect__link">
            <span class="connect__icon">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true"><path d="M22 12s0-3.2-.4-4.7c-.2-.9-.9-1.6-1.8-1.8C18.1 5 12 5 12 5s-6.1 0-7.8.5c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7c.2.9.9 1.6 1.8 1.8C5.9 19 12 19 12 19s6.1 0 7.8-.5c.9-.2 1.6-.9 1.8-1.8.4-1.5.4-4.7.4-4.7zM10 15.2V8.8L15.5 12 10 15.2z"></path></svg>
            </span>
            <span class="connect__title">{t("音楽", "Music")}</span>
            <span class="connect__caption">{t("歌と演奏", "Songs & performances")}</span>
          </a>
          <a href="https://www.youtube.com/@SetsukoHataJapanse" target="_blank" rel="noopener" class="connect__link">
            <span class="connect__icon">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true"><path d="M22 12s0-3.2-.4-4.7c-.2-.9-.9-1.6-1.8-1.8C18.1 5 12 5 12 5s-6.1 0-7.8.5c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7c.2.9.9 1.6 1.8 1.8C5.9 19 12 19 12 19s6.1 0 7.8-.5c.9-.2 1.6-.9 1.8-1.8.4-1.5.4-4.7.4-4.7zM10 15.2V8.8L15.5 12 10 15.2z"></path></svg>
            </span>
            <span class="connect__title">{t("ヨガ 日本語", "Yoga in Japanese")}</span>
            <span class="connect__caption">{t("日本語での実践", "Practices in Japanese")}</span>
          </a>
          <a href="https://www.youtube.com/@SetsukoHataFlows" target="_blank" rel="noopener" class="connect__link">
            <span class="connect__icon">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true"><path d="M22 12s0-3.2-.4-4.7c-.2-.9-.9-1.6-1.8-1.8C18.1 5 12 5 12 5s-6.1 0-7.8.5c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7c.2.9.9 1.6 1.8 1.8C5.9 19 12 19 12 19s6.1 0 7.8-.5c.9-.2 1.6-.9 1.8-1.8.4-1.5.4-4.7.4-4.7zM10 15.2V8.8L15.5 12 10 15.2z"></path></svg>
            </span>
            <span class="connect__title">{t("ヨガ 英語", "Yoga in English")}</span>
            <span class="connect__caption">{t("英語での実践", "Practices in English")}</span>
          </a>
        </div>
        <a href="https://lin.ee/tIN07iZ" target="_blank" rel="noopener" class="line-card">
          <span class="line-badge">LINE</span>
          <span class="line-card__body">
            <span class="line-card__title">{t("LINE登録", "LINE Registration")}</span>
            <span class="line-card__caption">{t("コミュニティに参加", "Join my community")}</span>
          </span>
          <span class="line-card__arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <SignupForm locale={locale} />

  <section class="intro">
    <div class="intro__media" data-reveal>
      <img
        loading="lazy"
        decoding="async"
        src="/assets/setsuko-portrait.jpg"
        alt={t("秦 節子", "Setsuko Hata")}
        class="intro__img"
      />
    </div>
    <div class="intro__body" data-reveal>
      <div class="eyebrow intro__eyebrow">{t("音楽とヨガ", "Music and Yoga")}</div>
      <h2 class="intro__heading" lang={locale}>{t("音楽とヨガ", "Music and Yoga")}</h2>
      <div class="divider">
        <span class="divider__rule"></span>
        <span class="divider__diamond"></span>
        <span class="divider__hairline"></span>
      </div>
      <p class="intro__text" lang={locale}>
        {t("私にとってこの二つは、人生を変えてくれたかけがえのない贈り物です。", "For me, these two are precious gifts that transformed my life.")}<br />
        {t("音楽は心を開き、ヨガは生命の可能性を開いてくれました。", "Music opened my heart, and yoga opened the possibilities of life.")}<br />
        {t("苦しみの中にいた私自身が、この二つを通して生きる喜びを取り戻すことができたように、一人でも多くの人が、自分の内なる豊かさと可能性に気づき、より意識的で幸せな人生を歩んでほしいと願っています。", "Just as they helped me rediscover the joy of living through difficult times, I hope more people can discover their inner richness and potential, and live more consciously and happily.")}<br />
        {t("音楽とヨガを通して、人々がより健康に、より幸せに、そして自分らしく輝ける社会へ。", "Through music and yoga, I work toward a society where people can live healthier, happier lives and shine in their own way.")}<br />
        {t("そんな未来の実現に向けて、活動を続けています。", "That is the future I continue to work toward.")}
      </p>
      <div class="chips">
        <span class="chip" lang={locale}>{t("ジャズシンガー", "Jazz Singer")}</span>
        <span class="chip" lang={locale}>{t("作曲家", "Composer")}</span>
        <span class="chip" lang={locale}>{t("編曲家", "Arranger")}</span>
        <span class="chip" lang={locale}>{t("ハタヨガ講師", "Hatha Yoga Teacher")}</span>
      </div>
      <a href={link('/about/')} class="text-link">
        <span lang={locale}>{t("節子について", "About Setsuko")}</span> <span class="arrow">→</span>
      </a>
    </div>
  </section>

  <ExploreCards locale={locale} reveal />
</Layout>
