---
import YogaLayout from '../../../layouts/YogaLayout.astro';
---
<YogaLayout title="Contact | Setsuko Hata Yoga"
  description="Get in touch about classes, workshops, or a corporate wellness program."
  locale="en"
  active="contact"
  ogTitle="Setsuko Hata Yoga Studio"
  ogDescription="Authentic Hatha Yoga instruction by a Sadhguru Certified teacher, trained over 1,750 hours in India. Classes in Tokyo and Osaka, and corporate wellness programs."
  themeColor="var(--color-surface-sage)"
  alternateHref="/hatha-yoga/ja/contact/"
>

        <section class="ja-band ja-band-sage pt-32 pb-24 md:pt-40 md:pb-28">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
            <p
              class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
            >
              Contact
            </p>
            <h1
              class="mt-6 max-w-3xl font-display text-5xl leading-[1.05] text-brand-espresso md:text-7xl"
            >
              Contact
            </h1>
            <p class="mt-8 max-w-xl text-lg leading-relaxed text-brand-espresso">
              Reach out about classes, workshops, or a corporate program.
            </p>
          </div>
        </section>
        <section class="bg-paper py-24 md:py-32">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
            <div class="grid gap-16 md:grid-cols-2 md:gap-24">
              <div>
                <p
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                >
                  Get in touch
                </p>
                <h2
                  class="mt-4 font-display text-3xl leading-[1.15] md:text-4xl"
                >
                  Reach out. We&#x27;ll reply within two business days.
                </h2>
                <div class="mt-10">
                  <form class="space-y-7" action="https://formsubmit.co/yoga@setsukohata.com" method="POST">
                    <input type="hidden" name="_subject" value="New contact form message" />
                    <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
                    <div>
                      <label
                        for="name"
                        class="mb-2 block font-mono text-[13px] uppercase tracking-[0.22em] text-brand-espresso/70"
                        >Name<!-- -->
                        <span aria-hidden="true">*</span></label
                      ><input
                        id="name"
                        type="text"
                        required=""
                        autocomplete="name"
                        class="w-full border-b border-brand-espresso/25 bg-transparent py-2 text-brand-espresso focus:border-brand-moss focus:outline-none"
                        name="name"
                      />
                    </div>
                    <div>
                      <label
                        for="email"
                        class="mb-2 block font-mono text-[13px] uppercase tracking-[0.22em] text-brand-espresso/70"
                        >Email<!-- -->
                        <span aria-hidden="true">*</span></label
                      ><input
                        id="email"
                        type="email"
                        required=""
                        autocomplete="email"
                        class="w-full border-b border-brand-espresso/25 bg-transparent py-2 text-brand-espresso focus:border-brand-moss focus:outline-none"
                        name="email"
                      />
                    </div>
                    <div>
                      <label
                        for="phone"
                        class="mb-2 block font-mono text-[13px] uppercase tracking-[0.22em] text-brand-espresso/70"
                        >Phone (optional)<!-- --> </label
                      ><input
                        id="phone"
                        type="tel"
                        autocomplete="tel"
                        class="w-full border-b border-brand-espresso/25 bg-transparent py-2 text-brand-espresso focus:border-brand-moss focus:outline-none"
                        name="phone"
                      />
                    </div>
                    <div>
                      <label
                        for="message"
                        class="mb-2 block font-mono text-[13px] uppercase tracking-[0.22em] text-brand-espresso/70"
                        >Message<!-- -->
                        <span aria-hidden="true">*</span></label
                      ><textarea
                        id="message"
                        name="message"
                        required=""
                        rows="5"
                        class="w-full border-b border-brand-espresso/25 bg-transparent py-2 text-brand-espresso focus:border-brand-moss focus:outline-none"
                      ></textarea>
                    </div>
                    <button
                      type="submit"
                      class="inline-flex items-center justify-center gap-2 px-7 py-3.5 text-[14px] uppercase tracking-[0.18em] font-medium transition-colors duration-300 active:translate-y-px bg-brand-espresso text-white hover:bg-brand-moss disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      Send Message
                    </button>
                  </form>
                </div>
              </div>
              <div class="space-y-12">
                <div>
                  <p
                    class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                  >
                    Studio
                  </p>
                  <p class="mt-4 text-brand-espresso/80">
                    Venue details for Osaka classes are shared after you
                    register.
                  </p>
                  <p
                    class="mt-2 font-mono text-[13px] uppercase tracking-[0.22em] text-brand-espresso/60"
                  >
                    Osaka, Japan
                  </p>
                </div>
                <div
                  class="flex aspect-[4/3] items-center justify-center border border-dashed border-brand-espresso/20 bg-brand-cream/40 font-mono text-[13px] uppercase tracking-[0.24em] text-brand-espresso/50"
                  role="img"
                  aria-label="Map coming soon"
                >
                  Map coming soon
                </div>
              </div>
            </div>
          </div>
        </section>
</YogaLayout>
