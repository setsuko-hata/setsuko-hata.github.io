---
import YogaLayout from '../../../layouts/YogaLayout.astro';
---
<YogaLayout title="Membership | Setsuko Hata Yoga"
  description="A continuing membership with two in-person classes a month, one online class, and a health seminar. Plans and schedule for Osaka classes."
  locale="en"
  active="membership"
  ogTitle="Setsuko Hata Yoga Studio"
  ogDescription="Authentic Hatha Yoga instruction by a Sadhguru Certified teacher, trained over 1,750 hours in India. Classes in Tokyo and Osaka, and corporate wellness programs."
  themeColor="var(--color-surface-sage)"
  alternateHref="/hatha-yoga/ja/offerings/#membership"
>

        <section class="ja-band ja-band-sage pt-32 pb-24 md:pt-40 md:pb-32">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
            <p
              class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
            >
              Membership
            </p>
            <h1
              class="mt-6 max-w-3xl font-display text-5xl leading-[1.05] text-brand-espresso md:text-7xl"
            >
              Rooting Hatha Yoga into daily life
            </h1>
            <p class="mt-8 max-w-xl text-lg leading-relaxed text-brand-espresso">
              Two in-person classes a month, one online class, and one health
              seminar grounded in yoga science, together shaping body, mind, and
              daily habit.
            </p>
          </div>
        </section>
        <section class="bg-[var(--color-ivory-cream)] py-24 md:py-32">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
            <p
              class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
            >
              Schedule
            </p>
            <div
              class="mt-10 divide-y divide-brand-espresso/15 border-t border-brand-espresso/15"
            >
              <div
                class="grid gap-4 py-9 md:grid-cols-[80px_280px_1fr] md:gap-10"
              >
                <p
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                >
                  01
                </p>
                <div>
                  <h3 class="text-2xl">In-person classes (Osaka)</h3>
                  <p
                    class="mt-2 font-mono text-[13px] uppercase tracking-[0.2em] text-brand-espresso/60"
                  >
                    Thursdays and Saturdays, 9:30-10:45am or 11:00am-12:15pm
                    (dates vary by month)
                  </p>
                </div>
                <p class="max-w-xl text-brand-espresso/80">
                  Each class works through yoga postures, breathwork, and
                  meditation, with close attention to individual form so home
                  practice stays safe and accurate.
                </p>
              </div>
              <div
                class="grid gap-4 py-9 md:grid-cols-[80px_280px_1fr] md:gap-10"
              >
                <p
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                >
                  02
                </p>
                <div>
                  <h3 class="text-2xl">Early-morning online yoga</h3>
                  <p
                    class="mt-2 font-mono text-[13px] uppercase tracking-[0.2em] text-brand-espresso/60"
                  >
                    Wednesdays, 6:00-7:00am
                  </p>
                </div>
                <p class="max-w-xl text-brand-espresso/80">
                  Join from home in the quiet of early morning to steady body
                  and energy before the day begins.
                </p>
              </div>
              <div
                class="grid gap-4 py-9 md:grid-cols-[80px_280px_1fr] md:gap-10"
              >
                <p
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                >
                  03
                </p>
                <div>
                  <h3 class="text-2xl">Health seminar</h3>
                  <p
                    class="mt-2 font-mono text-[13px] uppercase tracking-[0.2em] text-brand-espresso/60"
                  >
                    Schedule to be announced
                  </p>
                </div>
                <p class="max-w-xl text-brand-espresso/80">
                  A close look at diet, sleep, breath, and daily habit, grounded
                  in yoga science.
                </p>
              </div>
            </div>
          </div>
        </section>
        <section class="bg-brand-cream/60 py-24 md:py-32">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
            <div class="mb-16 max-w-2xl">
              <p
                class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
              >
                Plans
              </p>
              <h2 class="mt-4 font-display text-4xl leading-[1.15] md:text-5xl">
                Choose your rhythm
              </h2>
            </div>
            <div class="grid gap-6 md:grid-cols-3">
              <div
                class="flex flex-col gap-8 p-9 transition-colors ja-band ja-band-sand"
              >
                <div>
                  <p
                    class="font-mono text-[13px] uppercase tracking-[0.22em] text-brand-moss"
                  >
                    Complete
                  </p>
                  <p class="mt-6 font-display text-5xl leading-none">
                    10,000 yen
                  </p>
                  <p class="mt-2 text-sm text-brand-espresso">
                    monthly (in-person + online + seminar)
                  </p>
                </div>
                <ul
                  class="flex-1 space-y-3 border-t pt-6 text-sm leading-relaxed border-brand-espresso/20 text-brand-espresso"
                >
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="text-brand-moss">─</span
                    ><span>Two in-person classes a month</span>
                  </li>
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="text-brand-moss">─</span
                    ><span>One early-morning online class</span>
                  </li>
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="text-brand-moss">─</span
                    ><span>One monthly health seminar</span>
                  </li>
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="text-brand-moss">─</span
                    ><span>Discounts on core programs</span>
                  </li>
                </ul>
                <a
                  href="/hatha-yoga/en/contact/"
                  class="inline-flex items-center justify-center gap-2 px-5 py-3.5 text-[13px] uppercase tracking-[0.22em] transition-colors bg-white text-brand-espresso hover:bg-brand-tan"
                  >Book a Class<!-- -->
                  →</a
                >
              </div>
              <div
                class="flex flex-col gap-8 p-9 transition-colors border border-brand-espresso/15 bg-white"
              >
                <div>
                  <p
                    class="font-mono text-[13px] uppercase tracking-[0.22em] text-brand-moss"
                  >
                    In-Person Only
                  </p>
                  <p class="mt-6 font-display text-5xl leading-none">
                    7,000 yen
                  </p>
                  <p class="mt-2 text-sm text-brand-espresso/60">monthly</p>
                </div>
                <ul
                  class="flex-1 space-y-3 border-t pt-6 text-sm leading-relaxed border-brand-espresso/10 text-brand-espresso/85"
                >
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="text-brand-moss">─</span
                    ><span>Two in-person classes a month</span>
                  </li>
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="text-brand-moss">─</span
                    ><span>Form review and practice support</span>
                  </li>
                </ul>
                <a
                  href="/hatha-yoga/en/contact/"
                  class="inline-flex items-center justify-center gap-2 px-5 py-3.5 text-[13px] uppercase tracking-[0.22em] transition-colors bg-brand-espresso text-white hover:bg-brand-moss"
                  >Book a Class<!-- -->
                  →</a
                >
              </div>
              <div
                class="flex flex-col gap-8 p-9 transition-colors border border-brand-espresso/15 bg-white"
              >
                <div>
                  <p
                    class="font-mono text-[13px] uppercase tracking-[0.22em] text-brand-moss"
                  >
                    Online Only
                  </p>
                  <p class="mt-6 font-display text-5xl leading-none">
                    6,000 yen
                  </p>
                  <p class="mt-2 text-sm text-brand-espresso/60">monthly</p>
                </div>
                <ul
                  class="flex-1 space-y-3 border-t pt-6 text-sm leading-relaxed border-brand-espresso/10 text-brand-espresso/85"
                >
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="text-brand-moss">─</span
                    ><span>One early-morning online class</span>
                  </li>
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="text-brand-moss">─</span
                    ><span>Guidance for safe home practice</span>
                  </li>
                </ul>
                <a
                  href="/hatha-yoga/en/contact/"
                  class="inline-flex items-center justify-center gap-2 px-5 py-3.5 text-[13px] uppercase tracking-[0.22em] transition-colors bg-brand-espresso text-white hover:bg-brand-moss"
                  >Book a Class<!-- -->
                  →</a
                >
              </div>
            </div>
          </div>
        </section>
        <section class="bg-[var(--color-ivory-cream)] py-24 md:py-32">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10 max-w-3xl">
            <p
              class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
            >
              Member benefits
            </p>
            <ul class="mt-10 space-y-4">
              <li class="grid grid-cols-[40px_1fr] gap-4">
                <span
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                  >01</span
                ><span class="text-brand-espresso/85"
                  >Two in-person classes a month</span
                >
              </li>
              <li
                class="grid grid-cols-[40px_1fr] gap-4 border-t border-brand-espresso/10 pt-4"
              >
                <span
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                  >02</span
                ><span class="text-brand-espresso/85"
                  >One early-morning online class a month</span
                >
              </li>
              <li
                class="grid grid-cols-[40px_1fr] gap-4 border-t border-brand-espresso/10 pt-4"
              >
                <span
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                  >03</span
                ><span class="text-brand-espresso/85"
                  >One health seminar grounded in yoga science, monthly</span
                >
              </li>
              <li
                class="grid grid-cols-[40px_1fr] gap-4 border-t border-brand-espresso/10 pt-4"
              >
                <span
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                  >04</span
                ><span class="text-brand-espresso/85"
                  >Form review and practice support for the core programs</span
                >
              </li>
              <li
                class="grid grid-cols-[40px_1fr] gap-4 border-t border-brand-espresso/10 pt-4"
              >
                <span
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                  >05</span
                ><span class="text-brand-espresso/85"
                  >Individual guidance for safe home practice</span
                >
              </li>
              <li
                class="grid grid-cols-[40px_1fr] gap-4 border-t border-brand-espresso/10 pt-4"
              >
                <span
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                  >06</span
                ><span class="text-brand-espresso/85"
                  >5,000 yen off Surya Shakti and Surya Kriya programs</span
                >
              </li>
              <li
                class="grid grid-cols-[40px_1fr] gap-4 border-t border-brand-espresso/10 pt-4"
              >
                <span
                  class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss"
                  >07</span
                ><span class="text-brand-espresso/85"
                  >Regular members-only gatherings</span
                >
              </li>
            </ul>
          </div>
        </section>
</YogaLayout>
