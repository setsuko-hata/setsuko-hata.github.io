---
interface Props { locale?: 'ja' | 'en'; }
const { locale = 'ja' } = Astro.props;
const t = (ja: string, en: string) => locale === 'en' ? en : ja;

import YogaLayout from '../../../layouts/YogaLayout.astro';
import '../../../styles/yoga/pages/schools.css';
---
<YogaLayout title={t("学校・教育機関向け | Setsuko Hata Yoga", "Schools and Educational Institutions | Setsuko Hata Yoga")}
  description={t("小学校・中学校・高校・大学・専門学校への出張ハタヨガ・瞑想プログラム。集中力、ストレスマネジメント、心身のウェルビーイングを育てる体験授業・講演。", "On-site Hatha Yoga and meditation for elementary schools, junior high schools, high schools, universities, and vocational colleges. Classes and talks supporting concentration, stress management, and mental and physical wellbeing.")}
  locale={locale}
  active="schools"
>


        <section data-screen-label="Hero" style="position:relative;overflow:hidden;background:linear-gradient(150deg,var(--color-light-sage) 0%,#CBD0B8 38%,var(--color-warm-beige) 78%,#F9E7CB 100%)">
          <div aria-hidden="true" style="position:absolute;top:-180px;right:-120px;width:min(680px,86vw);height:600px;border-radius:50%;background:radial-gradient(circle,rgba(248,241,228,.62) 0%,rgba(248,241,228,0) 68%);pointer-events:none"></div>
          <div aria-hidden="true" style="position:absolute;left:-140px;bottom:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(208,138,94,.34) 0%,rgba(208,138,94,0) 70%);pointer-events:none"></div>
          <svg aria-hidden="true" viewBox="0 0 600 600" style="position:absolute;right:6%;top:8%;width:min(360px,40vw);opacity:.5;pointer-events:none"><circle cx="300" cy="300" r="240" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".45" /><circle cx="300" cy="300" r="180" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".28" /></svg>
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10" style="position:relative">
            <p class="font-mono uppercase tracking-[0.24em]" style="color:#5C4A2E">School Wellness Program</p>
            <h1 class="mt-6 max-w-4xl font-display text-3xl leading-[1.3] md:text-5xl md:leading-[1.2]" style="color:#33301F">{t("これからの時代を生きる若い世代に", "For the young generation shaping the future,")}<br />{t("一生使える「自分自身を整える力」を。", "lifelong skills to find balance within.")}</h1>
            <h2 class="mt-8 max-w-3xl font-display text-xl leading-snug md:text-2xl" style="color:#6B4A2C">{t("学校向け 出張ハタヨガ・瞑想プログラム", "Hatha Yoga and Meditation Programs for Schools")}</h2>
            <h3 class="mt-3 font-display text-lg leading-snug md:text-xl" style="color:#3E3A27">{t("小学校・中学校・高校・大学へ、本格ハタヨガ・瞑想をお届けします。", "Bringing authentic Hatha Yoga and meditation to elementary schools, junior high schools, high schools, and universities.")}</h3>
            <div class="mt-12 flex flex-wrap gap-4">
              <a href="#contact" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 font-medium">{t("出張授業・講演について相談する", "Discuss a school visit or talk")}</a>
              <a href="#stages" class="ja-btn-ghost inline-flex items-center justify-center gap-2 px-7 py-3.5 font-medium">{t("対象年齢を見る", "Explore age groups")}</a>
            </div>
          </div>
          <svg aria-hidden="true" viewBox="0 0 1440 140" preserveAspectRatio="none" style="position:absolute;left:0;right:0;bottom:-1px;width:100%;height:clamp(60px,8vw,110px);display:block;pointer-events:none">
            <path d="M0 66 C 240 22 430 116 700 96 C 980 76 1180 24 1440 58 L1440 140 L0 140 Z" fill="var(--color-ivory-cream)" opacity=".5" />
            <path d="M0 96 C 250 58 450 130 720 110 C 1000 90 1200 46 1440 86 L1440 140 L0 140 Z" fill="var(--color-ivory-cream)" />
          </svg>
        </section>

        <section style="position:relative;background:var(--color-ivory-cream)" data-screen-label={t("いまの学生たち", "Today's students")}>
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10" style="position:relative">
            <p class="font-mono uppercase tracking-[0.24em] ja-eyebrow">Students Today</p>
            <h2 class="mt-6 max-w-3xl font-display text-2xl leading-[1.35] md:text-4xl">{t("情報にあふれた時代を生きる、いまの学生たち", "Today's students live in a world overflowing with information")}</h2>
            <div class="mt-8 grid max-w-3xl gap-5">
              <p class="text-base leading-loose" style="color:#4A3F31">{t("現代の若い世代は、これまでにないほど多くの情報や刺激に囲まれて生活しています。スマートフォン・SNSとの向き合い方、勉強、受験、人間関係、就職、そして将来への不安。それぞれのライフステージによって、学生たちの抱える悩みやストレスも変化していきます。", "Young people today are surrounded by more information and stimulation than ever before. Smartphones and social media, studying, entrance exams, relationships, finding a job, and worries about the future: the concerns and stresses students face change at every stage of life.")}</p>
              <p class="text-base leading-loose" style="color:#4A3F31">{t("常に外から情報が入り続ける一方で、自分の心や身体の状態に気づき、静かに自分自身と向き合う時間は、ますます少なくなっています。", "As information continually flows in from outside, there is less and less time to notice how the mind and body feel and quietly turn inward.")}</p>
            </div>
          </div>
        </section>

        <section id="why" class="scroll-mt-24" style="position:relative;background:var(--color-ivory-cream);overflow:hidden" data-screen-label={t("背景", "Background")}>
          <svg aria-hidden="true" viewBox="0 0 600 600" style="position:absolute;left:-180px;top:60px;width:min(480px,56vw);opacity:.45;pointer-events:none"><path d="M300 30 C 470 30 570 170 540 320 C 512 462 380 570 240 552 C 92 533 20 400 34 268 C 48 132 140 30 300 30 Z" fill="var(--color-surface-sage)" /></svg>
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10" style="position:relative">
            <p class="font-mono uppercase tracking-[0.24em] ja-eyebrow">{t("いまの子どもたち・若い世代", "Children and young people today")}</p>
            <h2 class="mt-6 font-display text-3xl leading-[1.3] md:text-5xl">{t("静かに自分と向き合う時間が、失われています", "Time to quietly connect with themselves is disappearing")}</h2>
            <p class="mt-8 max-w-3xl text-base leading-loose" style="color:#4A3F31">{t("常に外から情報が入り続ける一方で、自分の心や身体に気づき、静かに向き合う時間は、ますます少なくなっています。ハタヨガ・瞑想は、その時間を教育の中に取り戻すための、具体的な方法です。", "As information continually flows in from outside, there is less and less time to notice the mind and body and quietly turn inward. Hatha Yoga and meditation offer a practical way to bring that time back into education.")}</p>
            <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
              <div class="sc-card sc-rise" style="background:var(--color-paper);border:1px solid rgba(138,96,67,.32);border-top:3px solid var(--color-sage);border-radius:6px;padding:32px 28px 34px">
                <span aria-hidden="true" class="sc-icon" style="display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:#E6E9D8;border:1px solid rgba(138,96,67,.4);color:var(--color-deep-olive);flex:none"><svg viewBox="0 0 32 32" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 16s5-8 14-8 14 8 14 8-5 8-14 8-14-8-14-8Z"/><circle cx="16" cy="16" r="3.5"/></svg></span>
                <h3 class="mt-6 font-display text-xl leading-snug">{t("集中する", "Focus")}</h3>
                <p class="mt-3 text-sm leading-relaxed" style="color:#4A3F31">{t("刺激に奪われた意識を、今ここに戻す。", "Bring attention back from distractions to the present moment.")}</p>
              </div>
              <div class="sc-card sc-rise" style="background:var(--color-paper);border:1px solid rgba(138,96,67,.32);border-top:3px solid var(--color-camel-brown);border-radius:6px;padding:32px 28px 34px">
                <span aria-hidden="true" class="sc-icon" style="display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:#F0E8D4;border:1px solid rgba(138,96,67,.4);color:var(--color-camel-brown);flex:none"><svg viewBox="0 0 32 32" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11c3.5-3 6.5-3 10 0s6.5 3 10 0M3 18c3.5-3 6.5-3 10 0s6.5 3 10 0M3 25c3.5-3 6.5-3 10 0s6.5 3 10 0" transform="translate(3 -1)"/></svg></span>
                <h3 class="mt-6 font-display text-xl leading-snug">{t("整える", "Find balance")}</h3>
                <p class="mt-3 text-sm leading-relaxed" style="color:#4A3F31">{t("心と身体の状態に、自分で気づく。", "Become aware of the state of your mind and body.")}</p>
              </div>
              <div class="sc-card sc-rise" style="background:var(--color-paper);border:1px solid rgba(138,96,67,.32);border-top:3px solid var(--color-soft-terracotta);border-radius:6px;padding:32px 28px 34px">
                <span aria-hidden="true" class="sc-icon" style="display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:#F7E6DC;border:1px solid rgba(138,96,67,.4);color:var(--color-soft-terracotta);flex:none"><svg viewBox="0 0 32 32" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3l11 4v8c0 7-4.6 11.8-11 14-6.4-2.2-11-7-11-14V7l11-4Z"/><path d="M11.5 16.5l3 3 6-6.5"/></svg></span>
                <h3 class="mt-6 font-display text-xl leading-snug">{t("向き合う", "Meet challenges")}</h3>
                <p class="mt-3 text-sm leading-relaxed" style="color:#4A3F31">{t("ストレスの中でも、自分を保つ。", "Stay grounded, even under stress.")}</p>
              </div>
              <div class="sc-card sc-rise" style="background:var(--color-paper);border:1px solid rgba(138,96,67,.32);border-top:3px solid var(--color-deep-olive);border-radius:6px;padding:32px 28px 34px">
                <span aria-hidden="true" class="sc-icon" style="display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:#E6E9D8;border:1px solid rgba(138,96,67,.4);color:var(--color-deep-olive);flex:none"><svg viewBox="0 0 32 32" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 28V14"/><path d="M16 14C16 9 12 5 6 5c0 6 4 9 10 9Z"/><path d="M16 16c0-4.4 3.6-8 9-8 0 5.4-4 8-9 8Z"/></svg></span>
                <h3 class="mt-6 font-display text-xl leading-snug">{t("生き生きと", "Live fully")}</h3>
                <p class="mt-3 text-sm leading-relaxed" style="color:#4A3F31">{t("本来の活力を、のびのびと発揮する。", "Allow your natural vitality to flourish.")}</p>
              </div>
            </div>
          </div>
        </section>

        <section id="stages" class="scroll-mt-24" style="position:relative;background:var(--color-warm-beige);overflow:hidden" data-screen-label={t("対象", "Age groups")}>
          <div aria-hidden="true" style="position:absolute;right:-150px;top:-100px;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle,rgba(180,190,148,.5) 0%,rgba(180,190,148,0) 70%);pointer-events:none"></div>
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10" style="position:relative">
            <p class="font-mono uppercase tracking-[0.24em] ja-eyebrow">{t("対象", "Age groups")}</p>
            <h2 class="mt-6 font-display text-3xl leading-[1.3] md:text-5xl">{t("その年齢に、いま必要な内容で", "What each age needs, right now")}</h2>
            <p class="mt-8 max-w-3xl text-base leading-loose" style="color:#4A3F31">{t("同じハタヨガでも、育てたい力と抱えている課題は年齢によって異なります。学校段階ごとに内容を組み立てます。", "Even within Hatha Yoga, the abilities to nurture and the challenges students face vary with age. Programs are designed for each stage of education.")}</p>
            <div class="ja-tablist mt-12" role="tablist" aria-label={t("学校段階", "School levels")}>
              <button type="button" role="tab" id="tab-stage-es" aria-controls="panel-stage-es" aria-selected="true" data-tab="stage-es" class="ja-tab" style="--ja-tab-accent:var(--color-sage)">
                <span class="block font-display text-lg leading-snug md:text-xl">{t("小学校", "Elementary school")}</span>
                <span class="mt-1 block font-mono text-[12px] tracking-[0.16em]" style="opacity:.7">{t("6〜12歳", "Ages 6–12")}</span>
              </button>
              <button type="button" role="tab" id="tab-stage-jhs" aria-controls="panel-stage-jhs" aria-selected="false" data-tab="stage-jhs" class="ja-tab" style="--ja-tab-accent:var(--color-camel-brown)">
                <span class="block font-display text-lg leading-snug md:text-xl">{t("中学校", "Junior high school")}</span>
                <span class="mt-1 block font-mono text-[12px] tracking-[0.16em]" style="opacity:.7">{t("12〜15歳", "Ages 12–15")}</span>
              </button>
              <button type="button" role="tab" id="tab-stage-hs" aria-controls="panel-stage-hs" aria-selected="false" data-tab="stage-hs" class="ja-tab" style="--ja-tab-accent:var(--color-soft-terracotta)">
                <span class="block font-display text-lg leading-snug md:text-xl">{t("高校", "High school")}</span>
                <span class="mt-1 block font-mono text-[12px] tracking-[0.16em]" style="opacity:.7">{t("15〜18歳", "Ages 15–18")}</span>
              </button>
              <button type="button" role="tab" id="tab-stage-uni" aria-controls="panel-stage-uni" aria-selected="false" data-tab="stage-uni" class="ja-tab" style="--ja-tab-accent:var(--color-deep-olive)">
                <span class="block font-display text-lg leading-snug md:text-xl">{t("大学 ・ 専門学校", "Universities and vocational colleges")}</span>
                <span class="mt-1 block font-mono text-[12px] tracking-[0.16em]" style="opacity:.7">{t("18歳〜", "Ages 18+")}</span>
              </button>
            </div>
            <div class="ja-stage-panels grid">
              <div id="panel-stage-es" role="tabpanel" aria-labelledby="tab-stage-es">
              <article class="sc-stage sc-rise" style="position:relative;overflow:hidden;background:var(--color-paper);border:1px solid rgba(138,96,67,.34);border-radius:8px;padding:clamp(28px,3.4vw,44px)">
                <span aria-hidden="true" style="position:absolute;left:0;top:0;bottom:0;width:6px;background:var(--color-sage)"></span>
                <div class="ja-stage-grid grid gap-8 md:gap-12">
                  <div>
                    <div style="display:flex;align-items:center;gap:16px">
                      <p class="font-mono ja-sublabel" style="color:var(--color-deep-olive)">{t("小学校 ・ 6〜12歳", "Elementary school · Ages 6–12")}</p>
                    </div>
                    <h3 class="mt-5 font-display text-2xl leading-snug md:text-3xl">{t("身体を動かし、自分に気づく力を育てる時期に", "A time to move the body and develop self-awareness")}</h3>
                  </div>
                  <div>
                    <p class="text-base leading-loose" style="color:#4A3F31">{t("スマートフォン、ゲーム、動画に触れる時間が増え、外で思いきり身体を動かす機会が少なくなっています。集中力が続かない。じっとしていることが難しい。気持ちの切り替えがうまくできない。運動不足や姿勢の乱れ、睡眠リズム、友人関係や学校生活へのストレスなど、幼い時期からさまざまな課題に向き合っています。", "As time spent with smartphones, games, and videos increases, there are fewer opportunities to move freely outdoors. Difficulty concentrating, sitting still, or shifting emotions can arise. From an early age, children face challenges including lack of exercise, poor posture, sleep patterns, friendships, and the stress of school life.")}</p>
                    <div class="mt-7" style="background:#E6E9D8;border-left:3px solid var(--color-sage);border-radius:0 6px 6px 0;padding:24px 28px">
                      <p class="font-display text-lg leading-snug">{t("ハタヨガ・瞑想でできること", "How Hatha Yoga and meditation can help")}</p>
                      <p class="mt-3 text-sm leading-relaxed" style="color:#4A3F31">{t("「動く」「感じる」「集中する」「静かになる」という体験を通して、集中力・身体感覚・姿勢・バランス・自分を落ち着かせる力の土台を育てます。", "Through experiences of moving, sensing, focusing, and becoming still, students build foundations for concentration, body awareness, posture, balance, and the ability to calm themselves.")}</p>
                    </div>
                    <p class="mt-8 font-display text-lg" style="color:var(--color-deep-olive)">{t("小学校での導入例", "Examples for elementary schools")}</p>
                    <ul class="mt-4 grid gap-2.5">
                      <li class="flex gap-3 text-sm leading-relaxed" style="color:#4A3F31"><span aria-hidden="true" style="color:var(--color-deep-olive);flex:none">✦</span><span>{t("体育・健康教育でのハタヨガ体験", "Hatha Yoga experiences in PE and health education")}</span></li>
                      <li class="flex gap-3 text-sm leading-relaxed" style="color:#4A3F31"><span aria-hidden="true" style="color:var(--color-deep-olive);flex:none">✦</span><span>{t("集中力を育てるハタヨガ・瞑想授業", "Hatha Yoga and meditation classes to build concentration")}</span></li>
                      <li class="flex gap-3 text-sm leading-relaxed" style="color:#4A3F31"><span aria-hidden="true" style="color:var(--color-deep-olive);flex:none">✦</span><span>{t("スマホ・ゲームなどデジタルとの付き合い方を考えるプログラム", "Programs exploring healthy relationships with smartphones, games, and digital media")}</span></li>
                      <li class="flex gap-3 text-sm leading-relaxed" style="color:#4A3F31"><span aria-hidden="true" style="color:var(--color-deep-olive);flex:none">✦</span><span>{t("身体を動かし、静かになる体験型プログラム", "Experiential programs combining movement and stillness")}</span></li>
                      <li class="flex gap-3 text-sm leading-relaxed" style="color:#4A3F31"><span aria-hidden="true" style="color:var(--color-deep-olive);flex:none">✦</span><span>{t("親子・PTA向け心と身体の健康プログラム", "Mind and body wellness programs for families and PTAs")}</span></li>
                    </ul>
                  </div>
                </div>
              </article>
              </div>
              <div id="panel-stage-jhs" role="tabpanel" aria-labelledby="tab-stage-jhs" hidden>
              <article class="sc-stage sc-rise" style="position:relative;overflow:hidden;background:var(--color-paper);border:1px solid rgba(138,96,67,.34);border-radius:8px;padding:clamp(28px,3.4vw,44px)">
                <span aria-hidden="true" style="position:absolute;left:0;top:0;bottom:0;width:6px;background:var(--color-camel-brown)"></span>
                <div class="ja-stage-grid grid gap-8 md:gap-12">
                  <div>
                    <div style="display:flex;align-items:center;gap:16px">
                      <p class="font-mono ja-sublabel" style="color:var(--color-camel-brown)">{t("中学校 ・ 12〜15歳", "Junior high school · Ages 12–15")}</p>
                    </div>
                    <h3 class="mt-5 font-display text-2xl leading-snug md:text-3xl">{t("思春期の変化とストレスの中で、自分と向き合う力を育てる時期に", "A time to develop self-awareness amid the changes and stresses of adolescence")}</h3>
                  </div>
                  <div>
                    <p class="text-base leading-loose" style="color:#4A3F31">{t("心も身体も大きく変化する思春期。高校受験や成績へのプレッシャー、友人関係、SNS、周囲との比較など、さまざまなストレスを感じやすくなる時期です。長時間の勉強やスマートフォンによる姿勢の乱れ、運動不足、睡眠不足など、身体への負担も増えていきます。", "Adolescence brings major changes to both mind and body. Entrance exams, pressure over grades, friendships, social media, and comparisons with others can bring increased stress. Long hours of studying and smartphone use, poor posture, lack of exercise, and insufficient sleep also place more strain on the body.")}</p>
                    <div class="mt-7" style="background:#F0E8D4;border-left:3px solid var(--color-camel-brown);border-radius:0 6px 6px 0;padding:24px 28px">
                      <p class="font-display text-lg leading-snug">{t("ハタヨガ・瞑想でできること", "How Hatha Yoga and meditation can help")}</p>
                      <p class="mt-3 text-sm leading-relaxed" style="color:#4A3F31">{t("勉強や情報、人間関係へ向き続けている意識を、一度自分自身へ戻す。集中力を取り戻し、身体の緊張に気づき、ストレスの中でも自分を整える体験につなげます。", "Bring attention back to yourself after constantly focusing on studies, information, and relationships. Students experience regaining focus, noticing physical tension, and finding balance even amid stress.")}</p>
                    </div>
                    <p class="mt-8 font-display text-lg" style="color:var(--color-camel-brown)">{t("中学校での導入例", "Examples for junior high schools")}</p>
                    <ul class="mt-4 grid gap-2.5">
                      <li class="flex gap-3 text-sm leading-relaxed" style="color:#4A3F31"><span aria-hidden="true" style="color:var(--color-camel-brown);flex:none">✦</span><span>{t("受験生向け集中力・心身コンディショニング", "Concentration and mind-body conditioning for exam students")}</span></li>
                      <li class="flex gap-3 text-sm leading-relaxed" style="color:#4A3F31"><span aria-hidden="true" style="color:var(--color-camel-brown);flex:none">✦</span><span>{t("思春期の心と身体を整えるハタヨガ・瞑想授業", "Hatha Yoga and meditation to support balance during adolescence")}</span></li>
                      <li class="flex gap-3 text-sm leading-relaxed" style="color:#4A3F31"><span aria-hidden="true" style="color:var(--color-camel-brown);flex:none">✦</span><span>{t("長時間の勉強による姿勢・身体のコンディショニング", "Posture and physical conditioning for long hours of studying")}</span></li>
                      <li class="flex gap-3 text-sm leading-relaxed" style="color:#4A3F31"><span aria-hidden="true" style="color:var(--color-camel-brown);flex:none">✦</span><span>{t("ストレスマネジメントプログラム", "Stress management programs")}</span></li>
