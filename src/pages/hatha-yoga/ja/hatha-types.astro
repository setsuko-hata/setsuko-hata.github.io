---
interface Props { locale?: 'ja' | 'en'; }
const { locale = 'ja' } = Astro.props;
const t = (ja: string, en: string) => locale === 'en' ? en : ja;

import YogaLayout from '../../../layouts/YogaLayout.astro';
---
<YogaLayout title={t("ハタヨガの種類 | Setsuko Hata Yoga", "Hatha Yoga Programs | Setsuko Hata Yoga")}
  description={t("イダ・ウパヨガ、スーリヤ・クリヤ、アンガマルダナ、ヨガアーサナ。ハタヨガの4つのプログラム。", "Ida Upa Yoga, Surya Kriya, Angamardana, and Yogasanas: four Hatha Yoga programs.")}
  locale={locale}
  active="hatha-types"
  ogDescription={t("ウパヨガ、スーリヤ・クリヤ、アンガマルダナ、ヨガアーサナ。ハタヨガの4つのプログラム。", "Upa Yoga, Surya Kriya, Angamardana, and Yogasanas: four Hatha Yoga programs.")}
>

<section style="position:relative;overflow:hidden;background:linear-gradient(90deg,color-mix(in srgb, var(--color-ivory-cream) 95%, transparent) 0%,color-mix(in srgb, var(--color-ivory-cream) 80%, transparent) 50%,color-mix(in srgb, var(--color-light-sage) 38%, transparent) 100%),var(--color-warm-beige) url(/hatha-yoga/assets/horizon.jpg) center/cover;padding:0 !important;margin:0 !important" data-screen-label={t("ハタヨガの種類", "Hatha Yoga Programs")}><div aria-hidden="true" style="position:absolute;pointer-events:none;top:-120px;right:-80px;width:520px;height:420px;border-radius:60% 40% 55% 45%/55% 60% 40% 45%;background:radial-gradient(circle at 40% 40%,color-mix(in srgb, var(--color-sage) 55%, transparent),color-mix(in srgb, var(--color-light-sage) 15%, transparent) 70%)"></div><div aria-hidden="true" style="position:absolute;pointer-events:none;bottom:-140px;left:-100px;width:440px;height:340px;border-radius:50% 50% 40% 60%;background:radial-gradient(circle,color-mix(in srgb, var(--color-sand-beige) 70%, transparent),transparent 70%)"></div><div style="position:relative"><div style="max-width:1152px;margin:0 auto;padding:clamp(120px,13vw,168px) clamp(20px,4vw,40px) clamp(48px,6vw,72px)"><p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.32em;color:var(--color-deep-olive)">{t("プログラム一覧", "Our programs")}</p><span aria-hidden="true" style="display:block;width:56px;height:2px;margin-top:16px;background:linear-gradient(90deg,var(--color-antique-gold),transparent)"></span><h1 style="margin:18px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(38px,6vw,64px);font-weight:400;line-height:1.25;color:var(--color-deep-olive)">{t("ハタヨガの種類", "Hatha Yoga Programs")}</h1><p style="margin:22px 0 0;max-width:34em;font-size:16px;line-height:2.05;color:var(--color-text-primary)">{t("4つのプログラムは、それぞれ異なる角度から、身体・心・エネルギーを育んでいきます。今のご自身に合う入り口から、ご覧ください。", "Four programs nurture the body, mind, and energy from different perspectives. Explore the starting point that suits you today.")}</p></div></div></section><section style="position:relative;overflow:hidden;background:linear-gradient(180deg,var(--color-ivory-cream),var(--color-surface-sage) 60%,var(--color-ivory-cream))" data-screen-label={t("プログラム一覧", "Our programs")}><div aria-hidden="true" style="position:absolute;pointer-events:none;top:20%;right:-160px;width:420px;height:520px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-light-sage) 35%, transparent),transparent 70%)"></div><div aria-hidden="true" style="position:absolute;pointer-events:none;bottom:5%;left:-180px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-soft-terracotta) 18%, transparent),transparent 70%)"></div><div style="position:relative;max-width:1152px;margin:0 auto;padding:clamp(24px,4vw,48px) clamp(20px,4vw,40px) clamp(24px,4vw,48px)"><article data-screen-label={t("ウパヨガ", "Upa Yoga")} style="border-top:1px solid color-mix(in srgb, var(--color-antique-gold) 45%, transparent);padding:clamp(32px,4vw,56px) 0"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:clamp(24px,3.5vw,56px);align-items:start"><a href="#upa" aria-label={t("ウパヨガの詳細へ", "Explore Upa Yoga in detail")} style="order:1;display:block;border-radius:10px;overflow:hidden;box-shadow:0 18px 40px -22px color-mix(in srgb, var(--color-deep-olive) 55%, transparent)"><img src="/assets/step-upa.jpg" alt={t("ウパヨガの実践", "Practicing Upa Yoga")} loading="lazy" style="width:100%;height:auto;display:block" /></a><div style="order:2"><p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:15px;letter-spacing:.2em;color:var(--color-deep-olive);display:flex;align-items:center;gap:12px"><span style="display:inline-block;width:28px;height:1px;background:var(--color-sage)"></span>01</p><h3 style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(28px,3vw,36px);font-weight:400;color:var(--color-deep-olive)">{t("ウパヨガ", "Upa Yoga")}</h3><p style="margin:10px 0 0;font-family:'Shippori Mincho',serif;font-size:18px;line-height:1.7;color:var(--color-text-primary)">{t("身体を目覚めさせ、ヨガの土台をつくる。", "Awaken the body and build a foundation for yoga.")}</p><p style="margin:16px 0 0;font-size:15px;line-height:2;color:var(--color-text-primary);max-width:34em">{t("関節・筋肉・エネルギーに働きかける、10のシンプルな実践です。身体の疲れやこわばりをやわらげ、動きやすさと活力を育みます。ヨガが初めての方の入り口として、また本格的なヨガへの準備として、身体を内側から整えます。", "Ten simple practices work with the joints, muscles, and energy. They ease fatigue and stiffness while cultivating mobility and vitality. An accessible introduction to yoga and preparation for deeper practice, Upa Yoga brings balance from within.")}</p><a href="#upa" style="display:inline-flex;align-items:center;min-height:44px;margin-top:10px;font-size:14px;letter-spacing:.14em;color:var(--color-text-primary);border-bottom:1px solid var(--color-sage)">{t("詳しく見る →", "Learn more →")}</a></div><ul style="order:3;margin:0;padding:0 0 0 clamp(0px,2vw,28px);list-style:none;display:grid;gap:0" aria-label={t("ウパヨガの主なメリット", "Key benefits of Upa Yoga")}><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-sage)"></span>{t("身体の疲れや緊張をやわらげる", "Ease physical fatigue and tension")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-sage)"></span>{t("関節と筋肉を強くする", "Strengthen the joints and muscles")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-sage)"></span>{t("動かしていなかった身体に活力を取り戻す", "Restore vitality to an inactive body")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-sage)"></span>{t("長旅や時差ボケによる負担をやわらげる", "Ease the strain of long journeys and jet lag")}</li></ul></div></article><article data-screen-label={t("スーリヤ・クリヤ", "Surya Kriya")} style="border-top:1px solid color-mix(in srgb, var(--color-antique-gold) 45%, transparent);padding:clamp(32px,4vw,56px) 0"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:clamp(24px,3.5vw,56px);align-items:start"><a href="#surya" aria-label={t("スーリヤ・クリヤの詳細へ", "Explore Surya Kriya in detail")} style="order:2;display:block;border-radius:10px;overflow:hidden;box-shadow:0 18px 40px -22px color-mix(in srgb, var(--color-deep-olive) 55%, transparent)"><img src="/assets/step-surya.jpg" alt={t("スーリヤ・クリヤの実践", "Practicing Surya Kriya")} loading="lazy" style="width:100%;height:auto;display:block" /></a><div style="order:1"><p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:15px;letter-spacing:.2em;color:var(--yl-gold);display:flex;align-items:center;gap:12px"><span style="display:inline-block;width:28px;height:1px;background:var(--color-antique-gold)"></span>02</p><h3 style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(28px,3vw,36px);font-weight:400;color:var(--color-deep-olive)">{t("スーリヤ・クリヤ", "Surya Kriya")}</h3><p style="margin:10px 0 0;font-family:'Shippori Mincho',serif;font-size:18px;line-height:1.7;color:var(--color-text-primary)">{t("内なる活力を高め、心に静けさを育む。", "Increase inner vitality and cultivate a quiet mind.")}</p><p style="margin:16px 0 0;font-size:15px;line-height:2;color:var(--color-text-primary);max-width:34em">{t("古くから受け継がれてきた、21のステップから成るヨガの実践です。内側のエネルギーに働きかけ、身体の安定と心の静けさを育みます。健康や集中力を支えるとともに、瞑想と内面の探求を深める土台を整えます。", "An ancient yogic practice comprising 21 steps. It works with inner energy to cultivate physical stability and mental stillness, supporting health and concentration while preparing a foundation for meditation and inner exploration.")}</p><a href="#surya" style="display:inline-flex;align-items:center;min-height:44px;margin-top:10px;font-size:14px;letter-spacing:.14em;color:var(--color-text-primary);border-bottom:1px solid var(--color-antique-gold)">{t("詳しく見る →", "Learn more →")}</a></div><ul style="order:3;margin:0;padding:0 0 0 clamp(0px,2vw,28px);list-style:none;display:grid;gap:0" aria-label={t("スーリヤ・クリヤの主なメリット", "Key benefits of Surya Kriya")}><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-antique-gold)"></span>{t("思考を明晰にし、集中力を高める", "Sharpen clarity and concentration")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-antique-gold)"></span>{t("身体の弱さを補い、健やかな基礎を育む", "Address physical weakness and build a healthy foundation")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-antique-gold)"></span>{t("活力とエネルギーを高める", "Increase vitality and energy")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-antique-gold)"></span>{t("ホルモンバランスを整えることを助ける", "Help bring hormones into balance")}</li></ul></div></article><article data-screen-label={t("アンガマルダナ", "Angamardana")} style="border-top:1px solid color-mix(in srgb, var(--color-antique-gold) 45%, transparent);padding:clamp(32px,4vw,56px) 0"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:clamp(24px,3.5vw,56px);align-items:start"><a href="#anga" aria-label={t("アンガマルダナの詳細へ", "Explore Angamardana in detail")} style="order:1;display:block;border-radius:10px;overflow:hidden;box-shadow:0 18px 40px -22px color-mix(in srgb, var(--color-deep-olive) 55%, transparent)"><img src="/assets/step-anga.jpg" alt={t("アンガマルダナの実践", "Practicing Angamardana")} loading="lazy" style="width:100%;height:auto;display:block" /></a><div style="order:2"><p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:15px;letter-spacing:.2em;color:var(--color-text-primary);display:flex;align-items:center;gap:12px"><span style="display:inline-block;width:28px;height:1px;background:var(--color-warm-brown)"></span>03</p><h3 style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(28px,3vw,36px);font-weight:400;color:var(--color-deep-olive)">{t("アンガマルダナ", "Angamardana")}</h3><p style="margin:10px 0 0;font-family:'Shippori Mincho',serif;font-size:18px;line-height:1.7;color:var(--color-text-primary)">{t("自分の身体を、力強くしなやかに使いこなす。", "Move with strength, flexibility, and mastery.")}</p><p style="margin:16px 0 0;font-size:15px;line-height:2;color:var(--color-text-primary);max-width:34em">{t("自分の体重と動きを使い、全身を鍛えるヨガのフィットネス・システムです。筋肉だけでなく、身体を支える骨格や腱・靱帯にも働きかけ、強さ・柔軟性・粘り強さを育みます。特別な器具を使わず、軽やかに動ける身体を目指します。", "A yogic fitness system that uses your own body weight and movement to train the whole body. It works not only with muscles but also with the skeleton, tendons, and ligaments that support you, cultivating strength, flexibility, and endurance without special equipment.")}</p><a href="#anga" style="display:inline-flex;align-items:center;min-height:44px;margin-top:10px;font-size:14px;letter-spacing:.14em;color:var(--color-text-primary);border-bottom:1px solid var(--color-warm-brown)">{t("詳しく見る →", "Learn more →")}</a></div><ul style="order:3;margin:0;padding:0 0 0 clamp(0px,2vw,28px);list-style:none;display:grid;gap:0" aria-label={t("アンガマルダナの主なメリット", "Key benefits of Angamardana")}><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-warm-brown)"></span>{t("背骨・骨格・筋肉を強くする", "Strengthen the spine, skeleton, and muscles")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-warm-brown)"></span>{t("身体の強さと粘り強さを育む", "Build physical strength and endurance")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-warm-brown)"></span>{t("柔軟性を高める", "Improve flexibility")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-warm-brown)"></span>{t("腱・靱帯など、身体を支える組織に働きかける", "Work with tendons, ligaments, and other supporting tissues")}</li></ul></div></article><article data-screen-label={t("ヨガアーサナ", "Yogasanas")} style="border-top:1px solid color-mix(in srgb, var(--color-antique-gold) 45%, transparent);padding:clamp(32px,4vw,56px) 0"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:clamp(24px,3.5vw,56px);align-items:start"><a href="#asana" aria-label={t("ヨガアーサナの詳細へ", "Explore Yogasanas in detail")} style="order:2;display:block;border-radius:10px;overflow:hidden;box-shadow:0 18px 40px -22px color-mix(in srgb, var(--color-deep-olive) 55%, transparent)"><img src="/assets/step-asana.jpg" alt={t("ヨガアーサナの実践", "Practicing Yogasanas")} loading="lazy" style="width:100%;height:auto;display:block" /></a><div style="order:1"><p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:15px;letter-spacing:.2em;color:var(--color-deep-olive);display:flex;align-items:center;gap:12px"><span style="display:inline-block;width:28px;height:1px;background:var(--color-deep-olive)"></span>04</p><h3 style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(28px,3vw,36px);font-weight:400;color:var(--color-deep-olive)">{t("ヨガアーサナ", "Yogasanas")}</h3><p style="margin:10px 0 0;font-family:'Shippori Mincho',serif;font-size:18px;line-height:1.7;color:var(--color-text-primary)">{t("身体を入り口に、自分の内側にある可能性をひらく。", "Use the body as a doorway to your inner possibilities.")}</p><p style="margin:16px 0 0;font-size:15px;line-height:2;color:var(--color-text-primary);max-width:34em">{t("古典的なヨガの姿勢を通して、身体・心・エネルギーを整え、自分の内側を探求する実践です。一つひとつの姿勢に意識的に取り組むことで、思考や感情、人生の感じ方に働きかけます。心身の健やかさから、意識のさらなる可能性へと向かうハタヨガです。", "A practice of inner exploration that brings balance to body, mind, and energy through classical yogic postures. Working consciously with each posture influences your thoughts, emotions, and experience of life. This is Hatha Yoga that leads from well-being toward further possibilities of consciousness.")}</p><a href="#asana" style="display:inline-flex;align-items:center;min-height:44px;margin-top:10px;font-size:14px;letter-spacing:.14em;color:var(--color-text-primary);border-bottom:1px solid var(--color-deep-olive)">{t("詳しく見る →", "Learn more →")}</a></div><ul style="order:3;margin:0;padding:0 0 0 clamp(0px,2vw,28px);list-style:none;display:grid;gap:0" aria-label={t("ヨガアーサナの主なメリット", "Key benefits of Yogasanas")}><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-deep-olive)"></span>{t("意識を高め、内面の探求を深める", "Heighten awareness and deepen inner exploration")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-deep-olive)"></span>{t("考え方や感じ方、人生の経験を豊かにする", "Enrich how you think, feel, and experience life")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-deep-olive)"></span>{t("身体・心・エネルギーに安定をもたらす", "Bring stability to body, mind, and energy")}</li><li style="display:flex;gap:12px;padding:12px 0;border-bottom:1px solid color-mix(in srgb, var(--color-warm-brown) 18%, transparent);font-size:15px;line-height:1.7;color:var(--color-text-primary)"><span aria-hidden="true" style="flex:none;width:6px;height:6px;margin-top:.8em;border-radius:50% 0;background:var(--color-deep-olive)"></span>{t("内側からの喜びや充足感を育む", "Cultivate joy and fulfillment from within")}</li></ul></div></article></div></section><section id="upa" class="scroll-mt-24" style="position:relative;overflow:hidden;background:linear-gradient(160deg,var(--color-ivory-cream),var(--color-ivory-cream) 80%)" data-screen-label={t("ウパヨガ", "Upa Yoga")}><div style="position:relative;max-width:1152px;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(20px,4vw,40px)"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(36px,5vw,72px)"><div style="align-self:start;position:relative;z-index:0;order:1"><div style="border-radius:10px;overflow:hidden;box-shadow:0 24px 50px -28px color-mix(in srgb, var(--color-deep-olive) 60%, transparent)"><img src="/assets/step-upa.jpg" alt={t("ウパヨガ", "Upa Yoga")} loading="lazy" style="width:100%;height:auto;display:block" /></div></div><div style="order:2"><p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;color:undefined">01 / 04</p><h2 style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(34px,4.4vw,48px);font-weight:400;line-height:1.3;color:var(--color-deep-olive)">{t("ウパヨガ", "Upa Yoga")}</h2><p style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(19px,2.2vw,23px);line-height:1.7;color:var(--color-text-primary)">{t("身体を目覚めさせ、ヨガの土台をつくる。", "Awaken the body and build a foundation for yoga.")}</p><div style="margin-top:28px;display:grid;gap:20px;font-size:16px;line-height:2.05;color:var(--color-text-primary)"><p style="margin:0">{t("ウパヨガは、関節・筋肉・エネルギーシステムに働きかける、10のシンプルな実践です。身体の仕組みに対する緻密な理解をもとに構成され、疲れやこわばりをやわらげながら、全身に心地よさと活力をもたらします。", "Upa Yoga consists of ten simple practices that work with the joints, muscles, and energy system. Based on a precise understanding of how the body works, they ease fatigue and stiffness while bringing comfort and vitality throughout the body.")}</p><p style="margin:0">{t("ヨガでは、身体の内側にはエネルギーが流れる通り道があり、関節はその通り道が交わる場所と捉えられています。ウパヨガは、関節を動かし、筋肉に働きかけることで、この内側のエネルギーを活性化していきます。身体の動きがなめらかになるとともに、すっきりと目覚めるような感覚を育む実践です。", "In the yogic tradition, energy is understood to flow through pathways within the body, and joints are places where these pathways meet. By moving the joints and working with the muscles, Upa Yoga activates this inner energy. It supports smoother movement and a sense of freshness and awakening.")}</p><p style="margin:0">{t("「ウパヨガ」には、ヨガへの準備という意味があります。初めてヨガに触れる方にも取り組みやすく、さらに深い実践へ進むための基礎にもなります。日常の疲れを整えたいときや、長時間身体を動かさなかった後、旅先で身体の調子を整えたいときにも役立ちます。", "Upa Yoga means preparation for yoga. Accessible to people trying yoga for the first time, it also provides a foundation for deeper practice. It can help you recover from everyday fatigue, awaken the body after long periods of inactivity, and stay comfortable while traveling.")}</p></div></div></div><div style="margin-top:clamp(40px,5vw,64px)"><h3 style="margin:0;font-family:'Shippori Mincho',serif;font-size:21px;font-weight:400;color:var(--color-text-primary);padding-bottom:14px;border-bottom:1px solid var(--color-antique-gold)">{t("実践を通して期待できること", "What practice can support")}</h3><ul style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));column-gap:clamp(28px,5vw,72px)"><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("身体の疲れや緊張をやわらげる", "Ease physical fatigue and tension")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("身体にかかるストレスを軽減し、全身の心地よさを取り戻す助けになります。", "Helps reduce physical stress and restore a sense of comfort throughout the body.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("関節と筋肉を強くする", "Strengthen the joints and muscles")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("関節の動きをなめらかにし、身体を支える筋肉に働きかけます。", "Encourages smooth joint movement and works with the muscles that support the body.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("動かしていなかった身体に活力を取り戻す", "Restore vitality to an inactive body")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("長く座っていた後など、活動が少なかった身体を目覚めさせます。", "Awakens the body after periods of inactivity, such as sitting for a long time.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("長旅や時差ボケによる負担をやわらげる", "Ease the strain of long journeys and jet lag")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("移動による疲れや、時差に伴う不調を整える助けになります。", "Helps ease travel fatigue and discomfort associated with changing time zones.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("感覚の冴えと、生き生きとした活力を育む", "Cultivate alertness and vibrant vitality")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("身体の内側のエネルギーに働きかけ、すっきりとした状態へと導きます。", "Works with the body's inner energy to bring a sense of freshness.")}</p></li></ul></div></div></section><section id="surya" class="scroll-mt-24" style="position:relative;overflow:hidden;background:linear-gradient(200deg,var(--color-surface-sand),var(--color-surface-sand) 70%)" data-screen-label={t("スーリヤ・クリヤ", "Surya Kriya")}><div style="position:relative;max-width:1152px;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(20px,4vw,40px)"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(36px,5vw,72px)"><div style="align-self:start;position:relative;z-index:0;order:2"><div style="border-radius:10px;overflow:hidden;box-shadow:0 24px 50px -28px color-mix(in srgb, var(--color-deep-olive) 60%, transparent)"><img src="/assets/step-surya.jpg" alt={t("スーリヤ・クリヤ", "Surya Kriya")} loading="lazy" style="width:100%;height:auto;display:block" /></div></div><div style="order:1"><p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;color:undefined">02 / 04</p><h2 style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(34px,4.4vw,48px);font-weight:400;line-height:1.3;color:var(--color-deep-olive)">{t("スーリヤ・クリヤ", "Surya Kriya")}</h2><p style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(19px,2.2vw,23px);line-height:1.7;color:var(--color-text-primary)">{t("内なる活力を高め、心に静けさを育む。", "Increase inner vitality and cultivate a quiet mind.")}</p><div style="margin-top:28px;display:grid;gap:20px;font-size:16px;line-height:2.05;color:var(--color-text-primary)"><p style="margin:0">{t("スーリヤ・クリヤは、古くから受け継がれてきた、21のステップから成るヨガの実践です。身体の健康、心の安定、内面の充実を総合的に育むプロセスとして体系化されています。", "Surya Kriya is an ancient yogic practice comprising 21 steps. It is a systematic process designed to nurture physical health, mental stability, and inner well-being together.")}</p><p style="margin:0">{t("「スーリヤ」は太陽、「クリヤ」は内なるエネルギーに働きかけるプロセスを意味します。ヨガの伝統では、スーリヤ・クリヤは、みぞおち付近の太陽神経叢に働きかけ、内側の「太陽の熱」と呼ばれるエネルギーを高める実践とされています。", "Surya means sun, and kriya means a process that works with inner energy. In the yogic tradition, Surya Kriya is understood to activate the solar plexus near the upper abdomen and increase the energy described as the inner solar heat.")}</p><p style="margin:0">{t("同時に、身体の左右を流れるエネルギーの通り道を整え、身体に安定を、心に静けさを育みます。活力と落ち着きの両方を養うことが、スーリヤ・クリヤの大きな特徴です。", "At the same time, it balances the energy pathways flowing on the left and right sides of the body, cultivating physical stability and mental stillness. Developing both vitality and calm is a defining quality of Surya Kriya.")}</p><p style="margin:0">{t("かつては限られたヨガ修行者に伝えられていたこの実践を、サドグルは、忙しい現代の暮らしにも取り入れられる包括的なヨガとして伝えています。身体の姿勢を精緻に整えながら、日々の健やかさから、より深い瞑想や内面の探求へとつなげていきます。", "Once shared only with a limited circle of yogic practitioners, Surya Kriya is now offered by Sadhguru as a comprehensive form of yoga that fits into busy modern lives. Through precise alignment of the body's postures, it connects everyday well-being with deeper meditation and inner exploration.")}</p></div></div></div><div style="margin-top:clamp(40px,5vw,64px)"><h3 style="margin:0;font-family:'Shippori Mincho',serif;font-size:21px;font-weight:400;color:var(--color-text-primary);padding-bottom:14px;border-bottom:1px solid var(--color-antique-gold)">{t("実践を通して期待できること", "What practice can support")}</h3><ul style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));column-gap:clamp(28px,5vw,72px)"><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("思考を明晰にし、集中力を高める", "Sharpen clarity and concentration")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("頭の中をすっきりと整え、目の前のことに意識を向ける力を育みます。", "Clears the mind and cultivates the ability to focus on what is in front of you.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("身体の弱さを補い、健やかな基礎を育む", "Address physical weakness and build a healthy foundation")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("体力に乏しい状態を整え、身体の土台を支えます。", "Addresses low physical strength and supports the body's foundation.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("活力とエネルギーを高める", "Increase vitality and energy")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("日々を生き生きと過ごすための力を養います。", "Develops the vitality to move through each day with energy.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("ホルモンバランスを整えることを助ける", "Help bring hormones into balance")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("身体の内側のバランスに働きかけ、健やかな状態を支えます。", "Works with the body's inner balance to support well-being.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("身体の安定と心の静けさを育む", "Cultivate physical stability and mental stillness")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("左右のエネルギーの流れを整え、落ち着いた内面の土台をつくります。", "Balances the flow of energy on both sides of the body, creating a foundation of inner calm.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("より深い瞑想への準備を整える", "Prepare for deeper meditation")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("身体と心を整え、内側に意識を向ける実践を深めていきます。", "Brings body and mind into balance and deepens the practice of turning awareness inward.")}</p></li></ul></div></div></section><section id="anga" class="scroll-mt-24" style="position:relative;overflow:hidden;background:linear-gradient(160deg,var(--color-ivory-cream),var(--color-ivory-cream) 80%)" data-screen-label={t("アンガマルダナ", "Angamardana")}><div style="position:relative;max-width:1152px;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(20px,4vw,40px)"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(36px,5vw,72px)"><div style="align-self:start;position:relative;z-index:0;order:1"><div style="border-radius:10px;overflow:hidden;box-shadow:0 24px 50px -28px color-mix(in srgb, var(--color-deep-olive) 60%, transparent)"><img src="/assets/step-anga.jpg" alt={t("アンガマルダナ", "Angamardana")} loading="lazy" style="width:100%;height:auto;display:block" /></div></div><div style="order:2"><p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;color:undefined">03 / 04</p><h2 style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(34px,4.4vw,48px);font-weight:400;line-height:1.3;color:var(--color-deep-olive)">{t("アンガマルダナ", "Angamardana")}</h2><p style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(19px,2.2vw,23px);line-height:1.7;color:var(--color-text-primary)">{t("自分の身体を、力強くしなやかに使いこなす。", "Move with strength, flexibility, and mastery.")}</p><div style="margin-top:28px;display:grid;gap:20px;font-size:16px;line-height:2.05;color:var(--color-text-primary)"><p style="margin:0">{t("アンガマルダナは、ヨガに根ざした31のダイナミックなプロセスから成る、全身のフィットネス・システムです。自分の体重と動きを使い、身体の強さ、柔軟性、粘り強さを育んでいきます。", "Angamardana is a whole-body fitness system rooted in yoga and comprising 31 dynamic processes. Using your own body weight and movement, it develops physical strength, flexibility, and endurance.")}</p><p style="margin:0">{t("「アンガマルダナ」とは、手足や身体の各部を自在に使いこなすことを意味します。その名前が示すように、筋肉・骨格・循環器系・神経系、そしてヨガでいうエネルギーシステムまで、身体全体に働きかける実践です。", "Angamardana means gaining mastery over the limbs and different parts of the body. As its name suggests, the practice works with the whole body: muscles, skeleton, circulatory and nervous systems, and what yoga calls the energy system.")}</p><p style="margin:0">{t("特徴の一つは、筋肉に加えて、骨格と筋肉をつなぐ腱・靱帯など、身体を支える組織にも働きかけること。身体の土台を鍛えることで、力強さとしなやかさを兼ね備えた、自由に動ける身体を目指します。", "One distinctive feature is its work not only with muscles but also with the tendons, ligaments, and other tissues that support and connect the body's structure. By strengthening this foundation, it aims to develop a body that moves freely with both power and flexibility.")}</p><p style="margin:0">{t("必要なのは、自分の身体と動けるスペースだけ。特別な器具を使わないため、自宅でも旅先でも実践できます。身体に活力と軽やかさを取り戻し、ハタヨガや内面的な探求を深めていくための準備にもなるプログラムです。", "All you need is your body and enough space to move. With no special equipment required, you can practice at home or while traveling. The program restores vitality and lightness while preparing you for deeper Hatha Yoga and inner exploration.")}</p></div></div></div><div style="margin-top:clamp(40px,5vw,64px)"><h3 style="margin:0;font-family:'Shippori Mincho',serif;font-size:21px;font-weight:400;color:var(--color-text-primary);padding-bottom:14px;border-bottom:1px solid var(--color-antique-gold)">{t("実践を通して期待できること", "What practice can support")}</h3><ul style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));column-gap:clamp(28px,5vw,72px)"><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("背骨・骨格・筋肉を強くする", "Strengthen the spine, skeleton, and muscles")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("全身を使った動きを通して、身体を支える基礎を鍛えます。", "Uses whole-body movements to strengthen the foundations that support you.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("身体の強さと粘り強さを育む", "Build physical strength and endurance")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("体力を高め、力強く動ける身体をつくります。", "Builds stamina and a body capable of moving with strength.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("柔軟性を高める", "Improve flexibility")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("自分の体重と動きを生かし、筋肉のしなやかさを養います。", "Uses your own body weight and movement to develop supple muscles.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("腱・靱帯など、身体を支える組織に働きかける", "Work with tendons, ligaments, and other supporting tissues")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("身体の構造を支える部分を鍛え、安定した強さを育みます。", "Strengthens the body's supporting structures to cultivate stable strength.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("身体に軽やかさと自由な感覚をもたらす", "Bring a sense of lightness and freedom to the body")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("活力を取り戻し、生き生きと身体を使える状態を目指します。", "Aims to restore vitality and an energetic, responsive body.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("筋力の向上と体脂肪の減少を助ける", "Support muscle development and body-fat reduction")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("身体全体を鍛える実践に伴う、副次的なメリットです。", "These are secondary benefits of a practice that trains the whole body.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("より深いハタヨガへの準備を整える", "Prepare for deeper Hatha Yoga")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("身体とエネルギーの土台を養い、次の実践へつなげていきます。", "Develops a foundation of body and energy for your next stage of practice.")}</p></li></ul></div></div></section><section id="asana" class="scroll-mt-24" style="position:relative;overflow:hidden;background:linear-gradient(200deg,var(--color-surface-sand),var(--color-surface-sand) 70%)" data-screen-label={t("ヨガアーサナ", "Yogasanas")}><div style="position:relative;max-width:1152px;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(20px,4vw,40px)"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(36px,5vw,72px)"><div style="align-self:start;position:relative;z-index:0;order:2"><div style="border-radius:10px;overflow:hidden;box-shadow:0 24px 50px -28px color-mix(in srgb, var(--color-deep-olive) 60%, transparent)"><img src="/assets/step-asana.jpg" alt={t("ヨガアーサナ", "Yogasanas")} loading="lazy" style="width:100%;height:auto;display:block" /></div></div><div style="order:1"><p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;color:undefined">04 / 04</p><h2 style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(34px,4.4vw,48px);font-weight:400;line-height:1.3;color:var(--color-deep-olive)">{t("ヨガアーサナ", "Yogasanas")}</h2><p style="margin:14px 0 0;font-family:'Shippori Mincho',serif;font-size:clamp(19px,2.2vw,23px);line-height:1.7;color:var(--color-text-primary)">{t("身体を入り口に、自分の内側にある可能性をひらく。", "Use the body as a doorway to your inner possibilities.")}</p><div style="margin-top:28px;display:grid;gap:20px;font-size:16px;line-height:2.05;color:var(--color-text-primary)"><p style="margin:0">{t("ヨガアーサナは、身体の姿勢を通して、意識を高めていく古典ハタヨガの実践です。身体を健やかに整えるとともに、思考や感情、そして人生をどのように経験するかという、自分自身の深い部分に働きかけます。", "Yogasanas are a classical Hatha Yoga practice that heightens awareness through physical postures. Alongside supporting physical well-being, the practice works with deeper aspects of yourself: your thoughts, emotions, and the way you experience life.")}</p><p style="margin:0">{t("「アーサナ」とは、姿勢を意味します。身体がとることのできる無数の姿勢の中で、心身の可能性をひらく84の姿勢が「ヨガアーサナ」として見いだされてきました。この伝統に基づき、36の姿勢から成る体系が、より高い次元のエネルギーを受け止められる身体と心を育むために伝えられています。", "Asana means posture. Among the countless positions the body can take, 84 postures that open the possibilities of body and mind have been identified as yogasanas. Based on this tradition, a system of 36 postures is taught to develop a body and mind capable of receiving higher dimensions of energy.")}</p><p style="margin:0">{t("一つひとつの姿勢を意識的につくり、保つことには、形を整える以上の意味があります。ヨガの観点では、身体の姿勢は内側のエネルギーの流れと深く結びついています。その流れに丁寧に働きかけることで、身体・心・エネルギーの調和を育み、意識を深めるための土台をつくります。", "Consciously creating and holding each posture means more than arranging the body into a shape. From a yogic perspective, physical posture is closely connected with the flow of inner energy. Working carefully with that flow cultivates harmony among body, mind, and energy, laying a foundation for deeper awareness.")}</p><p style="margin:0">{t("ヨガアーサナが目指すのは、健やかさの先にある、内面的な成長です。無意識の反応や衝動に動かされる状態から、自分の身体と心に意識を向けて生きることへ。そして、自分の内側を、より大きな生命の営みと調和させていくことへ。身体を使った実践が、自分という存在を探求する道につながっています。", "Yogasanas aim toward inner growth beyond well-being: moving from unconscious reactions and compulsions toward living with awareness of your body and mind, and bringing your inner world into harmony with the greater movement of life. A physical practice becomes a path of exploring who you are.")}</p><p style="margin:0">{t("始めるにあたって、特別な柔軟性やヨガの経験は必要ありません。姿勢を通して自分自身を整えながら、健やかさ、喜び、深い充足感、そして内側のバランスが自然に育まれる状態を目指します。", "You do not need unusual flexibility or previous yoga experience to begin. By bringing yourself into balance through postures, the practice aims to create conditions in which health, joy, deep fulfillment, and inner balance can naturally grow.")}</p></div></div></div><div style="margin-top:clamp(40px,5vw,64px)"><h3 style="margin:0;font-family:'Shippori Mincho',serif;font-size:21px;font-weight:400;color:var(--color-text-primary);padding-bottom:14px;border-bottom:1px solid var(--color-antique-gold)">{t("実践を通して期待できること", "What practice can support")}</h3><ul style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));column-gap:clamp(28px,5vw,72px)"><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("意識を高め、内面の探求を深める", "Heighten awareness and deepen inner exploration")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("姿勢を通してエネルギーの流れに働きかけ、自分自身の可能性をひらいていきます。", "Works with the flow of energy through posture, opening your own possibilities.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("考え方や感じ方、人生の経験を豊かにする", "Enrich how you think, feel, and experience life")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("身体と心への意識を深め、より意識的に生きるための土台を育みます。", "Deepens awareness of body and mind and builds a foundation for more conscious living.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("身体・心・エネルギーに安定をもたらす", "Bring stability to body, mind, and energy")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("自分の内側のバランスを整え、さらに深い実践への準備をします。", "Balances your inner world and prepares you for deeper practice.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("内側からの喜びや充足感を育む", "Cultivate joy and fulfillment from within")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("心身の調和を通して、穏やかな喜びや満ち足りた感覚が自然に生まれる状態を目指します。", "Aims to create conditions in which peaceful joy and fulfillment arise naturally through harmony of body and mind.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("慢性的な健康上の不調の緩和を助ける", "Help ease chronic health difficulties")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("身体と心を整える実践を通して、健やかな状態を支えます。", "Supports well-being through a practice that brings body and mind into balance.")}</p></li><li style="position:relative;padding:18px 0 18px 26px;border-bottom:1px solid color-mix(in srgb, var(--color-sage) 30%, transparent)"><span aria-hidden="true" style="position:absolute;left:2px;top:30px;width:9px;height:9px;border-radius:50% 0;background:var(--color-sage)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:18px;color:var(--color-text-primary)">{t("加齢に伴う変化を穏やかにする", "Soften the effects of aging")}</p><p style="margin:6px 0 0;font-size:15px;line-height:1.9;color:var(--color-text-primary)">{t("年齢を重ねながらも、身体と心を健やかに保つことを目指します。", "Aims to keep body and mind healthy as you grow older.")}</p></li></ul></div></div></section>
<section style="position:relative;overflow:hidden;background:linear-gradient(180deg,var(--color-surface-sand),var(--color-warm-beige));text-align:center" data-screen-label="CTA"><div aria-hidden="true" style="position:absolute;pointer-events:none;top:-120px;left:50%;margin-left:-300px;width:600px;height:360px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-paper) 80%, transparent),transparent 70%)"></div><div style="position:relative;max-width:800px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(24px,4vw,40px)"><span aria-hidden="true" style="display:block;width:56px;height:2px;margin:0 auto 28px;background:var(--color-antique-gold)"></span><p style="margin:0;font-family:'Shippori Mincho',serif;font-size:clamp(28px,4vw,44px);line-height:1.5;color:var(--color-deep-olive)">{t("まずは一度、体験してみませんか。", "Why not experience a class for yourself?")}</p><p style="margin:20px 0 0;font-size:16px;line-height:2;color:var(--color-text-primary)">{t("通常のクラスをそのまま体験していただけます。", "Try one of our regular classes just as it is.")}</p><div style="margin-top:36px;display:flex;flex-wrap:wrap;gap:16px;justify-content:center"><a href="https://docs.google.com/forms/d/1rKoOxcGQyew2a_d341eduWZ4QuhbK7R3YloP14Z6s8w/viewform" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 text-[14px] uppercase tracking-[0.18em] font-medium transition-colors duration-300 bg-brand-espresso text-white hover:bg-brand-moss">{t("体験レッスンを予約する", "Book a trial lesson")}</a><a href={`/hatha-yoga/${locale}/offerings/`} class="ja-btn-ghost inline-flex items-center justify-center gap-2 px-7 py-3.5 font-medium">{t("クラスを見る", "Explore classes")}</a></div></div></section>
