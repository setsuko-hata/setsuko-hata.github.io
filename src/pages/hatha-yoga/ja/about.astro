---
interface Props { locale?: 'ja' | 'en'; }
const { locale = 'ja' } = Astro.props;
const t = (ja: string, en: string) => locale === 'en' ? en : ja;

import YogaLayout from '../../../layouts/YogaLayout.astro';
---
<YogaLayout title={t("講師紹介｜秦 節子（サドグル公認ハタヨガ講師）| Setsuko Hata Yoga", "About Setsuko Hata, Sadhguru-certified Hatha Yoga Teacher | Setsuko Hata Yoga")}
  description={t("秦 節子（Setsuko Hata）のプロフィール。インドのIsha Yoga Centerで1,750時間超のトレーニングを修めたサドグル公認ハタヨガ講師として、大阪・東京を中心に伝統的なハタヨガを指導しています。", "Meet Setsuko Hata, a Sadhguru-certified Hatha Yoga teacher who completed more than 1,750 hours of training at India's Isha Yoga Center and teaches traditional Hatha Yoga primarily in Osaka and Tokyo.")}
  locale={locale}
  active="about"
>


        <section data-screen-label="Hero" style="position:relative;overflow:hidden;background:linear-gradient(150deg,var(--color-light-sage) 0%,var(--color-sand-beige) 38%,var(--color-warm-beige) 78%,var(--color-surface-sand) 100%)">
          <div aria-hidden="true" style="position:absolute;top:-180px;right:-120px;width:min(680px,86vw);height:600px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-ivory-cream) 62%, transparent) 0%,transparent 68%);pointer-events:none"></div>
          <div aria-hidden="true" style="position:absolute;left:-140px;bottom:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-gold-accent) 40%, transparent) 0%,transparent 70%);pointer-events:none"></div>
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10" style="position:relative">
            <div class="ja-hero-split">
              <div>
                <p class="font-mono uppercase tracking-[0.24em]" style="color:var(--color-text-primary)">Instructor</p>
                <h1 class="mt-6 font-display text-3xl leading-[1.3] md:text-5xl md:leading-[1.2]" style="color:var(--color-text-primary)">{t("秦 節子｜Setsuko Hata", "Setsuko Hata")}</h1>
                <p class="mt-5 font-display text-xl leading-snug md:text-2xl" style="color:var(--color-text-primary)">{t("サドグル公認ハタヨガ講師", "Sadhguru-certified Hatha Yoga teacher")}</p>
                <p class="mt-8 max-w-xl text-base leading-loose" style="color:var(--color-text-primary)">{t("インドのIsha Yoga Centerで1,750時間超のトレーニングを修め、日本ではわずか数名のサドグル公認ハタヨガ講師として、大阪・東京を中心に伝統的なハタヨガをお伝えしています。", "After more than 1,750 hours of training at the Isha Yoga Center in India, I now share traditional Hatha Yoga, primarily in Osaka and Tokyo, as one of only a few Sadhguru-certified Hatha Yoga teachers in Japan.")}</p>
                <div class="mt-10 flex flex-wrap gap-4">
                  <a href={`/hatha-yoga/${locale}/offerings/`} class="inline-flex items-center justify-center gap-2 px-7 py-3.5 font-medium">{t("クラスを見る", "Explore classes")}</a>
                  <a href={`/hatha-yoga/${locale}/hatha-yoga/`} class="ja-btn-ghost inline-flex items-center justify-center gap-2 px-7 py-3.5 font-medium">{t("ハタヨガとは", "What is Hatha Yoga?")}</a>
                </div>
              </div>
              <div style="position:relative;width:100%;max-width:340px;margin-inline:auto;aspect-ratio:4/5;overflow:hidden;border-radius:56% 44% 52% 48% / 48% 42% 58% 52%;border:1px solid color-mix(in srgb, var(--color-warm-brown) 55%, transparent);background:var(--color-warm-beige);box-shadow:0 34px 60px -30px color-mix(in srgb, var(--color-text-primary) 45%, transparent)">
                <picture><source type="image/webp" srcset="/hatha-yoga/assets/setsuko-about.webp" /><img src="/hatha-yoga/assets/setsuko-about.jpg" alt={t("秦 節子｜Setsuko Hata", "Setsuko Hata")} style="width:100%;height:100%;object-fit:cover;display:block" fetchpriority="high" width="816" height="698" /></picture>
              </div>
            </div>
          </div>
          <svg aria-hidden="true" viewBox="0 0 1440 140" preserveAspectRatio="none" style="position:absolute;left:0;right:0;bottom:-1px;width:100%;height:clamp(60px,8vw,110px);display:block;pointer-events:none"><path d="M0 66 C 240 22 430 116 700 96 C 980 76 1180 24 1440 58 L1440 140 L0 140 Z" fill="#F5EDDF" opacity=".5" /><path d="M0 96 C 250 58 450 130 720 110 C 1000 90 1200 46 1440 86 L1440 140 L0 140 Z" fill="#F5EDDF" /></svg>
        </section>
        <section class="scroll-mt-24" style="position:relative;background:var(--color-ivory-cream);overflow:hidden" data-screen-label={t("これまでの道", "My journey")}>
          <svg aria-hidden="true" viewBox="0 0 600 600" style="position:absolute;left:-190px;top:80px;width:min(470px,54vw);opacity:.45;pointer-events:none"><path d="M300 30 C 470 30 570 170 540 320 C 512 462 380 570 240 552 C 92 533 20 400 34 268 C 48 132 140 30 300 30 Z" fill="var(--color-warm-beige)" /></svg>
          <div class="mx-auto w-full max-w-4xl px-6 md:px-10" style="position:relative">
            <p class="font-mono uppercase tracking-[0.24em] ja-eyebrow">{t("これまでの道", "My journey")}</p>
            <h2 class="mt-6 font-display text-3xl leading-[1.3] md:text-5xl">{t("「本当の健康とは何か」を、探し続けてきました", "Searching for what it means to be truly healthy")}</h2>
            <div aria-hidden="true" style="margin-top:34px;height:1px;background:linear-gradient(90deg,color-mix(in srgb, var(--color-warm-brown) 85%, transparent) 0%,transparent 100%)"></div>
            <div class="mt-10 space-y-7 text-base leading-loose text-brand-espresso/85 ja-story">
            <figure class="ja-figure ja-fig-left" data-shape="a">
              <div class="ja-figure-inner"><img src="/hatha-yoga/assets/forest-nature.jpg" alt={t("森の岩に座る秦節子", "Setsuko Hata sitting on a rock in the forest")} loading="lazy" width="900" height="1125" /></div>
              <figcaption class="font-mono">{t("森のなかで — 問いのはじまり", "In the forest: where the questions began")}</figcaption>
            </figure>
            <p>{t("私は幼い頃から好奇心旺盛で、新しいことに挑戦することが大好きな性格でした。特に歌うことが好きで、一度夢中になると納得するまでとことん追求し、何事にも全力で取り組むタイプでした。", "As a child, I was full of curiosity and loved trying new things. I especially loved singing. Once something captured my imagination, I pursued it until I was satisfied, giving everything my full effort.")}</p>
<p>{t("しかし、その真面目さや頑張りすぎる気質から、自分の限界を超えて無理を重ねる生活が続き、心身のバランスを崩してしまいました。21歳の頃、自律神経の不調をきっかけにうつ病と躁病を発症し、大学を3年間休学。入院を含む闘病生活を送りました。", "But my earnestness and tendency to push too hard led me to repeatedly exceed my limits, until my body and mind fell out of balance. Around the age of 21, problems with my autonomic nervous system were followed by depression and mania. I took three years away from university to recover, including time in hospital.")}</p>
<p>{t("心も体も思うようにならない日々の中で、「本当の健康とは何か」「人が本来持つ生命の可能性を最大限に引き出すには、どうすればよいのか」——その問いを、私はずっと探し続けてきました。", "During those days when neither my mind nor my body would respond as I wished, I kept asking: What is true health? How can we bring out the fullest possibilities of the life within us? These questions have stayed with me ever since.")}</p>
<p>{t("やがて回復し、大学へ復学。2011年に大阪市立大学生活科学部食品栄養学科を卒業しました。その後、幼き頃からの夢だったプロの歌手になるためにアメリカへ渡り、ニューヨーク市立大学(CUNY)と北コロラド大学大学院で本格的にジャズボーカルと作曲を専攻。13年間、アメリカでプロのジャズシンガー・作曲家として活動してきました。", "Eventually, I recovered and returned to university, graduating in 2011 from the Department of Food and Human Nutrition in the Faculty of Human Life Science at Osaka City University. I then moved to the United States to pursue my childhood dream of becoming a professional singer, studying jazz voice and composition at the City University of New York (CUNY) and in graduate school at the University of Northern Colorado. I spent 13 years working in America as a professional jazz singer and composer.")}</p>
<p>{t("音楽活動を続けながらも、あの問いは私の中に生き続けていました。心身を深く癒し、本当の健康を取り戻したい。そしてその先で、生命そのものの可能性をどこまで切り開いていけるのか——その答えを求めて、私はさまざまな道を探求してきました。", "Even as I continued my musical career, those questions remained alive within me. I wanted to deeply heal my body and mind and recover true health. Beyond that, how far could I explore the possibilities of life itself? In search of an answer, I explored many different paths.")}</p>
<p>{t("仏教哲学に学び実践し、ヨガやピラティス、ジャイロトニック、セラピー、ハーブ療法、エネルギーヒーリング、潜在意識のリプログラミングなど、心と体、そして意識に働きかけるあらゆる方法を、自分自身で試し続けてきたのです。どれもそれなりの効果はありましたが、生命そのものが根本から変わるという実感には、まだ至りませんでした。", "I studied and practiced Buddhist philosophy, and personally tried many approaches to the body, mind, and consciousness: yoga, Pilates, Gyrotonic, therapy, herbal remedies, energy healing, and subconscious reprogramming. Each helped in its own way, but I had yet to experience a fundamental transformation of life itself.")}</p>
<figure class="ja-figure ja-fig-right" data-shape="b">
              <div class="ja-figure-inner"><img src="/hatha-yoga/assets/isha-meditation.jpg" alt={t("アディヨギ像の前で瞑想する秦節子", "Setsuko Hata meditating before the Adiyogi statue")} loading="lazy" width="900" height="1125" /></div>
              <figcaption class="font-mono">{t("南インド、アディヨギ像の前で", "Before the Adiyogi statue in southern India")}</figcaption>
            </figure>
<p>{t("そんなある日、YouTubeで世界的なヨギ・サドグルの動画に出会います。何気なく試したサドグルの瞑想がもたらす心身への効果があまりに素晴らしく、そこからロサンゼルスでサドグルのプログラム「インナーエンジニアリング」やハタヨガを受講。実践を重ねるうちに、自分の生命が驚くほど健やかに変わっていくことを実感しました。", "One day, I came across a YouTube video by the internationally known yogi Sadhguru. I casually tried one of his meditations and was astonished by its effects on my body and mind. This led me to take his Inner Engineering program and Hatha Yoga classes in Los Angeles. As I continued practicing, I felt my life becoming remarkably healthier.")}</p>
<p>{t("これまでの人生にないほどの深い経験でした。この生命の可能性をもっと追求したい——その思いが強くなり、ヨガと瞑想の修行のためインドへ渡ることを決意します。", "It was a deeper experience than anything I had known before. My desire to explore these possibilities of life grew, and I decided to travel to India to immerse myself in yoga and meditation.")}</p>
<p>{t("2024年、サドグルによって設立された南インドのIsha Yoga Centerへ渡り、約1年半にわたりアシュラムで生活しながらヨガと瞑想を学び、本場インドでも最も厳格なヨガ教師養成プログラムの一つといわれるハタヨガ教師養成コースを修了しました。1,750時間以上に及ぶ専門的なハタヨガ講師トレーニングを積み、サドグル公認ハタヨガ講師の資格を取得しました。", "In 2024, I traveled to the Isha Yoga Center in southern India, founded by Sadhguru. I lived at the ashram for about a year and a half, studying yoga and meditation, and completed a Hatha Yoga teacher training course regarded as one of the most rigorous even in India. After more than 1,750 hours of specialized training, I qualified as a Sadhguru-certified Hatha Yoga teacher.")}</p>
<p>{t("現在、日本ではわずか4名のサドグル公認ハタヨガ講師の一人として、本場インドで受け継がれてきた伝統的なハタヨガを、大阪・東京を中心にお伝えしています。", "Today, as one of only four Sadhguru-certified Hatha Yoga teachers in Japan, I share the traditional Hatha Yoga passed down in India, primarily in Osaka and Tokyo.")}</p></div>
          </div>
        </section>
        <section class="scroll-mt-24" style="position:relative;background:var(--color-warm-beige);overflow:hidden" data-screen-label={t("ヨガの力", "The power of yoga")}>
          <div aria-hidden="true" style="position:absolute;right:-150px;top:-110px;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-light-sage) 50%, transparent) 0%,transparent 70%);pointer-events:none"></div>
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10" style="position:relative">
            <div class="grid items-start gap-14 md:grid-cols-[1fr_1.25fr] md:gap-20">
              <div class="md:sticky md:top-28">
                <div class="relative aspect-[2/3] overflow-hidden" style="border-radius:6px;border:1px solid color-mix(in srgb, var(--color-warm-brown) 50%, transparent);box-shadow:0 30px 54px -30px color-mix(in srgb, var(--color-text-primary) 42%, transparent)">
                  <picture>
                    <source type="image/webp" media="(max-width: 900px)" srcset="/hatha-yoga/assets/practice-700.webp" />
                    <source type="image/webp" srcset="/hatha-yoga/assets/practice.webp" />
                    <source type="image/jpeg" media="(max-width: 900px)" srcset="/hatha-yoga/assets/practice-700.jpg" />
                    <img src="/hatha-yoga/assets/practice.jpg" alt={t("芝生の上でヨガを実践する秦節子", "Setsuko Hata practicing yoga on the grass")} loading="lazy" width="832" height="1248" class="h-full w-full object-cover" />
                  </picture>
                </div>
              </div>
              <div>
                <p class="font-mono uppercase tracking-[0.24em] ja-eyebrow">{t("実践がもたらしたもの", "What practice has brought me")}</p>
                <h2 class="mt-6 font-display text-3xl leading-[1.3] md:text-5xl">{t("私自身の人生を変えた、ヨガの力", "The power of yoga that changed my life")}</h2>
                <div aria-hidden="true" style="margin-top:28px;height:1px;width:120px;background:var(--color-soft-terracotta)"></div>
                <div class="mt-10 space-y-7 text-lg leading-loose text-brand-espresso/85"><p>{t("ハタヨガを日々実践することでまず、身体が変わりました。長年抱えていた慢性的な不調が自然と改善し、生命エネルギーが高まるにつれて驚くほど疲れにくくなりました。朝目覚めることが楽しみになり、一日一日を生きることそのものに喜びを感じられるようになりました。", "Daily Hatha Yoga practice first changed my body. Chronic difficulties I had lived with for years naturally improved, and as my life energy increased, I became surprisingly less prone to fatigue. I began looking forward to waking up in the morning and finding joy in simply living each day.")}</p>
<p>{t("身体が整うと同時に、心も大きく変化しました。以前はストレスや不安に振り回されることもありましたが、ハタヨガを継続する中で、どのような状況でも穏やかさを保てるようになり、外側の出来事に左右されることが少なくなりました。", "As my body became more balanced, my mind changed profoundly too. I had once been swept up by stress and anxiety, but through continued Hatha Yoga practice, I became able to remain peaceful in all kinds of situations and less affected by outside events.")}</p>
<p>{t("そして何より大きく変わったのは、生きることへの向き合い方です。以前の私は、成果や評価の中に幸せを求めていました。しかし今は、ただ生きていること、存在していることそのものに、深い喜びと感謝を感じられるようになりました。生命という奇跡に心から感動し、何気ない日常さえ愛おしく感じています。", "The greatest change was in how I approached life itself. I used to seek happiness in achievement and recognition. Now, simply being alive and existing brings me deep joy and gratitude. I am moved by the miracle of life, and even ordinary moments feel precious.")}</p>
<p>{t("その結果、挑戦することへの恐れもなくなりました。成功を目指して全力を尽くしますが、結果によって自分の幸せが左右されることはありません。成功しても失敗しても、自分の内側には揺るがない安らぎがある。そのような生き方を実感できるようになりました。", "As a result, I no longer fear taking on challenges. I give my best effort toward success, but my happiness no longer depends on the outcome. Whether I succeed or fail, there is a steady peace within me. I have come to experience this way of living for myself.")}</p>
<p>{t("この変化は特別な才能によるものではなく、本格的なハタヨガの実践を通して、身体・心・生命エネルギーが本来の調和を取り戻した結果だと感じています。", "I feel that this change is not a matter of special talent. Through classical Hatha Yoga practice, my body, mind, and life energy have returned to their natural harmony.")}</p>
<p>{t("私自身の人生が根本から変わったからこそ、この素晴らしいヨガ科学を一人でも多くの方へ届けたいという思いで、ハタヨガ講師の道を選びました。", "Because my own life has changed so fundamentally, I chose to become a Hatha Yoga teacher so that I could share this remarkable yogic science with as many people as possible.")}</p></div>
              </div>
            </div>
          </div>
        </section>
        <section class="relative isolate overflow-hidden ja-band ja-band-sage" data-lt="1">
          <img src="/hatha-yoga/assets/photos/mountain-sunrays-web.jpg" alt={t("朝の光が差し込む山並み", "Morning light falling across the mountains")} loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" />
          <div aria-hidden="true" class="absolute inset-0 -z-10" style="background:color-mix(in srgb, var(--color-ivory-cream) 74%, transparent)"></div>
          <div aria-hidden="true" class="absolute inset-0 -z-10" style="background:linear-gradient(to top,color-mix(in srgb, var(--color-ivory-cream) 50%, transparent) 0%,color-mix(in srgb, var(--color-ivory-cream) 20%, transparent) 50%,color-mix(in srgb, var(--color-ivory-cream) 50%, transparent) 100%)"></div>
          <div class="mx-auto w-full max-w-3xl px-6 md:px-10 py-32 text-center md:py-44">
            <p class="font-display text-2xl leading-[1.5] md:text-4xl md:leading-[1.45]" style="color:var(--color-text-primary) !important">{t("一人ひとりが心身ともに健やかに、自分らしく生きることのできる社会を育んでいくこと。それが、私の願いであり、人生の使命です。", "To help nurture a society in which everyone can live with a healthy body and mind, true to themselves: this is my wish and my life's purpose.")}</p>
            <div class="mx-auto mt-10 flex justify-center" aria-hidden="true"><span class="h-px w-16" style="background:var(--color-antique-gold)"></span></div>
            <p class="mt-10 font-display text-xl md:text-2xl" style="color:var(--color-deep-olive) !important">{t("秦節子", "Setsuko Hata")}</p>
          </div>
        </section>

        <section class="scroll-mt-24" style="position:relative;background:linear-gradient(155deg,var(--color-surface-sand) 0%,var(--color-warm-beige) 48%,var(--color-warm-beige) 100%);overflow:hidden" data-screen-label={t("お問い合わせ", "Contact")}>
          <div aria-hidden="true" style="position:absolute;right:-140px;top:-140px;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-gold-accent) 38%, transparent) 0%,transparent 70%);pointer-events:none"></div>
          <div aria-hidden="true" style="position:absolute;left:-120px;bottom:-160px;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-sage) 30%, transparent) 0%,transparent 70%);pointer-events:none"></div>
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10" style="position:relative">
            <p class="font-mono uppercase tracking-[0.24em] ja-eyebrow">{t("お問い合わせ", "Contact")}</p>
            <h2 class="mt-6 max-w-3xl font-display text-3xl leading-[1.3] md:text-5xl" style="color:var(--color-text-primary)">{t("まずは、一度体験してみてください。", "Begin by experiencing it for yourself.")}</h2>
            <p class="mt-8 max-w-2xl text-base leading-loose" style="color:var(--color-text-primary)">{t("ヨガが初めての方も、久しぶりの方も。ご自身の身体の状態を確かめながら、ゆっくりと進めていきます。", "Whether you are new to yoga or returning after a break, we will move slowly, with attention to how your body feels.")}</p>
            <div class="mt-10 flex flex-wrap gap-4">
              <a href="https://docs.google.com/forms/d/1rKoOxcGQyew2a_d341eduWZ4QuhbK7R3YloP14Z6s8w/viewform" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 font-medium">{t("体験レッスンを予約する", "Book a trial lesson")}</a>
              <a href={`/hatha-yoga/${locale}/contact/`} class="ja-btn-ghost inline-flex items-center justify-center gap-2 px-7 py-3.5 font-medium">{t("お問い合わせ", "Contact")}</a>
            </div>
          </div>
        </section>
</YogaLayout>
