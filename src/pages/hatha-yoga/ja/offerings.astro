---
import YogaLayout from '../../../layouts/YogaLayout.astro';
import '../../../styles/yoga/pages/offerings.css';
import '../../../styles/yoga/calendar.css';

const plans = [
  { no: '①', name: '対面のみ', price: '7,000', online: null },
  { no: '②', name: '対面＋オンライン2回', price: '10,000', online: '月2回' },
  { no: '③', name: '対面＋オンライン4回', price: '13,000', online: '月4回' },
];
const mondaySessions = [
  { time: '19:30〜20:10', name: '健康セミナー', length: '40分' },
  { time: '20:20〜21:00', name: '瞑想', length: '40分' },
];
const inPersonRates = [
  { format: 'グループ対面', price: '4,000' },
  { format: 'セミプライベート対面', price: '6,000' },
  { format: 'プライベート対面', price: '12,000' },
];
---
<YogaLayout title="クラス・月額会員 | Setsuko Hata Yoga"
  description="単発参加と月額会員の比較、対面クラス・オンラインクラス・特別プログラム・大阪限定会員・SATORIN メンバーシップのご案内。"
  locale="ja"
  active="classes"
  bodyClass="page-offerings"
>
        <section data-screen-label="Hero" style="position:relative;overflow:hidden;background:linear-gradient(150deg,var(--color-light-sage) 0%,var(--color-sand-beige) 38%,var(--color-warm-beige) 78%,var(--color-surface-sand) 100%)">
          <div aria-hidden="true" style="position:absolute;top:-180px;right:-120px;width:min(680px,86vw);height:600px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-ivory-cream) 62%, transparent) 0%,transparent 68%);pointer-events:none"></div>
          <div aria-hidden="true" style="position:absolute;left:-140px;bottom:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb, var(--color-soft-terracotta) 34%, transparent) 0%,transparent 70%);pointer-events:none"></div>
          <svg aria-hidden="true" viewBox="0 0 600 600" style="position:absolute;right:6%;top:8%;width:min(360px,40vw);opacity:.5;pointer-events:none"><circle cx="300" cy="300" r="240" fill="none" stroke="#8A6043" stroke-opacity=".45" /><circle cx="300" cy="300" r="180" fill="none" stroke="#8A6043" stroke-opacity=".28" /></svg>
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10 ja-hero-grid" style="position:relative">
            <div>
            <p class="font-mono uppercase tracking-[0.24em]" style="color:#5C4A2E">Classes &amp; Membership</p>
            <h1 class="mt-6 max-w-3xl font-display text-3xl leading-[1.3] md:text-5xl md:leading-[1.2]" style="color:#33301F">クラス・月額会員</h1>
            <p class="mt-8 max-w-2xl text-base leading-loose" style="color:#443F2C">対面クラス、オンラインクラス、特別プログラム。単発参加と月額会員、どちらもお選びいただけます。</p>
            <div class="mt-10 flex flex-wrap gap-4">
              <a href="#trial" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 font-medium">初めての方へ</a>
              <a href="#pricing" class="ja-btn-ghost inline-flex items-center justify-center gap-2 px-7 py-3.5 font-medium">クラス価格</a>
            </div>
            </div>
            <div class="ja-hero-blob" aria-hidden="false">
              <img src="/hatha-yoga/assets/gallery/meditation-1400.jpg" alt="瞑想クラスの様子" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover" />
            </div>
          </div>
          <svg aria-hidden="true" viewBox="0 0 1440 140" preserveAspectRatio="none" style="position:absolute;left:0;right:0;bottom:-1px;width:100%;height:clamp(60px,8vw,110px);display:block;pointer-events:none"><path d="M0 66 C 240 22 430 116 700 96 C 980 76 1180 24 1440 58 L1440 140 L0 140 Z" fill="#F5EFDF" opacity=".5" /><path d="M0 96 C 250 58 450 130 720 110 C 1000 90 1200 46 1440 86 L1440 140 L0 140 Z" fill="#F5EFDF" /></svg>
        </section>
        <section class="ja-shell" style="background:#F5EFDF">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
            <div class="ja-shell-grid">
              <nav class="ja-sidenav" role="tablist" aria-label="クラスの種類">
                <button type="button" role="tab" id="tab-trial-tab" aria-controls="panel-trial-tab" aria-selected="true" data-tab="trial-tab" class="ja-navitem font-display">
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4c0 8.5-4.6 13-11 13H5.5C5.5 9.2 11 4 20 4z"/><path d="M4 21c1.8-5.4 5-9 9.5-11"/></svg>
                  <span><span class="ja-nav-label block">初めての方へ</span></span>
                  <svg class="ja-nav-caret" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                </button>
                <button type="button" role="tab" id="tab-inperson-tab" aria-controls="panel-inperson-tab" aria-selected="false" data-tab="inperson-tab" class="ja-navitem font-display">
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4c0 8.5-4.6 13-11 13H5.5C5.5 9.2 11 4 20 4z"/><path d="M4 21c1.8-5.4 5-9 9.5-11"/></svg>
                  <span><span class="ja-nav-label block">対面クラス</span></span>
                  <svg class="ja-nav-caret" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                </button>
                <button type="button" role="tab" id="tab-online-tab" aria-controls="panel-online-tab" aria-selected="false" data-tab="online-tab" class="ja-navitem font-display">
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4c0 8.5-4.6 13-11 13H5.5C5.5 9.2 11 4 20 4z"/><path d="M4 21c1.8-5.4 5-9 9.5-11"/></svg>
                  <span><span class="ja-nav-label block">オンラインクラス</span></span>
                  <svg class="ja-nav-caret" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                </button>
                <button type="button" role="tab" id="tab-special-tab" aria-controls="panel-special-tab" aria-selected="false" data-tab="special-tab" class="ja-navitem font-display">
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4c0 8.5-4.6 13-11 13H5.5C5.5 9.2 11 4 20 4z"/><path d="M4 21c1.8-5.4 5-9 9.5-11"/></svg>
                  <span><span class="ja-nav-label block">特別プログラム</span></span>
                  <svg class="ja-nav-caret" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                </button>
              </nav>
              <div class="ja-shell-main">
        <div id="panel-trial-tab" role="tabpanel" aria-labelledby="tab-trial-tab">
        <section id="trial" class="scroll-mt-24 layer-paper wash-soft wash-sage">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
            <h2 class="font-display text-3xl leading-[1.3] md:text-5xl">初めての方へ</h2>
            <p class="mt-8 max-w-2xl text-base leading-loose text-brand-espresso/85">ヨガが初めての方も、久しぶりの方も。まずは一回、通常のクラスをそのまま体験していただけます。難しいポーズはありません。ご自身の身体の状態を確かめながら、ゆっくりと進めていきます。</p>
            <div class="mt-12">
              <p class="font-mono text-[13px] uppercase tracking-[0.22em] text-brand-moss ja-sublabel">クラスの様子</p>
              <figure class="mt-5" style="max-width:100%">
                <div style="overflow:hidden;border:1px solid color-mix(in srgb, var(--color-warm-brown) 45%, transparent);background:var(--color-warm-beige)">
                  <img src="/hatha-yoga/assets/gallery/osaka-1400.jpg" alt="大阪クラスの様子" loading="lazy" width="1440" height="782" style="display:block;width:100%;height:auto;object-fit:cover" />
                </div>
                <figcaption class="mt-4 text-base leading-loose text-brand-espresso/85">はじめての方も、無理のない範囲で。呼吸に合わせて、ゆっくりと身体を動かしていきます。</figcaption>
              </figure>
            </div>
            <div class="mt-12 grid gap-5 sm:grid-cols-2">
              <div class="ja-card sc-rise bg-white flex flex-col justify-center px-7 py-9 lg:px-9 lg:py-10"><p class="text-base text-brand-espresso/70">対面クラス（約75分）</p><p class="ja-price mt-2 font-display text-4xl lg:text-5xl">4,000円</p></div>
              <div class="ja-card sc-rise bg-white flex flex-col justify-center px-7 py-9 lg:px-9 lg:py-10"><p class="text-base text-brand-espresso/70">夜のオンライン（40分）<br />健康セミナー・瞑想</p><p class="ja-price mt-2 font-display text-4xl lg:text-5xl">2,000円</p></div>
            </div>
            <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-16">
              <div>
                <p class="font-mono text-[13px] uppercase tracking-[0.22em] text-brand-moss ja-sublabel">体験できるクラス</p>
                <ul class="mt-5 space-y-3"><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>ヨガクラス（対面・オンライン）</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>瞑想クラス（対面・オンライン）</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>ヨガ科学に基づく健康セミナー（オンライン）</span></li></ul>
              </div>
              <div>
                <p class="font-mono text-[13px] uppercase tracking-[0.22em] text-brand-moss ja-sublabel">ご参加の流れ</p>
                <ol class="mt-5 space-y-3"><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="font-mono text-brand-moss">01</span><span>予約フォームからご希望の日時をお申し込みください</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="font-mono text-brand-moss">02</span><span>当日のご案内と会場・参加URLをお送りします</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="font-mono text-brand-moss">03</span><span>動きやすい服装とお水をお持ちの上、10分前にお越しください</span></li></ol>
              </div>
            </div>
            <p class="mt-10 text-base leading-loose text-brand-espresso/75">※ 体験後の継続は、単発参加でも月額会員でもお選びいただけます。詳しくは<a href="#pricing" class="border-b border-brand-espresso pb-0.5 hover:opacity-70">クラス価格</a>をご覧ください。</p>
            <div class="mt-10"><a href="https://docs.google.com/forms/d/1rKoOxcGQyew2a_d341eduWZ4QuhbK7R3YloP14Z6s8w/viewform" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 text-[14px] uppercase tracking-[0.18em] font-medium transition-colors duration-300 active:translate-y-px bg-brand-espresso text-white hover:bg-brand-moss">体験レッスンを予約する</a></div>
          </div>
        </section>
        </div>
        <div id="panel-inperson-tab" role="tabpanel" aria-labelledby="tab-inperson-tab" hidden>
        <section id="inperson" class="scroll-mt-24 layer-paper wash-soft wash-gold">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
            <h2 class="font-display text-3xl leading-[1.3] md:text-5xl">対面クラス</h2>
            <p class="mt-5 max-w-3xl text-base leading-loose text-brand-espresso/85">大阪・東京のスタジオで開催する対面クラスです。同じ空間で呼吸を合わせ、その場で姿勢や身体の使い方を直接お伝えできるのが対面の大きな魅力です。全国各地への出張クラスも承っています。</p>
            <div class="mt-10">
              <div class="grid gap-5 sm:grid-cols-3">
                <div class="bg-white px-6 py-6 ja-card sc-rise"><p class="font-display text-lg">大阪<br />通常対面クラス</p></div>
                <div class="bg-white px-6 py-6 ja-card sc-rise"><p class="font-display text-lg">東京<br />通常対面クラス</p></div>
                <div class="bg-white px-6 py-6 ja-card sc-rise"><p class="font-display text-lg">全国各地<br />出張・特別対面クラス</p></div>
              </div>
            </div>
            <div class="mt-8"><a href="#pricing" class="inline-flex items-center gap-2 border-b border-brand-espresso pb-0.5 text-base hover:opacity-70"><span>単発参加・月額会員の料金はクラス価格をご覧ください</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="m9 6 6 6-6 6"/></svg></a></div>
            <div class="mt-12">
              <div class="space-y-5">
                <details class="group ja-card sc-rise bg-white" open>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-7 py-7 md:px-10 md:py-8">
                    <span><span class="block font-display text-2xl leading-snug md:text-3xl">ヨガクラス（対面）</span><span class="mt-2 block font-display text-lg text-brand-moss md:text-xl">身体を整え、軽やかな毎日へ</span></span>
                    <span aria-hidden="true" class="shrink-0 font-display text-3xl leading-none text-brand-moss transition-transform duration-300 group-open:rotate-45">+</span>
                  </summary>
                  <div class="border-t border-brand-espresso/10 px-7 pb-9 pt-8 md:px-10 md:pb-11">
                    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr] md:gap-16">
                      <div class="space-y-5 text-base leading-loose text-brand-espresso/85"><p>ヨガが初めての方にも取り組みやすい、シンプルでありながらパワフルな実践です。</p><p>関節・筋肉・エネルギーシステムに働きかけ、身体をやさしく活性化。日々の疲れや身体のこわばりをほぐし、より軽やかで快適な状態へと導いていきます。</p><p>対面クラスでは、お一人おひとりの身体の状態を見ながら、姿勢や動きを丁寧にお伝えします。難しいポーズに挑戦するのではなく、ご自身の身体を意識しながら実践していきます。</p></div>
                      <div><p class="font-mono text-[13px] uppercase tracking-[0.22em] text-brand-moss ja-sublabel">こんな方におすすめ</p><ul class="mt-5 space-y-3"><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>身体の疲れやこわばりを感じている方</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>運動不足を感じている方</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>直接指導を受けながら学びたい方</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>ヨガを初めて体験する方</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>大阪・東京で通えるクラスを探している方</span></li></ul><dl class="mt-8 border-t border-brand-espresso/15 pt-6"><dt class="font-mono text-[13px] uppercase tracking-[0.2em] text-brand-moss">所要時間</dt><dd class="mt-2 font-display text-xl">約75分</dd></dl></div>
                    </div>
                  </div>
                </details>
                <details class="group ja-card sc-rise bg-white">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-7 py-7 md:px-10 md:py-8">
                    <span><span class="block font-display text-2xl leading-snug md:text-3xl">瞑想クラス（対面）</span><span class="mt-2 block font-display text-lg text-brand-moss md:text-xl">意識を内側へ。心に静けさを。</span></span>
                    <span aria-hidden="true" class="shrink-0 font-display text-3xl leading-none text-brand-moss transition-transform duration-300 group-open:rotate-45">+</span>
                  </summary>
                  <div class="border-t border-brand-espresso/10 px-7 pb-9 pt-8 md:px-10 md:pb-11">
                    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr] md:gap-16">
                      <div class="space-y-5 text-base leading-loose text-brand-espresso/85"><p>サドグルによるさまざまなガイド瞑想を、その日のテーマに合わせて一緒に実践します。</p><p>私たちは普段、仕事、人間関係、情報など、意識の多くを外側へ向けて生活しています。瞑想の時間では、一度その意識を自分自身の内側へ向け、身体・心・感情との向き合い方を見つめていきます。</p><p>静けさを共有できる空間で、同じ時間をともに過ごすこと。それ自体が、対面での瞑想クラスならではの体験です。</p></div>
                      <div><p class="font-mono text-[13px] uppercase tracking-[0.22em] text-brand-moss ja-sublabel">テーマ例</p><ul class="mt-5 space-y-3"><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>心を穏やかにする瞑想</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>自分自身と深くつながる瞑想</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>理想の人生や未来へ意識を向ける瞑想</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>自然とのつながりを感じる瞑想</span></li><li class="flex gap-3 text-sm leading-relaxed text-brand-espresso/85"><span aria-hidden="true" class="text-brand-moss">─</span><span>身体と生命への意識を深める瞑想</span></li></ul><dl class="mt-8 border-t border-brand-espresso/15 pt-6"><dt class="font-mono text-[13px] uppercase tracking-[0.2em] text-brand-moss">所要時間</dt><dd class="mt-2 font-display text-xl">約75分</dd></dl></div>
                    </div>
                  </div>
                </details>
              </div>
            <div class="mt-14">
              <p class="font-mono text-[13px] uppercase tracking-[0.24em] text-brand-moss">ギャラリー</p>
              <div class="mt-6 swiper ja-gallery" style="--swiper-navigation-color:#FAF6EA;--swiper-pagination-color:#FAF6EA;--swiper-navigation-size:24px;border:1px solid rgba(138,96,67,.5);border-radius:6px;overflow:hidden;background:#E8D9C2">
                <div class="swiper-wrapper">
                  <div class="swiper-slide"><img src="/hatha-yoga/assets/gallery/osaka-1400.jpg" alt="大阪クラスの様子" decoding="async" style="display:block;width:100%;aspect-ratio:3/2;object-fit:cover" /></div>
                  <div class="swiper-slide"><img src="/hatha-yoga/assets/gallery/tokyo-1400.jpg" alt="東京クラスの様子" decoding="async" style="display:block;width:100%;aspect-ratio:3/2;object-fit:cover" /></div>
                  <div class="swiper-slide"><img src="/hatha-yoga/assets/gallery/seminar-1400.jpg" alt="対面クラスの様子" decoding="async" style="display:block;width:100%;aspect-ratio:3/2;object-fit:cover" /></div>
                  <div class="swiper-slide"><img src="/hatha-yoga/assets/gallery/yoga-1400.jpg" alt="ヨガクラスの様子" decoding="async" style="display:block;width:100%;aspect-ratio:3/2;object-fit:cover" /></div>
                </div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
                <div class="swiper-pagination"></div>
              </div>
            </div>
            </div>
          </div>
        </section>
        </div>
        <div id="panel-online-tab" role="tabpanel" aria-labelledby="tab-online-tab" hidden>
        <section id="online-class" class="scroll-mt-24 layer-paper wash-soft wash-gold">
          <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
            <h2 class="font-display text-3xl leading-[1.3] md:text-5xl">オンラインクラス</h2>
            <p class="mt-5 max-w-3xl text-base leading-loose text-brand-espresso/85">全国・海外どこからでも、ご自宅から参加いただけるオンラインクラスです。移動の時間をかけずに、ヨガ・瞑想・ヨガ科学に基づく健康セミナーを日常の習慣として続けていただけます。</p>
            <div class="mt-10">
              <div class="grid gap-5 sm:grid-cols-3">
