---
import YogaLayout from '../../../layouts/YogaLayout.astro';
import { classText, getClassContent } from '../../../data/classes';
import InPerson from '../../../components/yoga/classes/InPerson.astro';
import RegularClass from '../../../components/yoga/classes/RegularClass.astro';
import Fees from '../../../components/yoga/classes/Fees.astro';
import OsakaCourse from '../../../components/yoga/classes/OsakaCourse.astro';
import SuryaKriya from '../../../components/yoga/classes/SuryaKriya.astro';
import Satorin from '../../../components/yoga/classes/Satorin.astro';
import OnlineSingle from '../../../components/yoga/classes/OnlineSingle.astro';
import ClassDialogs from '../../../components/yoga/classes/ClassDialogs.astro';
import { yogaHref } from '../../../data/yoga';
import '../../../styles/yoga/pages/offerings.css';
import '../../../styles/yoga/pages/classes.css';
import '../../../styles/yoga/calendar.css';


interface Props { locale?: 'ja' | 'en'; }
const { locale = 'ja' } = Astro.props;
const t = (text: string) => classText(locale, text);
const { VENUES } = getClassContent(locale);
/* The page is split by place. Each tab lists only what is offered there. */
const cities = [
  { id: 'osaka', name: t('大阪'), cal: 'kw-osaka' },
  { id: 'tokyo', name: t('東京'), cal: 'kw-tokyo' },
  { id: 'online', name: t('オンライン会員'), shortName: t('会員'), cal: 'online' },
  { id: 'online-single', name: t('オンライン単発'), shortName: t('単発'), cal: 'online' },
];
---
<YogaLayout title={t("クラス・料金｜大阪・東京のハタヨガ教室 | Setsuko Hata Yoga")}
  description={t("秦 節子のハタヨガクラス。大阪・東京の対面クラスと月額会員、スーリヤ・クリヤ、オンラインの SATORIN メンバーシップのご案内。")}
  locale={locale}
  active="classes"
  bodyClass="page-offerings"
>
        <section class="cl-hero cl-hero--tabs" data-screen-label="Hero">
          <div class="cl-wrap cl-hero__grid">
            <div class="cl-hero__photo"><img src="/hatha-yoga/assets/gallery/meditation-1400.jpg" alt={t("瞑想クラスの様子")} decoding="async" /></div>
            <div class="cl-hero__text">
              <p class="cl-hero__en">Classes</p>
              <h1>{t("クラス")}</h1>
              <p class="cl-hero__lead">{t("大阪・東京の対面クラスと、全国・海外から参加できるオンラインクラス。参加したい場所を選ぶと、そこで受けられるクラスをご覧いただけます。")}</p>
            </div>
          </div>
          <div class="cl-wrap">
            <div id="cities" class="cl-tabs scroll-mt-24" role="tablist" aria-label={t("開催場所")}>
              {cities.map((c, i) => (
                <a class:list={["cl-city-tab", { "cl-city-tab--online": c.shortName }]} aria-label={c.name} role="tab" id={`tab-${c.id}`} href={`#${c.id}`} aria-controls={c.id} aria-selected={i === 0 ? 'true' : 'false'} data-city-tab={c.id} data-cal-default={c.cal}>{c.shortName ? <span class="cl-city-tab__label">{t("オンライン")}<br />{c.shortName}</span> : c.name}</a>
              ))}
            </div>
          </div>
        </section>

        <div id="osaka" class="cl-city" role="tabpanel" aria-labelledby="tab-osaka" data-city-panel>
          <div class="cl-city__inner">
            <OsakaCourse locale={locale} id="osaka-course" tone="cl-section--cream" />
            <RegularClass locale={locale} id="osaka-regular" />
            <Fees locale={locale} id="osaka-fees" eyebrow={t("大阪｜対面")} membership tone="cl-section--cream" />
            <SuryaKriya locale={locale} id="osaka-surya" calFilter="kw-osaka special" />
            <Satorin locale={locale} id="osaka-satorin" tone="cl-section--cream" fullHref="#online-satorin" />
          </div>
        </div>

        <div id="tokyo" class="cl-city" role="tabpanel" aria-labelledby="tab-tokyo" data-city-panel>
          <div class="cl-city__inner">
            <InPerson locale={locale} id="tokyo-inperson" eyebrow={t("東京")} title={t("対面クラス（単発）")} calFilter="kw-tokyo inperson"
              lead={t("東京・三田のスタジオで、ヨガクラスと瞑想クラスを単発で開催しています。開催日は開催スケジュールをご確認ください。")} />
            <Fees locale={locale} id="tokyo-fees" eyebrow={t("東京｜対面")} tone="cl-section--cream" />
            <SuryaKriya locale={locale} id="tokyo-surya" calFilter="kw-tokyo special" />
            <Satorin locale={locale} id="tokyo-satorin" tone="cl-section--cream" fullHref="#online-satorin" />
          </div>
        </div>

        <div id="online" class="cl-city" role="tabpanel" aria-labelledby="tab-online" data-city-panel>
          <div class="cl-city__inner">
            <Satorin locale={locale} id="online-satorin" full tone="cl-section--cream" />
          </div>
        </div>

        <div id="online-single" class="cl-city" role="tabpanel" aria-labelledby="tab-online-single" data-city-panel>
          <div class="cl-city__inner">
            <OnlineSingle locale={locale} id="online-single-classes" tone="cl-section--cream" />
          </div>
        </div>

        <section id="calendar" class="cl-section cl-section--sage scroll-mt-24" data-screen-label="Class Calendar">
          <div class="cl-wrap">
            <div class="cl-head">
              <p class="cl-eyebrow">{t("カレンダー")}</p>
              <h2>{t("開催スケジュール")}</h2>
              <span class="cl-head__rule" aria-hidden="true"></span>
            </div>
            <p class="cl-lead">{t("オンライン・対面クラス・スーリヤ・クリヤの開催日を、ひとつのカレンダーでご覧いただけます。種類で絞り込むこともできます。")}</p>
            <div class="cl-calendar"><div class="mt-10"><div data-hy-cal data-locale={locale} data-label={t("開催スケジュール")} data-feed="https://script.google.com/macros/s/AKfycbwqXPOLnB8nzrbWNHWtcW-gKD5FG5I38xDpfoxLzVR-OQ0GM_D3w_RFjyIrIYKHDcbGIA/exec" data-keywords={JSON.stringify([{ key: 'kw-osaka', label: t('大阪'), kw: '大阪' }, { key: 'kw-tokyo', label: t('東京'), kw: '東京' }])} data-sources={JSON.stringify([{ key: 'online', label: `${t('オンライン')} (SATORIN)`, tone: 'sage' }, { key: 'inperson', label: t('対面クラス'), tone: 'clay' }, { key: 'special', label: t('スーリヤ・クリヤ'), tone: 'honey' }])}></div></div></div>
          </div>
        </section>

        <section id="guide" class="cl-section cl-section--cream scroll-mt-24" data-screen-label={t("ご案内")} data-hide-for="online-single">
          <div class="cl-wrap">
            <div class="cl-head">
              <p class="cl-eyebrow">{t("ご案内")}</p>
              <h2>{t("会場・お支払い・キャンセル・持ち物")}</h2>
              <span class="cl-head__rule" aria-hidden="true"></span>
            </div>
            <p class="cl-lead">{t("通常対面クラス・スーリヤ・クリヤのご案内です。")}</p>
            <dl class="cl-guide">
              <div data-venue-row><dt>{t("会場")}</dt><dd class="cl-venues">
                {VENUES.map((v) => (
                  <div class="cl-venues__item" data-venue-city={v.city}>
                    <p class="cl-venues__name"><span class="cl-venues__area">{v.area}</span>{v.name}{v.note && <span class="cl-venues__note">{v.note}</span>}</p>
                    {v.lines.map((l) => <p>{l}</p>)}
                    {v.access && <p>{v.access}</p>}
                    {v.map && <p><a class="cl-link" href={v.map} target="_blank" rel="noreferrer">{t("地図を見る")}</a></p>}
                  </div>
                ))}
              </dd></div>
              <div><dt>{t("お支払い")}</dt><dd><p>{t("銀行振込・当日現金・PayPay")}</p></dd></div>
              <div data-guide-for="osaka tokyo"><dt>{t("キャンセル")}</dt><dd><p>{t("前日：受講料の50％")}</p><p>{t("当日：受講料の100％")}</p></dd></div>
              <div data-guide-for="online" hidden><dt>{t("返金・休学・退会について")}</dt><dd>
                <p>{t("お支払い済みの月の受講料は、ご返金いたしかねます。あらかじめご了承ください。")}</p>
                <p>{t("休学・退会をご希望の方は、希望する月の前月25日までに、メールにてご連絡ください。件名は、ご希望に応じて「休学の手続き」または「退会の手続き」としてください。")}</p>
                <p>{t("お手続きには日数を要するため、期限を過ぎてご連絡いただいた場合、ご希望の月の休学・退会に間に合わず、その月の受講料が請求される場合がございます。お早めにご連絡くださいますようお願いいたします。")}</p>
              </dd></div>
              <div><dt>{t("当日")}</dt><dd><p>{t("開始10分前までにお越しください。開始5分前までにお着替えをお済ませください（スタジオ内でお着替えいただけます）。")}</p></dd></div>
              <div><dt>{t("お食事")}</dt><dd><p>{t("しっかりした食事は4時間、軽食・果物は2時間半、ジュース・お茶は1時間半あけてください。お水は制限ありません。")}</p></dd></div>
              <div><dt>{t("持ち物")}</dt><dd><p>{t("お水、動きやすい綿100％の服装")}</p></dd></div>
            </dl>
          </div>
        </section>

        <section id="contact" class="cl-section cl-section--sand scroll-mt-24" data-screen-label={t("お問い合わせ")}>
          <div class="cl-wrap">
            <div class="cl-head">
              <p class="cl-eyebrow">{t("お問い合わせ")}</p>
              <h2>{t("どのクラスが合うか、ご相談ください。")}</h2>
              <span class="cl-head__rule" aria-hidden="true"></span>
            </div>
            <p class="cl-lead">{t("オンラインと対面のどちらが合うか、月額会員と単発参加のどちらがよいか。ご一緒に考えます。")}</p>
            <div class="cl-actions">
              <a href={yogaHref(locale, 'contact')} class="cl-btn">{t("お問い合わせ")}</a>
              <a href="mailto:yoga@setsukohata.com" class="cl-link">yoga@setsukohata.com</a>
            </div>
          </div>
        </section>

        <ClassDialogs locale={locale} />
</YogaLayout>
<script>
  import '../../../scripts/yoga/calendar.js';
  import '../../../scripts/yoga/class-dialogs.js';
  import '../../../scripts/yoga/class-cities.js';
  import '../../../scripts/yoga/plan-gallery.js';
</script>
