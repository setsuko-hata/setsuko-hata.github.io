---
interface Props { locale?: 'ja' | 'en'; }
const { locale = 'ja' } = Astro.props;
const t = (ja: string, en: string) => locale === 'en' ? en : ja;

import YogaLayout from '../../../layouts/YogaLayout.astro';
import { VENUES, IN_PERSON_RATES } from '../../../data/classes';
import { CONTACT_EMAIL } from '../../../data/yoga';

const SITE = 'https://setsukohata.com';
const PAGE = `${SITE}/hatha-yoga/${locale}/`;

// Venue addresses split for schema.org. Keep in step with VENUES in data/classes.ts.
const PLACES = [
  { mapName: 'カタリーナホール玉造', name: t("カタリーナホール玉造", "Caterina Hall Tamatsukuri"), postalCode: '543-0014', locality: t("大阪市天王寺区", "Tennoji Ward, Osaka"), street: t("玉造元町3-1", "3-1 Tamatsukuri Motomachi"), region: t("大阪府", "Osaka Prefecture") },
  { mapName: '大阪市教育会館', name: t("大阪市教育会館", "Osaka City Education Hall"), postalCode: '540-0006', locality: t("大阪市中央区", "Chuo Ward, Osaka"), street: t("法円坂1-1-35 アネックスパル法円坂", "Annex Pal Hoenzaka, 1-1-35 Hoenzaka"), region: t("大阪府", "Osaka Prefecture") },
];
const address = (p: (typeof PLACES)[number]) => ({
  '@type': 'PostalAddress',
  postalCode: p.postalCode,
  addressRegion: p.region,
  addressLocality: p.locality,
  streetAddress: p.street,
  addressCountry: 'JP',
});
const venueMap = (name: string) => VENUES.find((v) => v.name.startsWith(name))?.map;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'SportsActivityLocation'],
      '@id': `${PAGE}#yoga`,
      name: t("Setsuko Hata Yoga（秦 節子 ハタヨガ）", "Setsuko Hata Yoga"),
      alternateName: t("秦節子 ハタヨガ", "Setsuko Hata Hatha Yoga"),
      description:
        t("大阪・東京で開催するハタヨガ教室。サドグル公認ハタヨガ講師・秦 節子が、伝統的なハタヨガ（ウパヨガ、スーリヤ・クリヤ、アンガマルダナ、ヨガアーサナ）を対面とオンラインで指導しています。", "Hatha Yoga classes in Osaka and Tokyo. Sadhguru-certified teacher Setsuko Hata teaches traditional Hatha Yoga, including Upa Yoga, Surya Kriya, Angamardana, and Yogasanas, in person and online."),
      url: PAGE,
      image: `${SITE}/hatha-yoga/assets/og-image.jpg`,
      email: CONTACT_EMAIL,
      priceRange: locale === 'en' ? `From JPY ${IN_PERSON_RATES[0].price}` : `¥${IN_PERSON_RATES[0].price}〜`,
      currenciesAccepted: 'JPY',
      address: address(PLACES[0]),
      hasMap: venueMap(PLACES[0].mapName),
      location: PLACES.map((p) => ({ '@type': 'Place', name: p.name, address: address(p), hasMap: venueMap(p.mapName) })),
      areaServed: [
        { '@type': 'City', name: t("大阪市", "Osaka") },
        { '@type': 'AdministrativeArea', name: t("大阪府", "Osaka Prefecture") },
        { '@type': 'City', name: t("東京都", "Tokyo") },
      ],
      knowsAbout: [t("ハタヨガ", "Hatha Yoga"), 'Hatha Yoga', t("ウパヨガ", "Upa Yoga"), t("スーリヤ・クリヤ", "Surya Kriya"), t("アンガマルダナ", "Angamardana"), t("ヨガアーサナ", "Yogasanas"), t("瞑想", "Meditation")],
      founder: { '@id': `${SITE}/#person` },
      employee: { '@id': `${SITE}/#person` },
      sameAs: ['https://www.youtube.com/@SetsukoHataFlows', 'https://www.instagram.com/setsuko_hata/'],
    },
    {
      '@type': 'Person',
      '@id': `${SITE}/#person`,
      name: t("秦 節子", "Setsuko Hata"),
      alternateName: ['Setsuko Hata', t("秦節子", "Setsuko Hata")],
      jobTitle: t("サドグル公認ハタヨガ講師", "Sadhguru-certified Hatha Yoga teacher"),
      url: `${SITE}/`,
      image: `${SITE}/assets/setsuko-portrait.jpg`,
    },
    {
      '@type': 'WebPage',
      '@id': PAGE,
      url: PAGE,
      name: t("ハタヨガ 大阪・東京｜サドグル公認ハタヨガ講師 秦 節子", "Hatha Yoga in Osaka & Tokyo | Sadhguru-certified Teacher Setsuko Hata"),
      inLanguage: locale,
      about: { '@id': `${PAGE}#yoga` },
      isPartOf: { '@type': 'WebSite', name: t("秦 節子 | Setsuko Hata", "Setsuko Hata"), url: `${SITE}/` },
    },
  ],
};
---
<YogaLayout title={t("ハタヨガ 大阪・東京｜サドグル公認ハタヨガ講師 秦 節子 | Setsuko Hata Yoga", "Hatha Yoga in Osaka & Tokyo | Sadhguru-certified Teacher Setsuko Hata")}
  description={t("大阪・東京のハタヨガ教室。サドグル公認ハタヨガ講師・秦 節子（Setsuko Hata）が、インドで1,750時間超の研鑽を積んだ伝統的なハタヨガを対面・オンラインで指導。ウパヨガからスーリヤ・クリヤまで。", "Hatha Yoga classes in Osaka and Tokyo. Sadhguru-certified teacher Setsuko Hata shares traditional practices in person and online, from Upa Yoga to Surya Kriya, following more than 1,750 hours of training in India.")}
  ogTitle={t("本物のヨガでなりたい自分へ｜大阪・東京のハタヨガ 秦 節子", "Be who you want to be through Classical Hatha Yoga | Setsuko Hata Yoga in Osaka & Tokyo")}
  jsonLd={jsonLd}
  locale={locale}
  active="home"
  mainLook={false}
  bodyClass="ja-home"
>
  <link slot="head" rel="preload" as="image" href="/hatha-yoga/assets/hero-forest-approved.png" type="image/png" />

        <div class="main-look" style="display:contents">
        <section class="jh" aria-labelledby="jh-title">
          <figure class="jh__figure">
            <div class="jh__arch">
              <picture><img src="/hatha-yoga/assets/hero-forest-approved.png" alt={t("秦節子、木漏れ日の小川のほとりにて", "Setsuko Hata beside a sunlit stream")} fetchpriority="high" width="2048" height="1536" /></picture>
            </div>
          </figure>
          <div class="jh__inner">
            <div class="jh__copy">
              <h1 id="jh-title" class="jh__title"><span class="jh__title-line">{t("本物のヨガで", "Be who you want to be")}</span><br /><span class="jh__title-line">{t("なりたい自分へ", "through Classical Hatha Yoga")}</span></h1>
              <p class="jh__lead">{locale === "en" ? "Discover the science of Hatha Yoga, passed down in India for thousands of years, and bring your body and mind into your own hands." : <>インドで何千年も受け継がれてきたハタヨガの科学で、<br />身体と心を思いのままに。</>}</p>
              <p class="jh__sub">{t("あなたの可能性を最大限に開花", "Let your fullest potential unfold")}</p>
              <div class="jh__actions">
                <a class="jh__btn jh__btn--solid" href="https://docs.google.com/forms/d/1rKoOxcGQyew2a_d341eduWZ4QuhbK7R3YloP14Z6s8w/viewform" target="_blank" rel="noreferrer">{t("体験レッスンを予約する", "Book a trial lesson")}</a>
                <a class="jh__btn jh__btn--line" href={`/hatha-yoga/${locale}/hatha-yoga/`}>{t("ハタヨガとは", "What is Hatha Yoga?")}</a>
              </div>
            </div>
          </div>
          <span class="jd jd--sweep jd--v-tall jd--sweep-a" aria-hidden="true"></span>
          <span class="jd jd--sweep jd--v-tall jd--sweep-b" aria-hidden="true"></span>
          <svg class="jh__wave" aria-hidden="true" viewBox="0 0 1440 120" preserveAspectRatio="none">
            <path d="M0 70 C 240 30 480 96 760 78 C 1040 60 1220 22 1440 56 L1440 120 L0 120 Z" fill="#E9E5D2" />
            <path d="M0 92 C 260 60 520 112 800 98 C 1060 84 1240 56 1440 80 L1440 120 L0 120 Z" fill="var(--color-surface-sage)" />
          </svg>
        </section>

        <section class="ja-band ja-band-sage ja-wave-b" style="background:var(--color-surface-sage);padding:44px 0 80px !important" data-screen-label={t("開催案内バナー", "Class locations")} data-lt="1">
          <span class="jd jd--sweep jd--v-low jd--sweep-a jd--right" aria-hidden="true"></span>
          <span class="jd jd--sweep jd--v-low jd--sweep-b jd--right" aria-hidden="true"></span>
          <div style="max-width:1120px;margin:0 auto;padding:0 clamp(20px,4vw,40px);display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center">
            <p class="font-mono" style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#2A1D14">{t("Osaka ・ Tokyo ・ Online", "Osaka · Tokyo · Online")}</p>
            <p style="font-family:'Shippori Mincho',serif;font-size:clamp(21px,2.6vw,30px);line-height:1.6;color:#2A1D14">{t("大阪・東京での対面クラス ＆ 全国オンラインクラス開催中", "In-person classes in Osaka & Tokyo, plus online classes across Japan")}</p>
            <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:10px">
              <span style="padding:8px 18px;font-size:14px;color:#2A1D14;border:1px solid rgba(89,96,68,.28);background:rgba(255,255,255,.6);border-radius:2px">{t("大阪 対面クラス", "Osaka in-person classes")}</span>
              <span style="padding:8px 18px;font-size:14px;color:#2A1D14;border:1px solid rgba(89,96,68,.28);background:rgba(255,255,255,.6);border-radius:2px">{t("東京 対面クラス", "Tokyo in-person classes")}</span>
              <span style="padding:8px 18px;font-size:14px;color:#2A1D14;background:var(--color-antique-gold);border:1px solid rgba(89,96,68,.28);border-radius:2px">{t("全国オンライン", "Online across Japan")}</span>
            </div>
            <p style="font-size:clamp(15px,1.5vw,18px);line-height:1.9;color:#2A1D14">{t("初めての方も、全国どこからでもご参加いただけます。", "Beginners are welcome, wherever you are in Japan.")}</p>
          </div>
        </section>

        <section id="hatha" style="position:relative;background:transparent;overflow:hidden" data-screen-label={t("はじめに", "An introduction")}>
          <span class="jd jd--branch jd--tr" aria-hidden="true"></span>
          <svg aria-hidden="true" viewBox="0 0 600 600" style="position:absolute;left:-80px;top:40px;width:min(260px,30vw);opacity:.55;pointer-events:none">
            <path d="M300 30 C 470 30 570 170 540 320 C 512 462 380 570 240 552 C 92 533 20 400 34 268 C 48 132 140 30 300 30 Z" fill="var(--color-light-sage)" />
            <path d="M300 30 C 470 30 570 170 540 320 C 512 462 380 570 240 552 C 92 533 20 400 34 268 C 48 132 140 30 300 30 Z" fill="none" stroke="var(--color-antique-gold)" stroke-opacity=".45" stroke-width="1" transform="translate(26 -18) scale(.94) translate(19 19)" />
          </svg>
          <div style="position:relative;max-width:1120px;margin:0 auto;padding:0 clamp(20px,4vw,40px);display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(36px,5vw,72px);align-items:start">
            <div>
              <div style="display:flex;align-items:baseline;gap:16px;margin-bottom:22px">
                <span style="font-family:'Shippori Mincho',serif;font-size:19px;letter-spacing:.16em;color:var(--yl-gold)">{t("はじめに", "An introduction")}</span>
                <span aria-hidden="true" style="flex:1;height:1px;background:rgba(185,151,85,.5)"></span>
              </div>
              <h2 style="font-size:clamp(30px,4vw,42px);line-height:1.35">{t("本当はもっと", "You know you are capable")}<br />{t("できるはずなのに。", "of so much more.")}</h2>
              <p style="margin-top:26px;font-size:16px;line-height:2.05;color:#2A1D14">{t("疲れが抜けない。肩や首のこわばり。眠りの浅さ。ストレスや慢性的な不調。心と体のバランスの乱れ。", "Lingering fatigue. Stiff shoulders and neck. Restless sleep. Stress and ongoing discomfort. A body and mind out of balance.")}</p>
              <p style="margin-top:20px;font-family:'Shippori Mincho',serif;font-size:clamp(22px,2.4vw,27px);line-height:1.55;color:#2A1D14">{t("体も心も、思い通りにならない。", "Your body and mind do not feel like your own.")}</p>
            </div>
            <div class="sh-mirror">
              <p style="font-family:'Shippori Mincho',serif;font-size:clamp(20px,2.2vw,25px);line-height:1.8;color:#2A1D14">{t("それは、あなたがまだ本来の生命の力を出しきれていないだけです。", "Perhaps you have simply not yet tapped into the full power of your life.")}</p>
              <div aria-hidden="true" style="width:52px;height:1px;background:var(--color-antique-gold);margin:30px 0"></div>
              <p style="font-size:15px;line-height:2.05;color:#2A1D14">{t("ヨガというと、身体を柔らかくするための運動やストレッチを思い浮かべる方も多いかもしれません。", "For many people, yoga brings to mind exercise or stretching to make the body more flexible.")}</p>
              <p style="margin-top:16px;font-size:15px;line-height:2.05;color:#2A1D14">{t("しかしヨガの本当の意味は「ユニオン」。自分の生命が大宇宙と繋がること。", "But the true meaning of yoga is union: your life connecting with the greater universe.")}</p>
            </div>
          </div>
        </section>
        </div>

        <section class="sh-quote layer-paper layer-paper--grain wash-sage" data-screen-label={t("ハタヨガとは", "What is Hatha Yoga?")}>
          <span class="jd jd--sweep jd--v-cross jd--sweep-a" aria-hidden="true"></span>
          <span class="jd jd--sweep jd--v-cross jd--sweep-b" aria-hidden="true"></span>
          <div class="sh-quote__panel">
            <blockquote>{t("ヨガは生命を心身・エネルギーのレベルから変革し、私たちの", "Yoga transforms life through the body, mind, and energy. It is ")}<em class="sh-key">{t("生命の可能性を開いていく科学", "a science of opening life's possibilities")}</em>{t("です。", ".")}</blockquote>
            <svg class="sh-rule-ornament" aria-hidden="true"><use href="#divider" /></svg>
            <p class="sh-quote__verse">{t("エネルギーに満ちた、健やかな身体。", "A healthy body, full of energy.")}<br />{t("至福に満ちた、心。", "A mind filled with bliss.")}<br />{t("そして、生命そのものが躍動しはじめる。", "And life itself begins to flourish.")}</p>
            <p class="sh-quote__tail">{t("その道を示したのが、", "The path to this is ")}<strong>{t("ハタヨガ", "Hatha Yoga")}</strong>{t("です。", ".")}</p>
          </div>
          <picture class="sh-quote__photo"><img src="/hatha-yoga/assets/photos/mountain-sunrays-web.jpg" alt={t("朝の光に染まる山並み", "Mountains bathed in morning light")} loading="lazy" width="1600" height="1065" /></picture>
        </section>

        <section class="sh-section layer-paper layer-paper--grain wash-sage wash-soft sh-effects" data-screen-label={t("効果", "Benefits")}>
          <span class="jd jd--lotus" style="right:4%;top:24px" aria-hidden="true"></span>
          <div class="sh-wrap">
            <p class="sh-label sh-label--section">{t("効果", "Benefits")}</p>
            <h2>{t("ハタヨガで得られる具体的効果", "What Hatha Yoga can bring you")}</h2>
            <div class="sh-columns">
              <div class="sh-column"><span class="sh-column__ring" aria-hidden="true">
                <svg class="sh-icon" aria-hidden="true"><use href="#sprout" /></svg></span>
                <h3>{t("身体", "Body")}</h3>
                <ul><li>{t("姿勢・柔軟性の向上", "Improved posture and flexibility")}</li><li>{t("代謝・筋力の向上", "Improved metabolism and strength")}</li><li>{t("内臓機能の向上", "Improved organ function")}</li><li>{t("自律神経・ホルモンバランスが整う", "Balanced autonomic nervous system and hormones")}</li></ul>
              </div>
              <div class="sh-column"><span class="sh-column__ring" aria-hidden="true">
                <svg class="sh-icon" aria-hidden="true"><use href="#moon" /></svg></span>
                <h3>{t("心", "Mind")}</h3>
                <ul><li>{t("心の平穏さ・至福感を築く", "Greater peace of mind and bliss")}</li><li>{t("集中力・思考力の向上", "Improved concentration and thinking")}</li><li>{t("想像力・判断力の向上", "Improved imagination and judgment")}</li><li>{t("深い瞑想状態へ入りやすくなる", "Easier access to deep meditative states")}</li></ul>
              </div>
              <div class="sh-column"><span class="sh-column__ring" aria-hidden="true">
                <svg class="sh-icon" aria-hidden="true"><use href="#sun" /></svg></span>
                <h3>{t("エネルギー", "Energy")}</h3>
                <ul><li>{t("エネルギー・生命力の向上", "Increased energy and vitality")}</li><li>{t("睡眠の質の向上", "Improved sleep quality")}</li><li>{t("慢性疲労・ストレスの緩和", "Relief from chronic fatigue and stress")}</li><li>{t("あらゆる慢性不調の緩和", "Relief from chronic discomfort")}</li></ul>
              </div>
            </div>
          </div>
        </section>

        <section class="sh-band" aria-label={t("はじめての方へ", "New to yoga?")}>
          <picture><img src="/hatha-yoga/assets/photos/river-aerial.jpg" alt="" loading="lazy" width="1600" height="955" /></picture>
          <p class="sh-band__title">{t("はじめての方へ", "New to yoga?")}</p>
        </section>

        <section id="first" class="sh-first layer-paper wash-olive wash-soft" data-screen-label={t("はじめての方へ", "New to yoga?")}>
          <span class="jd jd--sweep jd--v-arch jd--sweep-a jd--right" aria-hidden="true"></span>
          <span class="jd jd--sweep jd--v-arch jd--sweep-b jd--right" aria-hidden="true"></span>
          <span class="deco deco--sun" style="right:3%;top:6%" aria-hidden="true"></span>
          <div class="sh-first__stage">
            <picture class="sh-curve sh-curve--first"><img src="/hatha-yoga/assets/photos/olive-branch.jpg" alt={t("実をつけたオリーブの枝", "An olive branch bearing fruit")} loading="lazy" width="1066" height="1600" /></picture>
            <div class="sh-first__copy">
              <h2>{t("ヨガがはじめての方も、", "Even if this is your first yoga class,")}<br />{t("安心してご参加いただけます。", "you are warmly welcome.")}</h2>
              <p class="sh-body">{t("まずは体験クラスから。心地よい変化を感じてみませんか？", "Start with a trial class and experience a positive change for yourself.")}</p>
              <a class="sh-btn sh-btn--primary" href={`/hatha-yoga/${locale}/path/`}>{t("はじめての方へ", "New to yoga?")}</a>
            
          </div>
          </div>
          <ol class="sh-steps">
              <li><span class="sh-steps__n" aria-hidden="true">01</span><span><strong>{t("クラスを選ぶ", "Choose a class")}</strong>{t("ご希望のクラスをお選びください。", "Find the class that suits you.")}</span></li>
              <li><span class="sh-steps__n" aria-hidden="true">02</span><span><strong>{t("予約する", "Book your place")}</strong>{t("オンラインまたはLINEから簡単に予約できます。", "Book easily online or through LINE.")}</span></li>
              <li><span class="sh-steps__n" aria-hidden="true">03</span><span><strong>{t("参加する", "Join us")}</strong>{t("リラックスできる服装でお越しください。", "Wear comfortable clothing you can relax in.")}</span></li>
              <li><span class="sh-steps__n" aria-hidden="true">04</span><span><strong>{t("続ける", "Keep practicing")}</strong>{t("継続することで、より深い変化を感じられます。", "Consistent practice brings deeper changes.")}</span></li>
            </ol>
        </section>

        <section id="about" class="sh-about layer-paper wash-gold" data-screen-label={t("講師紹介", "Meet your teacher")}>
          <span class="jd jd--sweep jd--sweep-a jd--terra" aria-hidden="true"></span>
          <span class="jd jd--sweep jd--sweep-b jd--terra" aria-hidden="true"></span>
          <picture class="sh-curve"><source type="image/webp" srcset="/hatha-yoga/assets/setsuko-about.webp" /><img src="/hatha-yoga/assets/setsuko-about.jpg" alt={t("秦節子", "Setsuko Hata")} loading="lazy" width="816" height="698" /></picture>
          <div class="sh-about__text">
            <p class="sh-label sh-label--section">{t("講師紹介", "Meet your teacher")}</p>
            <div class="sh-about__namerow"><span class="deco deco--moon" aria-hidden="true"></span><h2 class="sh-name">{t("秦節子", "Setsuko Hata")}</h2></div>
            <p class="sh-role">{t("サドグル公認ハタヨガ講師", "Sadhguru-certified Hatha Yoga teacher")}</p>
            <ul class="sh-creds">
              <li><b class="sh-num">1</b>{t("年半南インドのIsha Foundation にてヨガと瞑想を修行", "½ years studying yoga and meditation at Isha Foundation in southern India")}</li>
              <li><b class="sh-num">1,750</b>{t("時間のハタヨガ講師資格トレーニングを修了", " hours of Hatha Yoga teacher training completed")}</li>
              <li>{t("日本人ではわずか", "One of just ")}<b class="sh-num">3</b>{t("名のサドグル公認ハタヨガ講師の一人", " Japanese Sadhguru-certified Hatha Yoga teachers")}</li>
              <li>{t("インドへ渡る前は", "Before India, ")}<b class="sh-num">13</b>{t("年間アメリカでプロのジャズシンガー・作曲家として活動", " years as a professional jazz singer and composer in the United States")}</li>
            </ul>
            <a class="sh-btn sh-btn--primary" href={`/hatha-yoga/${locale}/about/`}>{t("講師紹介を見る", "Meet Setsuko")}</a>
          </div>
          <svg class="sh-about__waves" aria-hidden="true" viewBox="0 0 600 200" preserveAspectRatio="none"><path class="w-sage" d="M600 40C520 50 460 90 380 130S160 200 0 200H600Z"/><path class="w-terra" d="M600 100C530 110 470 150 400 180S250 200 200 200H600Z"/></svg>
        </section>

        <section id="trial" class="sh-section sh-section--sand layer-paper wash-terra wash-soft" data-screen-label={t("体験", "Try a class")}>
          <span class="jd jd--sweep jd--v-lean jd--sweep-a jd--right" aria-hidden="true"></span>
          <span class="jd jd--sweep jd--v-lean jd--sweep-b jd--right" aria-hidden="true"></span>
