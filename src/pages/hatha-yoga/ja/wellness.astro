---
interface Props { locale?: 'ja' | 'en'; }
const { locale = 'ja' } = Astro.props;
const t = (ja: string, en: string) => locale === 'en' ? en : ja;

import YogaLayout from '../../../layouts/YogaLayout.astro';
---
<YogaLayout title={t("健康経営 | Setsuko Hata Yoga", "Corporate Wellness | Setsuko Hata Yoga")}
  description={t("就業時間内のハタヨガで、離職・体調不良・生産性を変える健康経営プログラム。導入例・科学的根拠・講師プロフィール。", "A corporate wellness program using Hatha Yoga during working hours to improve retention, wellbeing, and productivity. Explore program examples, scientific evidence, and your teacher's profile.")}
  locale={locale}
  active="corporate"
>


  <section class="ja-band ja-band-sage" data-screen-label="Hero" style="position:relative;overflow:hidden;background:var(--color-warm-beige)" data-lt="1">
    <img src="/hatha-yoga/assets/wellness/stretch.jpg" alt={t("就業時間内のハタヨガクラスで、両腕を広げてポーズをとる社員たち", "Employees stretching both arms in a Hatha Yoga class during working hours")} fetchpriority="high" width="1700" height="874" style="position:absolute;top:0;left:0;width:100%;height:auto" />
    <div aria-hidden="true" style="position:absolute;inset:0;backgrou<nd:linear-gradient(100deg,color-mix(in srgb, var(--color-ivory-cream) 88%, transparent) 0%,color-mix(in srgb, var(--color-ivory-cream) 55%, transparent) 38%,transparent 70%);pointer-events:none"></div>
    
    <div aria-hidden="true" style="position:absolute;top:-160px;right:-70px;width:min(720px,92vw);height:560px;border-radius:50%;background:radial-gradient(circle,rgba(227,201,160,.26) 0%,rgba(227,201,160,0) 66%);pointer-events:none"></div>
    <div style="position:relative;z-index:2;width:100%;max-width:1180px;margin:0 auto;padding:clamp(112px,11vw,138px) clamp(22px,4vw,40px) clamp(104px,10vw,132px)">
      <div style="max-width:620px">
        <h1 class="font-display" style="margin:0;font-size:clamp(34px,5.4vw,60px);line-height:1.18;color:var(--yl-text);word-break:keep-all;overflow-wrap:normal">{t("職場に、", "Bring authentic")}<br />{t("本格ハタヨガを。", "Hatha Yoga to work.")}</h1>
        <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:clamp(24px,3vw,32px)"><a href="#contact" style="display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border-radius:2px;background:var(--color-warm-brown);color:#FFFFFF;font-size:15px;letter-spacing:.06em;text-decoration:none;white-space:nowrap;box-shadow:0 14px 26px -14px rgba(35,26,16,.8)">{t("体験クラスに申し込む", "Request a trial class")}</a><a href="#program" style="display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border-radius:2px;border:1px solid rgba(89,96,68,.28);color:var(--yl-text);font-size:15px;letter-spacing:.06em;text-decoration:none;white-space:nowrap">{t("導入例を見る", "Explore program examples")}</a></div>
      </div>
    </div>
  </section>

  <div style="position:relative;z-index:3;max-width:1180px;margin:clamp(-64px,-5vw,-40px) auto 0;padding:0 clamp(22px,4vw,40px)">
    <figure class="sc-rise" style="position:relative;margin:0;max-width:880px;padding:clamp(44px,5vw,62px) clamp(30px,5vw,64px);border:1px solid rgba(138,96,67,.55);border-radius:16px;background:linear-gradient(150deg,#FAF6EA 0%,#F0E8D4 52%,var(--color-warm-beige) 100%);box-shadow:0 44px 88px -40px rgba(47,38,32,.55),0 2px 0 rgba(255,255,255,.7) inset">
      <span aria-hidden="true" style="position:absolute;left:clamp(18px,3vw,34px);top:-6px;font-family:'Newsreader',serif;font-size:clamp(84px,10vw,130px);line-height:1;color:rgba(138,96,67,.4)">“</span>
      <span aria-hidden="true" style="position:absolute;inset:9px;border:1px solid rgba(138,96,67,.28);border-radius:10px;pointer-events:none"></span>
      <p class="font-mono" style="position:relative;margin:0;font-size:13px;letter-spacing:.3em;text-transform:uppercase;color:var(--color-warm-brown)">Corporate Wellness</p>
      <blockquote class="font-display" style="position:relative;margin:22px 0 0;font-size:clamp(22px,2.9vw,34px);line-height:1.75;color:var(--yl-text);word-break:keep-all;overflow-wrap:normal">{t("「離職・体調不良・生産性」を、", "Transform retention, wellbeing, and productivity")}<br />{t("就業時間内のヨガで変える。", "with yoga during working hours.")}</blockquote>
      <figcaption style="position:relative;margin:26px 0 0;display:flex;align-items:center;gap:16px">
        <span aria-hidden="true" style="display:block;width:52px;height:1px;background:rgba(138,96,67,.75)"></span>
        <span style="font-size:16px;line-height:1.9;color:var(--yl-soft)">{t("心と体、そしてエネルギーを整える福利厚生プログラム。", "An employee wellbeing program that brings balance to mind, body, and energy.")}</span>
      </figcaption>
    </figure>
  </div>

  <section id="issue" class="scroll-mt-24" data-screen-label={t("課題", "Challenges")} style="position:relative;background:var(--color-ivory-cream);overflow:hidden">
    <svg aria-hidden="true" viewBox="0 0 200 320" style="position:absolute;left:-72px;top:70px;width:220px;opacity:.5;transform:rotate(-16deg);pointer-events:none"><path d="M100 12 C 40 90 34 210 100 308 C 166 210 160 90 100 12 Z" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".32"/><path d="M100 20 L100 300" stroke="var(--color-warm-brown)" stroke-opacity=".25"/><path d="M100 90 C 70 104 58 132 54 160" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".2"/><path d="M100 90 C 130 104 142 132 146 160" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".2"/><path d="M100 160 C 74 172 64 196 60 220" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".18"/><path d="M100 160 C 126 172 136 196 140 220" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".18"/></svg>
    <div style="position:relative;max-width:72rem;margin:0 auto">
      <div style="display:grid;gap:56px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));align-items:start">
        <div>
          <p class="ja-eyebrow">{t("課題", "Challenges")}</p>
          <h2 class="font-display" style="margin:20px 0 0;font-size:clamp(30px,4.2vw,48px);line-height:1.3;color:var(--color-text-primary)">{t("御社に、こんな", "Does your workplace face")}<br />{t("課題はありませんか？", "these challenges?")}</h2>
          <p style="margin:24px 0 0;font-size:16.5px;line-height:2.05;color:var(--color-text-primary)">{t("特に、繰り返し作業・立ち仕事・座りっぱなしの現場で慢性化しています。", "They are especially persistent in workplaces involving repetitive tasks, prolonged standing, or long hours at a desk.")}</p>
          <figure class="sc-rise" style="margin:40px 0 0;overflow:hidden;border-radius:14px;box-shadow:0 22px 48px -34px color-mix(in srgb, var(--color-text-primary) 40%, transparent)">
            <img src="/hatha-yoga/assets/wellness/talk.jpg" alt={t("企業向けの説明会で話す秦節子", "Setsuko Hata speaking at a corporate information session")} loading="lazy" style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:14px" />
          </figure>
        </div>
        <ol style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column">
          <li class="sc-rise" style="display:grid;grid-template-columns:64px minmax(0,1fr);gap:20px;padding:28px 0;border-top:1px solid rgba(208,138,94,.42)"><span class="font-display" style="font-size:34px;line-height:1;color:rgba(150,86,44,.55)">01</span><span><span class="font-display" style="display:block;font-size:24px;line-height:1.45;color:var(--yl-text)">{t("離職率が高い", "High staff turnover")}</span><span style="display:block;margin-top:10px;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("採用と育成を繰り返しても人が定着せず、現場が回らない。", "Repeated hiring and training fail to retain people, leaving operations struggling.")}</span></span></li><li class="sc-rise" style="display:grid;grid-template-columns:64px minmax(0,1fr);gap:20px;padding:28px 0;border-top:1px solid rgba(208,138,94,.42)"><span class="font-display" style="font-size:34px;line-height:1;color:rgba(150,86,44,.55)">02</span><span><span class="font-display" style="display:block;font-size:24px;line-height:1.45;color:var(--yl-text)">{t("生産性の低下", "Declining productivity")}</span><span style="display:block;margin-top:10px;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("疲労・集中力の低下・欠勤が積み重なり、稼働が安定しない。", "Fatigue, reduced concentration, and absences accumulate, disrupting consistent performance.")}</span></span></li><li class="sc-rise" style="display:grid;grid-template-columns:64px minmax(0,1fr);gap:20px;padding:28px 0;border-top:1px solid rgba(208,138,94,.42)"><span class="font-display" style="font-size:34px;line-height:1;color:rgba(150,86,44,.55)">03</span><span><span class="font-display" style="display:block;font-size:24px;line-height:1.45;color:var(--yl-text)">{t("心身の不調", "Mental and physical strain")}</span><span style="display:block;margin-top:10px;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("肩こり・腰痛・眼精疲労・ストレスが慢性化している。", "Stiff shoulders, lower back pain, eye strain, and stress become chronic.")}</span></span></li><li class="sc-rise" style="display:grid;grid-template-columns:64px minmax(0,1fr);gap:20px;padding:28px 0;border-top:1px solid rgba(208,138,94,.42);border-bottom:1px solid rgba(208,138,94,.42)"><span class="font-display" style="font-size:34px;line-height:1;color:rgba(150,86,44,.55)">04</span><span><span class="font-display" style="display:block;font-size:24px;line-height:1.45;color:var(--yl-text)">{t("運動する時間がない", "No time to exercise")}</span><span style="display:block;margin-top:10px;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("仕事と家事に追われ、社員が体を動かす機会を持てない。", "Work and household responsibilities leave employees little opportunity to move their bodies.")}</span></span></li>
        </ol>
      </div>
    </div>
  </section>

  <section id="cost" class="scroll-mt-24 ja-band ja-band-sand" data-screen-label={t("コスト", "Costs")} style="position:relative;background:var(--color-warm-beige);overflow:hidden" data-lt="1">
    <div aria-hidden="true" style="position:absolute;right:-170px;top:-130px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(239,223,196,.22) 0%,rgba(239,223,196,0) 70%);pointer-events:none"></div>
    <div style="position:relative;max-width:72rem;margin:0 auto">
      <p class="ja-eyebrow">{t("見えないコスト", "Hidden costs")}</p>
      <h2 class="font-display" style="margin:20px 0 0;max-width:16em;font-size:clamp(30px,4vw,46px);line-height:1.3;color:var(--yl-text)">{t("その課題は、静かに利益を削っています", "These challenges quietly eat into your profits")}</h2>
      <div style="display:flex;flex-wrap:wrap;gap:16px 52px;margin:44px 0 0">
        <div style="display:flex;align-items:baseline;gap:12px"><span class="font-mono" style="font-size:13px;letter-spacing:.18em;color:var(--yl-soft)">01</span><span class="font-display" style="font-size:22px;line-height:1.4;color:var(--yl-text)">{t("求人・広告費", "Recruitment and advertising")}</span></div><div style="display:flex;align-items:baseline;gap:12px"><span class="font-mono" style="font-size:13px;letter-spacing:.18em;color:var(--yl-soft)">02</span><span class="font-display" style="font-size:22px;line-height:1.4;color:var(--yl-text)">{t("採用プロセス費", "Hiring process costs")}</span></div><div style="display:flex;align-items:baseline;gap:12px"><span class="font-mono" style="font-size:13px;letter-spacing:.18em;color:var(--yl-soft)">03</span><span class="font-display" style="font-size:22px;line-height:1.4;color:var(--yl-text)">{t("教育・育成費", "Training and development")}</span></div><div style="display:flex;align-items:baseline;gap:12px"><span class="font-mono" style="font-size:13px;letter-spacing:.18em;color:var(--yl-soft)">04</span><span class="font-display" style="font-size:22px;line-height:1.4;color:var(--yl-text)">{t("生産性の損失", "Lost productivity")}</span></div>
      </div>
      <p class="font-display sc-rise" style="margin:52px 0 0;max-width:21em;font-size:clamp(22px,3vw,32px);line-height:1.62;color:var(--yl-text)">{t("同じ予算を「採用のやり直し」ではなく", "Invest the same budget in ")}<em style="font-style:normal;color:var(--yl-soft)">{t("定着", "retention")}</em>{t("に投資すれば、コストは資産に変わります。", " rather than repeated recruitment, and costs become assets.")}</p>
      <div style="display:grid;gap:44px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));margin-top:56px;padding-top:40px;border-top:1px solid rgba(253,247,238,.24)">
        <div>
          <p class="ja-sublabel" style="margin:0">{t("これまで", "Until now")}</p>
          <ul style="list-style:none;margin:20px 0 0;padding:0;display:flex;flex-direction:column;gap:18px">
            <li><span class="font-display" style="display:block;font-size:19px;line-height:1.5;color:var(--yl-text)">{t("再募集の広告費", "Advertising to recruit again")}</span><span style="display:block;margin-top:6px;font-size:15px;line-height:1.85;color:rgba(253,247,238,.75)">{t("人が辞めるたびに発生", "A cost every time someone leaves")}</span></li><li><span class="font-display" style="display:block;font-size:19px;line-height:1.5;color:var(--yl-text)">{t("面接・選考の人件費", "Staff time for interviews and selection")}</span><span style="display:block;margin-top:6px;font-size:15px;line-height:1.85;color:rgba(253,247,238,.75)">{t("繰り返される採用工数", "Repeated hiring work")}</span></li><li><span class="font-display" style="display:block;font-size:19px;line-height:1.5;color:var(--yl-text)">{t("育成のやり直し", "Starting training over")}</span><span style="display:block;margin-top:6px;font-size:15px;line-height:1.85;color:rgba(253,247,238,.75)">{t("戦力化まで時間とコスト", "Time and cost before a new hire is fully effective")}</span></li>
          </ul>
        </div>
        <div>
          <p class="ja-sublabel" style="margin:0">{t("これから", "From here")}</p>
          <ul style="list-style:none;margin:20px 0 0;padding:0;display:flex;flex-direction:column;gap:18px">
            <li><span class="font-display" style="display:block;font-size:19px;line-height:1.5;color:var(--yl-text)">{t("健康経営としてのヨガ", "Yoga as workplace health management")}</span><span style="display:block;margin-top:6px;font-size:15px;line-height:1.85;color:rgba(253,247,238,.75)">{t("社員の健康に直接投資", "Invest directly in employee health")}</span></li><li><span class="font-display" style="display:block;font-size:19px;line-height:1.5;color:var(--yl-text)">{t("定着率の向上", "Better retention")}</span><span style="display:block;margin-top:6px;font-size:15px;line-height:1.85;color:rgba(253,247,238,.75)">{t("離職の連鎖を止める", "Break the cycle of staff turnover")}</span></li><li><span class="font-display" style="display:block;font-size:19px;line-height:1.5;color:var(--yl-text)">{t("生産性と活気の向上", "Greater productivity and vitality")}</span><span style="display:block;margin-top:6px;font-size:15px;line-height:1.85;color:rgba(253,247,238,.75)">{t("元気な職場が利益を生む", "A healthy workplace generates value")}</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="evidence" class="scroll-mt-24" data-screen-label={t("科学的根拠", "Scientific evidence")} style="position:relative;background:var(--color-ivory-cream);overflow:hidden">
    <svg aria-hidden="true" viewBox="0 0 200 200" style="position:absolute;right:5%;top:44px;width:118px;pointer-events:none;opacity:.42">
      <path d="M100 8 L124 76 L192 100 L124 124 L100 192 L76 124 L8 100 L76 76 Z" fill="none" stroke="#b9975b" stroke-opacity=".85" />
    </svg>
    <div style="position:relative;max-width:72rem;margin:0 auto">
      <div style="display:grid;gap:44px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));align-items:end">
        <div>
          <p class="ja-eyebrow">{t("科学的根拠", "Scientific evidence")}</p>
          <h2 class="font-display" style="margin:20px 0 0;font-size:clamp(30px,4vw,46px);line-height:1.3;color:var(--yl-text)">{t("科学が証明する、", "Changes in mind and body")}<br />{t("心と体への変化", "shown by science")}</h2>
        </div>
        <p style="margin:0;font-size:16.5px;line-height:2.05;color:var(--yl-soft)">{t("世界的ヨギ、サドグルが伝授する「インナーエンジニアリング」を対象とした医学研究です。提供するハタヨガは同じ系統にあたります。被験者142名の血液を測定（ハーバード大学の研究者を含むチーム／査読付き医学誌 2020年）。", "Medical research has studied Inner Engineering, taught by the internationally known yogi Sadhguru. The Hatha Yoga offered here belongs to the same tradition. Blood samples were measured in 142 participants by a team including Harvard researchers, with findings published in a peer-reviewed medical journal in 2020.")}</p>
      </div>
      <div style="display:grid;gap:0 40px;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));margin-top:56px;border-top:1px solid rgba(208,138,94,.42)">
        <div class="sc-rise" style="padding:32px 0"><p class="font-display" style="margin:0;font-size:clamp(38px,5vw,54px);line-height:1;color:var(--color-warm-brown)">{t("+70%超", "Over +70%")}</p><p class="font-display" style="margin:14px 0 0;font-size:20px;line-height:1.45;color:var(--yl-text)">{t("全ての主要な体内物質", "All key compounds measured")}</p><p style="margin:10px 0 0;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("幸福感に関わるエンドカンナビノイドとBDNFが、実践直後にいずれも70%以上増加（P<0.001）", "Endocannabinoids and BDNF, associated with wellbeing, each increased by at least 70% immediately after the practice (P<0.001).")}</p></div><div class="sc-rise" style="padding:32px 0"><p class="font-display" style="margin:0;font-size:clamp(38px,5vw,54px);line-height:1;color:var(--color-warm-brown)">71%</p><p class="font-display" style="margin:14px 0 0;font-size:20px;line-height:1.45;color:var(--yl-text)">{t("の人で2-AGが上昇", "saw an increase in 2-AG")}</p><p style="margin:10px 0 0;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("「至福の分子」に関わる2-AGが、被験者の71%で20%以上増加。", "2-AG, associated with the “bliss molecule,” increased by at least 20% in 71% of participants.")}</p></div><div class="sc-rise" style="padding:32px 0"><p class="font-display" style="margin:0;font-size:clamp(38px,5vw,54px);line-height:1;color:var(--color-warm-brown)">53%</p><p class="font-display" style="margin:14px 0 0;font-size:20px;line-height:1.45;color:var(--yl-text)">{t("の人でBDNFが上昇", "saw an increase in BDNF")}</p><p style="margin:10px 0 0;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("脳の健康・神経の成長に関わるBDNFが、被験者の53%で20%以上増加。", "BDNF, associated with brain health and nerve growth, increased by at least 20% in 53% of participants.")}</p></div>
      </div>
      <div style="display:grid;gap:0 40px;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));margin-top:20px;border-top:1px solid rgba(208,138,94,.42);border-bottom:1px solid rgba(208,138,94,.42)">
        <div class="sc-rise" style="padding:28px 0"><p class="font-display" style="margin:0;font-size:34px;line-height:1;color:var(--color-deep-olive)">-54%</p><p class="font-display" style="margin:12px 0 0;font-size:17px;line-height:1.45;color:var(--yl-text)">{t("働く人のストレス", "Stress among working adults")}</p><p style="margin:8px 0 0;font-size:15px;line-height:1.85;color:var(--yl-soft)">{t("8週間の実践で54%減少。", "A 54% decrease after eight weeks of practice.")}</p></div><div class="sc-rise" style="padding:28px 0"><p class="font-display" style="margin:0;font-size:34px;line-height:1;color:var(--color-deep-olive)">-46%</p><p class="font-display" style="margin:12px 0 0;font-size:17px;line-height:1.45;color:var(--yl-text)">{t("うつ症状", "Depressive symptoms")}</p><p style="margin:8px 0 0;font-size:15px;line-height:1.85;color:var(--yl-soft)">{t("6週間で平均46%低下。", "An average 46% decrease in six weeks.")}</p></div><div class="sc-rise" style="padding:28px 0"><p class="font-display" style="margin:0;font-size:34px;line-height:1;color:var(--color-deep-olive)">-36%</p><p class="font-display" style="margin:12px 0 0;font-size:17px;line-height:1.45;color:var(--yl-text)">{t("不安", "Anxiety")}</p><p style="margin:8px 0 0;font-size:15px;line-height:1.85;color:var(--yl-soft)">{t("6週間で36%減少。", "A 36% decrease in six weeks.")}</p></div><div class="sc-rise" style="padding:28px 0"><p class="font-display" style="margin:0;font-size:34px;line-height:1;color:var(--color-deep-olive)">{t("4.8倍", "4.8×")}</p><p class="font-display" style="margin:12px 0 0;font-size:17px;line-height:1.45;color:var(--yl-text)">{t("回復力（自律神経）", "Recovery capacity (autonomic nervous system)")}</p><p style="margin:8px 0 0;font-size:15px;line-height:1.85;color:var(--yl-soft)">{t("副交感神経の反応が対照群の4.8倍。", "Parasympathetic response was 4.8 times that of the control group.")}</p></div>
      </div>
      <p style="margin:24px 0 0;max-width:58em;font-size:15px;line-height:1.9;color:rgba(107,87,68,.85)">{t("※ 出典：Sadhasivam et al., Evidence-Based Complementary and Alternative Medicine（2020）, Frontiers in Public Health / Psychiatry / Psychology（2022）, J Ayurveda Integr Med（2012）ほか。6,892名を対象とした大規模調査では、実践者のストレスが31%低いという結果に。わずか21分の実践で深い睡眠と同じ脳波状態に入ることも報告されています。", "Sources include Sadhasivam et al., Evidence-Based Complementary and Alternative Medicine (2020); Frontiers in Public Health / Psychiatry / Psychology (2022); and J Ayurveda Integr Med (2012). A large survey of 6,892 people found 31% lower stress among practitioners. Reports also describe brainwave patterns equivalent to deep sleep after just 21 minutes of practice.")}</p>
    </div>
  </section>

  <section id="effects" class="scroll-mt-24" data-screen-label={t("効果", "Benefits")} style="position:relative;background:var(--color-warm-beige);overflow:hidden">
    <svg aria-hidden="true" viewBox="0 0 320 320" style="position:absolute;right:-56px;bottom:40px;width:min(28vw,250px);pointer-events:none;opacity:.5;transform:rotate(12deg)">
      <path d="M160 12 C 78 96 74 224 160 308 C 246 224 242 96 160 12 Z" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".38" />
      <path d="M160 52 C 104 118 102 214 160 268 C 218 214 216 118 160 52 Z" fill="none" stroke="#b9975b" stroke-opacity=".34" />
      <path d="M160 12 L160 308" stroke="var(--color-warm-brown)" stroke-opacity=".2" />
    </svg>
    <div style="position:relative;max-width:72rem;margin:0 auto">
      <div style="display:grid;gap:52px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));align-items:center">
        <figure class="sc-rise" style="margin:0">
          <div style="overflow:hidden;border-radius:14px;box-shadow:0 24px 52px -34px color-mix(in srgb, var(--color-text-primary) 42%, transparent)">
            <img src="/hatha-yoga/assets/wellness/circle-room.jpg" alt={t("オフィスの会議室で車座になって瞑想する社員たち", "Employees sitting in a circle to meditate in an office meeting room")} loading="lazy" style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:14px" />
          </div>
        </figure>
        <div>
          <p class="ja-eyebrow">{t("期待できる効果", "Potential benefits")}</p>
          <h2 class="font-display" style="margin:20px 0 0;font-size:clamp(28px,3.8vw,44px);line-height:1.3;color:var(--yl-text)">{t("「本物のハタヨガ」が", "What authentic Hatha Yoga")}<br />{t("もたらすもの", "can bring")}</h2>
          <p style="margin:24px 0 0;font-size:16.5px;line-height:2.05;color:var(--yl-soft)">{t("「ハ」は太陽、「タ」は月。相反する力の統合を意味します。体を柔らかくするための運動ではなく、エネルギーの次元から心身を整える実践です。", "“Ha” means sun and “tha” means moon: the union of opposing forces. This is not simply exercise for flexibility, but a practice that balances mind and body at the level of energy.")}</p>
        </div>
      </div>
      <div style="display:grid;gap:0 44px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));margin-top:64px">
        <div class="sc-rise" style="padding:26px 0;border-top:1px solid rgba(208,138,94,.42)"><h3 class="font-display" style="margin:0;font-size:21px;line-height:1.45;color:var(--yl-text)">{t("疲労の回復力が上がる", "Better recovery from fatigue")}</h3><p style="margin:10px 0 0;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("副交感神経が働き、繰り返し作業の疲れが残りにくく。", "Parasympathetic activity helps reduce lingering fatigue from repetitive work.")}</p></div><div class="sc-rise" style="padding:26px 0;border-top:1px solid rgba(208,138,94,.42)"><h3 class="font-display" style="margin:0;font-size:21px;line-height:1.45;color:var(--yl-text)">{t("集中力と明晰さ", "Concentration and clarity")}</h3><p style="margin:10px 0 0;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("頭が冴え、単調な作業でもミス・注意散漫が減る。", "A clearer mind means fewer errors and distractions, even in repetitive tasks.")}</p></div><div class="sc-rise" style="padding:26px 0;border-top:1px solid rgba(208,138,94,.42)"><h3 class="font-display" style="margin:0;font-size:21px;line-height:1.45;color:var(--yl-text)">{t("ストレスに強くなる", "Greater resilience to stress")}</h3><p style="margin:10px 0 0;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("神経が安定し、イライラ・緊張・不安が和らぐ。", "A steadier nervous system eases irritability, tension, and anxiety.")}</p></div><div class="sc-rise" style="padding:26px 0;border-top:1px solid rgba(208,138,94,.42)"><h3 class="font-display" style="margin:0;font-size:21px;line-height:1.45;color:var(--yl-text)">{t("睡眠と活力の質", "Better sleep and vitality")}</h3><p style="margin:10px 0 0;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("深く眠れ、寝つきも改善。翌日の活力が変わる。", "Sleep more deeply and fall asleep more easily, changing how you feel the next day.")}</p></div><div class="sc-rise" style="padding:26px 0;border-top:1px solid rgba(208,138,94,.42)"><h3 class="font-display" style="margin:0;font-size:21px;line-height:1.45;color:var(--yl-text)">{t("人間関係・協調性", "Relationships and cooperation")}</h3><p style="margin:10px 0 0;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("心の余裕が生まれ、対話とチームワークが円滑に。", "Greater inner ease supports communication and teamwork.")}</p></div><div class="sc-rise" style="padding:26px 0;border-top:1px solid rgba(208,138,94,.42)"><h3 class="font-display" style="margin:0;font-size:21px;line-height:1.45;color:var(--yl-text)">{t("根本からの健康", "Health from the foundations")}</h3><p style="margin:10px 0 0;font-size:15px;line-height:1.9;color:var(--yl-soft)">{t("肩こり・腰痛など、慢性的な不調も解消。", "Address chronic discomfort, including stiff shoulders and lower back pain.")}</p></div>
      </div>
    </div>
  </section>

  <section id="program" class="scroll-mt-24" data-screen-label={t("導入例", "Program examples")} style="position:relative;background:var(--color-ivory-cream);overflow:hidden">
    <svg aria-hidden="true" viewBox="0 0 200 320" style="position:absolute;right:-62px;bottom:60px;width:210px;opacity:.45;transform:rotate(14deg);pointer-events:none"><path d="M100 12 C 40 90 34 210 100 308 C 166 210 160 90 100 12 Z" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".32"/><path d="M100 20 L100 300" stroke="var(--color-warm-brown)" stroke-opacity=".25"/><path d="M100 90 C 70 104 58 132 54 160" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".2"/><path d="M100 90 C 130 104 142 132 146 160" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".2"/><path d="M100 160 C 74 172 64 196 60 220" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".18"/><path d="M100 160 C 126 172 136 196 140 220" fill="none" stroke="var(--color-warm-brown)" stroke-opacity=".18"/></svg>
    <div style="position:relative;max-width:72rem;margin:0 auto">
      <p class="ja-eyebrow">{t("導入例", "Program examples")}</p>
      <h2 class="font-display" style="margin:20px 0 0;font-size:clamp(30px,4vw,46px);line-height:1.3;color:var(--yl-text)">{t("無理のない、続く仕組み", "A practical approach that lasts")}</h2>
      <div style="display:grid;gap:40px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));align-items:center;margin-top:24px">
        <p style="margin:0;max-width:34em;font-size:16.5px;line-height:2.05;color:var(--color-text-primary)">{t("「休憩の前」「就業終了の前」——通常業務と選べる、参加は選択制。会社が\"運動できる環境\"を用意することに意味があります。", "Before a break or before the workday ends, employees can choose between yoga and their usual work. Participation is optional. What matters is that the company creates an environment where movement is possible.")}</p>
        <figure class="sc-rise" style="margin:0;overflow:hidden;border-radius:14px;box-shadow:0 24px 52px -34px color-mix(in srgb, var(--color-text-primary) 42%, transparent)">
          <img src="/hatha-yoga/assets/wellness/workshop-pair.jpg" alt={t("企業内で開催したハタヨガ体験ワークショップ", "An introductory Hatha Yoga workshop held in a workplace")} loading="lazy" style="display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px" />
        </figure>
      </div>
      <div style="margin-top:52px;display:flex;flex-direction:column">
        <article class="sc-rise" style="display:grid;gap:20px 44px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));padding:36px 0;border-top:1px solid rgba(208,138,94,.42)"><div><p class="font-mono" style="margin:0;font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-deep-olive)">{t("Case 01 ・ 週一回コース", "Case 01 · Weekly course")}</p><h3 class="font-display" style="margin:12px 0 0;font-size:clamp(24px,3.2vw,32px);line-height:1.35;color:var(--yl-text)">{t("昼休憩の前 30分", "30 minutes before lunch")}</h3></div><p style="margin:0;font-size:15px;line-height:2;color:var(--yl-soft);align-self:center">{t("休憩直前の30分をヨガ・瞑想の時間に。参加すれば就業時間として給与が発生し、参加せず通常業務を続けることも可能です。「強制しない」からこそ、社員の自発性が育ちます。", "Use the 30 minutes before lunch for yoga and meditation. Participants are paid for this time as part of their working hours, while others may continue their usual work. Making participation voluntary helps employees take initiative.")}</p></article><article class="sc-rise" style="display:grid;gap:20px 44px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));padding:36px 0;border-top:1px solid rgba(208,138,94,.42)"><div><p class="font-mono" style="margin:0;font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-deep-olive)">{t("Case 02 ・ 月二回コース", "Case 02 · Twice-monthly course")}</p><h3 class="font-display" style="margin:12px 0 0;font-size:clamp(24px,3.2vw,32px);line-height:1.35;color:var(--yl-text)">{t("就業中の 60分", "60 minutes during the workday")}</h3></div><p style="margin:0;font-size:15px;line-height:2;color:var(--yl-soft);align-self:center">{t("例えば16:00〜17:00をヨガの時間に。通常勤務なら17:00まで業務、参加すればそのままクラスが業務時間とみなされます。頻度を抑えながら習慣化につなげます。", "For example, set aside 4:00–5:00 p.m. for yoga. Employees may work as usual until 5:00 p.m., or attend the class as part of their working hours. A lower frequency can still help establish a habit.")}</p></article><article class="sc-rise" style="display:grid;gap:20px 44px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));padding:36px 0;border-top:1px solid rgba(208,138,94,.42);border-bottom:1px solid rgba(208,138,94,.42)"><div><p class="font-mono" style="margin:0;font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:var(--color-deep-olive)">{t("Case 03 ・ 就業後コース", "Case 03 · After-work course")}</p><h3 class="font-display" style="margin:12px 0 0;font-size:clamp(24px,3.2vw,32px);line-height:1.35;color:var(--yl-text)">{t("就業後の 60分", "60 minutes after work")}</h3></div><p style="margin:0;font-size:15px;line-height:2;color:var(--yl-soft);align-self:center">{t("例えば18:00〜19:00をヨガの時間に。就業時間外の任意参加型のため給与調整が不要で、導入のハードルが低いのが特長です。退社後のリフレッシュとしても機能します。", "For example, offer yoga from 6:00–7:00 p.m. As participation is voluntary and outside working hours, no payroll adjustment is needed, making the program easy to introduce. It also offers a refreshing way to unwind after work.")}</p></article>
      </div>
      <p style="margin:26px 0 0;font-size:15px;line-height:1.9;color:rgba(107,87,68,.85)">{t("※ 上記は導入例の一部です。業種・勤務形態に応じて、実施時間・頻度は柔軟にご提案いたします。", "These are just a few examples. Session times and frequency can be tailored to your industry and working arrangements.")}</p>
    </div>
  </section>

