        <figure class="sc-rise" style="margin:0">
          <div style="overflow:hidden;border-radius:14px;border:1px solid color-mix(in srgb, var(--color-warm-brown) 50%, transparent);box-shadow:0 24px 50px -32px color-mix(in srgb, var(--color-text-primary) 42%, transparent)">
            <picture><source type="image/webp" srcset="/hatha-yoga/assets/setsuko-about.webp" /><img src="/hatha-yoga/assets/setsuko-about.jpg" alt={t("秦 節子", "Setsuko Hata")} loading="lazy" style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:14px" /></picture>
